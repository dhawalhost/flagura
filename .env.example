# ==============================================================================
# Flagura Environment Configuration
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Supabase PostgreSQL Connection String
# Get this from your Supabase Dashboard: Settings -> Database -> Connection Pooling -> URI
# Format: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# If DATABASE_URL is empty, Flagura automatically runs with an In-Memory Edge Store.
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# App URL for CORS and client SDK connections (optional)
APP_URL=http://localhost:3000
