# ==============================================================================
# Flagura Feature Flag & Experimentation Engine — Environment Configuration
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Application Base URL (used for password reset links and console redirects)
FLAGURA_APP_URL=http://localhost:3000

# Optional: Set to true to show the public product landing page at root "/"
# Default: false (redirects directly to the self-hosted /auth console)
ENABLE_LANDING_PAGE=false

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 14+)
# Supports: Supabase, Local Postgres, AWS RDS, Neon, Cloud SQL, Railway, Render
# If DATABASE_URL is empty, Flagura automatically runs with an In-Memory Edge Store.
# ------------------------------------------------------------------------------

# Option 1: Supabase PostgreSQL (Transaction Pooler - Recommended for Serverless/Vercel)
# DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Local PostgreSQL (via Docker Compose or local installation)
# DATABASE_URL=postgres://postgres:flagurasecret@localhost:5432/flagura?sslmode=disable

# Option 3: Neon / Serverless PostgreSQL
# DATABASE_URL=postgres://[USER]:[PASSWORD]@ep-xyz.[REGION].aws.neon.tech/neondb?sslmode=require

# Option 4: AWS RDS / Aurora PostgreSQL
# DATABASE_URL=postgres://[USER]:[PASSWORD]@flagura-db.xyz.[REGION].rds.amazonaws.com:5432/flagura?sslmode=require

# ------------------------------------------------------------------------------
# Transactional Email & SMTP Configuration
# Used for: Password Resets, Welcome Emails, and 4-Eyes Governance Approvals
# If SMTP_HOST is empty, Flagura uses ConsoleMailer (logs emails to terminal).
# Compatible with: SendGrid, AWS SES, Resend, Postmark, Mailgun, Brevo, or Local SMTP
# ------------------------------------------------------------------------------

# SMTP Server Host (e.g. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com, smtp.resend.com)
SMTP_HOST=

# SMTP Server Port (587 for STARTTLS, 465 for SMTPS TLS dialer, 25)
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USERNAME=
SMTP_PASSWORD=

# Outgoing Sender Email Address (e.g. notifications@yourcompany.com or no-reply@yourcompany.com)
# Default for self-hosted if unset: no-reply@localhost
SMTP_FROM=no-reply@yourcompany.com

# ------------------------------------------------------------------------------
# Branding, Support & Governance Customization (Self-Hosted)
# ------------------------------------------------------------------------------

# Brand Title displayed across email headers, page titles, and notifications
FLAGURA_BRAND_NAME=Flagura

# Internal Helpdesk / Support Email rendered in email footers and console alerts
# If empty, footers safely display "Contact your workspace administrator"
FLAGURA_SUPPORT_EMAIL=devops@yourcompany.com

# Governance Approvers: Comma-separated list of reviewer emails for 4-eyes change approvals
# If left empty, Flagura dynamically resolves all registered Admin users from the database.
FLAGURA_GOVERNANCE_EMAILS=
