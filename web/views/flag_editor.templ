package views

templ FlagEditorModal() {
	<div class="space-y-5" x-show="activeView === 'editor'" x-cloak x-data="flagEditorComponent()">
		<!-- Top Header Card -->
		<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-3">
			<div class="flex items-center gap-3.5">
				<button
					@click="closeEditor()"
					class="p-2 text-neutral-500 hover:text-neutral-900 transition-colors rounded-md bg-neutral-50 hover:bg-neutral-100 border border-neutral-200 flex items-center gap-1.5 text-xs font-semibold cursor-pointer"
					title="Return to previous view"
				>
					<i data-lucide="arrow-left" class="h-4 w-4"></i>
					<span class="hidden sm:inline">Back</span>
				</button>
				<div>
					<div class="flex items-center gap-2">
						<h2
							class="text-base font-semibold text-neutral-900"
							x-text="isEditing ? ('Edit Flag: ' + form.key) : 'Create New Feature Flag'"
						></h2>
						<span
							class="rounded-md bg-accent-50 border border-accent-200 px-2.5 py-0.5 text-2xs text-accent-700 font-medium"
							x-text="form.type"
						></span>
					</div>
					<p class="text-xs text-neutral-500 mt-0.5 font-sans">
						Set rules, rollout strategy and targeting per environment.
					</p>
				</div>
			</div>

			<div class="flex items-center gap-2.5 self-end sm:self-auto font-mono">
				<template x-if="isEditing">
					<button
						type="button"
						@click="promoteEnvironment('staging', 'production')"
						class="px-3.5 py-2 rounded-md bg-warn-50 hover:bg-warn-100 border border-warn-200 text-warn-700 font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
						title="Copy all staging rules & rollout percentage directly to production"
					>
						<i data-lucide="git-merge" class="h-3.5 w-3.5 text-warn-600"></i>
						<span>Promote Staging → Prod</span>
					</button>
				</template>
				<button
					type="button"
					@click="closeEditor()"
					class="px-4 py-2 rounded-md bg-neutral-50 hover:bg-neutral-100 border border-neutral-200 text-xs font-semibold text-neutral-700 cursor-pointer transition-colors"
				>
					Cancel
				</button>
				<button
					type="button"
					@click="saveFlag()"
					class="px-4 py-2 rounded-md bg-accent-600 hover:bg-accent-700 text-surface font-medium text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
					:disabled="saving"
				>
					<i data-lucide="save" class="h-4 w-4 text-surface"></i>
					<span x-text="saving ? 'Saving...' : (isEditing ? 'Save Changes' : 'Create Flag')"></span>
				</button>
			</div>
		</div>

		<!-- Main Form Container -->
		<form
			@submit.prevent="saveFlag()"
			class="panel p-4 space-y-5"
		>
			<!-- General Metadata Section -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
				<!-- Key -->
				<div>
					<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">
						Flag Key <span class="text-danger-500">*</span>
					</label>
					<input
						type="text"
						required
						:disabled="isEditing"
						placeholder="e.g. ai-smart-search"
						x-model="form.key"
						class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors font-mono disabled:opacity-50"
					/>
				</div>

				<!-- Display Name -->
				<div>
					<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">
						Display Name <span class="text-danger-500">*</span>
					</label>
					<input
						type="text"
						required
						placeholder="e.g. AI Smart Search & Query Rewrite"
						x-model="form.name"
						class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors"
					/>
				</div>

				<!-- Type -->
				<div>
					<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">Flag Type</label>
					<select
						x-model="form.type"
						class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors font-mono"
					>
						<option value="boolean">Boolean (True / False)</option>
						<option value="multivariate">Multivariate (A/B/n Variants)</option>
						<option value="json">Dynamic JSON Configuration</option>
					</select>
				</div>
			</div>

			<!-- Description & Tags -->
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<div>
					<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">Description</label>
					<input
						type="text"
						placeholder="Brief description of feature and rollout plan"
						x-model="form.description"
						class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors font-sans"
					/>
				</div>

				<div>
					<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">
						Tags <span class="text-neutral-400 font-normal">(comma-separated)</span>
					</label>
					<input
						type="text"
						placeholder="frontend, checkout, experimental"
						x-model="form.tagsInput"
						class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors font-mono"
					/>
				</div>
			</div>

			<!-- Environment Tabs & Specific Configuration -->
			<div class="rounded-md border border-neutral-200 bg-neutral-50/50 p-4 space-y-6">
				<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-neutral-200 pb-4">
					<div class="flex items-center gap-3">
						<span class="text-xs font-medium text-neutral-600">Configure Scope:</span>
						<div class="flex items-center max-w-full overflow-x-auto rounded-md border border-neutral-200 bg-surface p-1 font-mono">
							<button
								type="button"
								@click="envTab = 'production'"
								class="px-4 py-1.5 text-xs capitalize rounded transition-colors cursor-pointer font-medium"
								:class="envTab === 'production' ? 'bg-accent-600 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								production
							</button>
							<button
								type="button"
								@click="envTab = 'staging'"
								class="px-4 py-1.5 text-xs capitalize rounded transition-colors cursor-pointer font-medium"
								:class="envTab === 'staging' ? 'bg-accent-600 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								staging
							</button>
							<button
								type="button"
								@click="envTab = 'development'"
								class="px-4 py-1.5 text-xs capitalize rounded transition-colors cursor-pointer font-medium"
								:class="envTab === 'development' ? 'bg-accent-600 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								development
							</button>
						</div>
					</div>

					<button
						type="button"
						@click="syncEnvConfigToAll()"
						class="flex items-center gap-1.5 text-xs text-accent-600 hover:underline font-medium cursor-pointer"
						title="Mirror current tab settings to other environments"
					>
						<i data-lucide="copy" class="h-3.5 w-3.5"></i>
						<span>Sync to all environments</span>
					</button>
				</div>

				<!-- Kill Switch & Strategy -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div class="rounded-md border border-neutral-200 bg-surface p-5 flex items-center justify-between">
						<div>
							<div class="text-sm font-medium text-neutral-900">Master Kill Switch</div>
							<div class="text-xs text-neutral-500 mt-0.5">Circuit breaker for <span class="font-medium text-accent-600" x-text="envTab"></span></div>
						</div>
						<button
							type="button"
							@click="form.environments[envTab].enabled = !form.environments[envTab].enabled"
							class="px-3.5 py-2 text-xs font-medium rounded-md transition-colors cursor-pointer"
							:class="form.environments[envTab].enabled ? 'bg-ok-50 border border-ok-300 text-ok-700 hover:bg-ok-100' : 'bg-danger-50 border border-danger-300 text-danger-700 hover:bg-danger-100'"
							x-text="form.environments[envTab].enabled ? 'ACTIVE (ON)' : 'DISABLED (OFF)'"
						></button>
					</div>

					<div class="rounded-md border border-neutral-200 bg-surface p-5">
						<label class="text-xs font-semibold text-neutral-700 mb-1.5 block">Serving Strategy</label>
						<select
							x-model="form.environments[envTab].strategy"
							class="w-full bg-neutral-50 border border-neutral-200 rounded-md px-3.5 py-2 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors font-mono"
						>
							<option value="boolean">Boolean (100% On for all users)</option>
							<option value="percentage">Sticky Percentage Rollout (FNV-1a Hash)</option>
							<option value="rules">Targeting Rules & User Whitelist</option>
							<option value="multivariate">Multivariate Experimentation</option>
						</select>
					</div>
				</div>

				<!-- Strategy: Percentage Rollout -->
				<template x-if="form.environments[envTab].strategy === 'percentage' || form.environments[envTab].strategy === 'rules'">
					<div class="rounded-md border border-neutral-200 bg-surface p-4 space-y-3.5 font-mono">
						<div class="flex items-center justify-between">
							<div class="flex items-center gap-2">
								<i data-lucide="percent" class="h-4 w-4 text-accent-600"></i>
								<span class="text-sm font-semibold text-neutral-900">
									Sticky Percentage Rollout
								</span>
							</div>
							<span class="font-mono text-sm font-medium text-accent-700 bg-accent-50 px-2.5 py-0.5 rounded border border-accent-200" x-text="form.environments[envTab].percentage + '% Traffic'"></span>
						</div>
						<input
							type="range"
							min="0"
							max="100"
							step="5"
							x-model="form.environments[envTab].percentage"
							class="w-full accent-accent-600 cursor-pointer bg-neutral-200"
						/>
						<div class="flex justify-between text-xs text-neutral-500 font-mono">
							<span>0% (All off)</span>
							<span>25% Canary</span>
							<span>50% Split</span>
							<span>75% Majority</span>
							<span>100% (Global)</span>
						</div>
						<p class="text-xs text-neutral-500 font-sans">
							Deterministic FNV-1a sticky hashing ensures that users enabled at <span class="font-mono text-accent-600 font-medium" x-text="form.environments[envTab].percentage + '%'"></span> remain enabled when the percentage expands.
						</p>
					</div>
				</template>

				<!-- Targeting Rules Matrix -->
				<div class="space-y-3.5 pt-2">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<i data-lucide="users" class="h-4 w-4 text-accent-600"></i>
							<div class="text-xs font-medium text-neutral-600" x-text="'Targeting Rules (' + (form.environments[envTab].rules ? form.environments[envTab].rules.length : 0) + ')'"></div>
						</div>
						<button
							type="button"
							@click="addRule()"
							class="text-xs text-accent-600 hover:underline font-medium flex items-center gap-1 cursor-pointer"
						>
							<i data-lucide="plus" class="h-3.5 w-3.5"></i>
							<span>Add Condition Rule</span>
						</button>
					</div>

					<div class="space-y-2.5 font-mono">
						<template x-for="(rule, idx) in form.environments[envTab].rules" :key="rule.id || idx">
							<div class="p-3.5 bg-surface rounded-md border border-neutral-200 grid grid-cols-1 sm:grid-cols-4 gap-2.5 items-center">
								<input 
									type="text" 
									x-model="rule.name" 
									placeholder="Rule Name"
									class="bg-neutral-50 border border-neutral-200 rounded px-3 py-2 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors"
								/>
								<select 
									x-model="rule.attribute" 
									class="bg-neutral-50 border border-neutral-200 rounded px-3 py-2 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors"
								>
									<option value="email">Email</option>
									<option value="user_id">User ID</option>
									<option value="country">Country</option>
									<option value="role">Role</option>
									<option value="tier">Tier</option>
									<option value="custom">Custom</option>
								</select>
								<select 
									x-model="rule.operator" 
									class="bg-neutral-50 border border-neutral-200 rounded px-3 py-2 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors"
								>
									<option value="equals">equals</option>
									<option value="not_equals">not_equals</option>
									<option value="contains">contains</option>
									<option value="not_contains">not_contains</option>
									<option value="starts_with">starts_with</option>
									<option value="ends_with">ends_with</option>
									<option value="in_list">in_list</option>
									<option value="not_in_list">not_in_list</option>
									<option value="greater_than">greater_than</option>
									<option value="greater_than_or_equal">greater_than_or_equal (&gt;=)</option>
									<option value="less_than">less_than</option>
									<option value="less_than_or_equal">less_than_or_equal (&lt;=)</option>
									<option value="regex">regex</option>
								</select>
								<div class="flex gap-1.5">
									<input 
										type="text" 
										x-model="rule.valuesInput" 
										placeholder="@flagura.dev"
										class="bg-neutral-50 border border-neutral-200 rounded px-3 py-2 text-xs text-neutral-900 focus:outline-none focus:border-accent-500 transition-colors flex-1"
									/>
									<button 
										type="button"
										@click="removeRule(idx)" 
										class="p-2 text-danger-600 hover:text-danger-700 cursor-pointer"
									>
										<i data-lucide="trash-2" class="w-4 h-4"></i>
									</button>
								</div>
							</div>
						</template>
					</div>
				</div>
			</div>
		</form>
	</div>
}
