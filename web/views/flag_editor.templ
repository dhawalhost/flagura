package views

templ editorEnvTab(env string) {
	<button
		type="button"
		@click={ "envTab = '" + env + "'" }
		:class={ "envTab === '" + env + "' ? 'seg-on' : ''" }
	>{ env }</button>
}

templ FlagEditorModal() {
	<div class="space-y-4" x-show="activeView === 'editor'" x-cloak x-data="flagEditorComponent()">
		<div class="page-head flex flex-wrap items-center justify-between gap-3">
			<h2 class="text-base text-neutral-900 min-w-0 truncate" x-text="isEditing ? form.key : 'New flag'"></h2>
			<div class="flex flex-wrap items-center gap-2">
				<template x-if="isEditing">
					<button
						type="button"
						@click="promoteEnvironment('staging', 'production')"
						class="btn"
						title="Copy all staging rules and rollout percentage to production"
					>Promote staging to production</button>
				</template>
				<button type="button" @click="closeEditor()" class="btn">Cancel</button>
				<button type="button" @click="saveFlag()" class="btn btn-primary" :disabled="saving">
					<span x-text="saving ? 'Saving' : (isEditing ? 'Save changes' : 'Create flag')"></span>
				</button>
			</div>
		</div>

		<form @submit.prevent="saveFlag()" class="panel">
			<div class="section p-4 grid grid-cols-1 sm:grid-cols-6 gap-3">
				<div class="sm:col-span-2">
					<label class="field-label">Key <span class="text-danger-600">*</span></label>
					<input type="text" required :disabled="isEditing" placeholder="checkout-v2" x-model="form.key" class="field font-mono disabled:opacity-50"/>
				</div>
				<div class="sm:col-span-2">
					<label class="field-label">Name <span class="text-danger-600">*</span></label>
					<input type="text" required placeholder="Checkout v2" x-model="form.name" class="field"/>
				</div>
				<div class="sm:col-span-2">
					<label class="field-label">Type</label>
					<select x-model="form.type" class="field">
						<option value="boolean">Boolean</option>
						<option value="multivariate">Multivariate</option>
						<option value="json">JSON</option>
					</select>
				</div>
				<div class="sm:col-span-4">
					<label class="field-label">Description</label>
					<input type="text" placeholder="What this flag controls" x-model="form.description" class="field"/>
				</div>
				<div class="sm:col-span-2">
					<label class="field-label">Tags, comma-separated</label>
					<input type="text" placeholder="frontend, checkout" x-model="form.tagsInput" class="field font-mono"/>
				</div>
			</div>

			<div class="section p-4 flex flex-wrap items-center justify-between gap-3">
				<div class="seg">
					@editorEnvTab("production")
					@editorEnvTab("staging")
					@editorEnvTab("development")
				</div>
				<button
					type="button"
					@click="syncEnvConfigToAll()"
					class="text-xs text-accent-600 hover:underline cursor-pointer"
					title="Mirror current tab settings to other environments"
				>Copy to all environments</button>
			</div>

			<div class="section p-4 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:items-center">
				<div class="flex items-center justify-between gap-3">
					<div>
						<div class="text-sm text-neutral-900">Enabled</div>
						<div class="text-xs text-neutral-500">Kill switch for <span class="font-mono" x-text="envTab"></span></div>
					</div>
					<button
						type="button"
						role="switch"
						:aria-checked="form.environments[envTab].enabled ? 'true' : 'false'"
						aria-label="Enabled"
						@click="form.environments[envTab].enabled = !form.environments[envTab].enabled"
						class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-150"
						:class="form.environments[envTab].enabled ? 'bg-ok-600' : 'bg-neutral-300'"
					>
						<span
							class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-surface transition duration-150"
							:class="form.environments[envTab].enabled ? 'translate-x-4' : 'translate-x-0'"
						></span>
					</button>
				</div>
				<div>
					<label class="field-label">Strategy</label>
					<select x-model="form.environments[envTab].strategy" class="field">
						<option value="boolean">On for everyone</option>
						<option value="percentage">Percentage rollout</option>
						<option value="rules">Targeting rules</option>
						<option value="multivariate">Multivariate</option>
					</select>
				</div>
			</div>

			<template x-if="form.environments[envTab].strategy === 'percentage' || form.environments[envTab].strategy === 'rules'">
				<div class="section p-4">
					<div class="flex items-center justify-between">
						<label class="field-label">Rollout</label>
						<span class="font-mono text-sm text-neutral-900" x-text="form.environments[envTab].percentage + '%'"></span>
					</div>
					<input type="range" min="0" max="100" step="5" x-model="form.environments[envTab].percentage" class="w-full cursor-pointer"/>
					<div class="flex justify-between text-2xs text-neutral-400">
						<span>0</span><span>25</span><span>50</span><span>75</span><span>100</span>
					</div>
					<p class="mt-2 text-xs text-neutral-500">Assignment is sticky: users already in the rollout stay in when the percentage grows.</p>
				</div>
			</template>

			<div class="section p-4 space-y-2">
				<div class="flex items-center justify-between">
					<h3 class="text-sm text-neutral-900" x-text="'Targeting rules (' + (form.environments[envTab].rules ? form.environments[envTab].rules.length : 0) + ')'"></h3>
					<button type="button" @click="addRule()" class="text-xs text-accent-600 hover:underline cursor-pointer">Add rule</button>
				</div>
				<template x-for="(rule, idx) in form.environments[envTab].rules" :key="rule.id || idx">
					<div class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-center">
						<input type="text" x-model="rule.name" placeholder="Rule name" class="field"/>
						<select x-model="rule.attribute" class="field">
							<option value="email">Email</option>
							<option value="user_id">User ID</option>
							<option value="country">Country</option>
							<option value="role">Role</option>
							<option value="tier">Tier</option>
							<option value="custom">Custom</option>
						</select>
						<select x-model="rule.operator" class="field font-mono">
							<option value="equals">equals</option>
									<option value="not_equals">not_equals</option>
									<option value="contains">contains</option>
									<option value="not_contains">not_contains</option>
									<option value="starts_with">starts_with</option>
									<option value="ends_with">ends_with</option>
									<option value="in_list">in_list</option>
									<option value="not_in_list">not_in_list</option>
									<option value="greater_than">greater_than</option>
									<option value="greater_than_or_equal">greater_than_or_equal (&gt;=)</option>
									<option value="less_than">less_than</option>
									<option value="less_than_or_equal">less_than_or_equal (&lt;=)</option>
									<option value="regex">regex</option>
						</select>
						<div class="flex gap-1.5">
							<input type="text" x-model="rule.valuesInput" placeholder="@example.com" class="field font-mono flex-1"/>
							<button type="button" @click="removeRule(idx)" class="p-1.5 text-neutral-400 hover:text-danger-600 cursor-pointer" aria-label="Remove rule">
								<i data-lucide="trash-2" class="w-4 h-4"></i>
							</button>
						</div>
					</div>
				</template>
			</div>
		</form>
	</div>
}
