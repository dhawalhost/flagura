package views

import (
	"github.com/dhawalhost/flagura/internal/domain"
	"fmt"
)

templ LiveEvaluator(flags []domain.FeatureFlag) {
	<div class="space-y-8" x-show="activeView === 'evaluator'" x-data="liveEvaluatorComponent()">
		<!-- Top Header Card -->
		<div class="console-card p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div class="flex items-center gap-3.5">
				<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 border border-blue-200 text-blue-600">
					<i data-lucide="zap" class="h-5 w-5 fill-blue-600"></i>
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h2 class="text-lg font-bold text-slate-900 font-display">Live Evaluation Sandbox</h2>
						<span class="rounded-md bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-[10px] font-mono text-blue-700 font-bold uppercase">
							Deterministic
						</span>
					</div>
					<p class="text-xs text-slate-600 mt-1">
						Test user persona targeting, sticky percentage bucketing (FNV-1a hash), and variant payload resolution in real-time.
					</p>
				</div>
			</div>

			<div class="flex items-center gap-2 self-end sm:self-auto">
				<button
					@click="evaluateNow()"
					class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs transition-all shadow-sm flex items-center gap-2 cursor-pointer"
				>
					<i data-lucide="refresh-cw" class="h-3.5 w-3.5" :class="evaluating ? 'animate-spin' : ''"></i>
					<span>Re-evaluate</span>
				</button>
			</div>
		</div>

		<!-- Main Two-Column Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
			<!-- Left Column: Context & Personas (5 cols) -->
			<div class="lg:col-span-5 console-card p-6 sm:p-7 space-y-6">
				<!-- Quick Presets -->
				<div class="space-y-3">
					<div class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Quick Test Personas</div>
					<div class="flex flex-wrap gap-2 font-mono text-xs">
						<button
							type="button"
							@click="applyPreset('usr_dhawal_01', 'dhawal@flagura.dev', 'US', 'admin', 'enterprise')"
							class="rounded-xl border px-3 py-2 text-xs transition-all shadow-2xs cursor-pointer"
							:class="context.user_id === 'usr_dhawal_01' ? 'bg-slate-900 text-white border-slate-900 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-blue-500 hover:text-blue-600'"
						>
							Dhawal (Staff Whitelist)
						</button>
						<button
							type="button"
							@click="applyPreset('usr_vip_enterprise_88', 'cto@acme-corp.com', 'US', 'user', 'enterprise')"
							class="rounded-xl border px-3 py-2 text-xs transition-all shadow-2xs cursor-pointer"
							:class="context.user_id === 'usr_vip_enterprise_88' ? 'bg-slate-900 text-white border-slate-900 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-blue-500 hover:text-blue-600'"
						>
							Enterprise VIP Client
						</button>
						<button
							type="button"
							@click="applyPreset('usr_qa_lead_44', 'qa.lead@company.com', 'CA', 'qa_engineer', 'pro')"
							class="rounded-xl border px-3 py-2 text-xs transition-all shadow-2xs cursor-pointer"
							:class="context.user_id === 'usr_qa_lead_44' ? 'bg-slate-900 text-white border-slate-900 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-blue-500 hover:text-blue-600'"
						>
							QA & Finance Tester
						</button>
						<button
							type="button"
							@click="applyPreset('usr_uk_beta_09', 'emma@london-tech.co.uk', 'GB', 'beta_tester', 'free')"
							class="rounded-xl border px-3 py-2 text-xs transition-all shadow-2xs cursor-pointer"
							:class="context.user_id === 'usr_uk_beta_09' ? 'bg-slate-900 text-white border-slate-900 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-blue-500 hover:text-blue-600'"
						>
							Beta Tester (UK/Europe)
						</button>
						<button
							type="button"
							@click="applyPreset('usr_anon_3948', 'standard.user@gmail.com', 'DE', 'user', 'free')"
							class="rounded-xl border px-3 py-2 text-xs transition-all shadow-2xs cursor-pointer"
							:class="context.user_id === 'usr_anon_3948' ? 'bg-slate-900 text-white border-slate-900 font-semibold' : 'bg-slate-50 text-slate-700 border-slate-200 hover:border-blue-500 hover:text-blue-600'"
						>
							Standard Free User
						</button>
					</div>
				</div>

				<!-- Target Flag & Environment -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
					<div>
						<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Target Flag Scope</label>
						<select
							x-model="selectedFlagKey"
							@change="evaluateNow()"
							class="input-clean w-full font-mono text-xs"
						>
							<option value="all">⚡ All Flags ({ fmt.Sprintf("%d", len(flags)) })</option>
							for _, f := range flags {
								<option value={ f.Key }>{ f.Key } ({ f.Type })</option>
							}
						</select>
					</div>

					<div>
						<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Environment</label>
						<select
							x-model="currentEnv"
							@change="evaluateNow()"
							class="input-clean w-full font-mono uppercase text-xs"
						>
							<option value="production">Production</option>
							<option value="staging">Staging</option>
							<option value="development">Development</option>
						</select>
					</div>
				</div>

				<!-- Standard Attributes -->
				<div class="space-y-4 pt-4 border-t border-slate-100">
					<div class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">User Identity & Attributes</div>

					<div>
						<div class="flex items-center justify-between text-xs mb-1.5 font-mono">
							<span class="text-slate-600">User ID (Hash Salt):</span>
							<span class="text-blue-700 font-bold bg-blue-50 px-2 py-0.5 rounded border border-blue-200" x-text="'Bucket #' + currentBucket + '%'"></span>
						</div>
						<input
							type="text"
							x-model="context.user_id"
							@input.debounce.250ms="evaluateNow()"
							class="input-clean w-full font-mono text-xs"
							placeholder="usr_12345"
						/>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Email</label>
							<input
								type="text"
								x-model="context.email"
								@input.debounce.250ms="evaluateNow()"
								class="input-clean w-full text-xs font-mono"
							/>
						</div>
						<div>
							<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Country</label>
							<input
								type="text"
								x-model="context.country"
								@input.debounce.250ms="evaluateNow()"
								class="input-clean w-full text-xs font-mono uppercase"
							/>
						</div>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
						<div>
							<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Role</label>
							<input
								type="text"
								x-model="context.role"
								@input.debounce.250ms="evaluateNow()"
								class="input-clean w-full text-xs font-mono"
							/>
						</div>
						<div>
							<label class="text-xs font-semibold text-slate-700 mb-1.5 block">Plan Tier</label>
							<select
								x-model="context.tier"
								@change="evaluateNow()"
								class="input-clean w-full text-xs font-mono"
							>
								<option value="enterprise">enterprise</option>
								<option value="pro">pro</option>
								<option value="free">free</option>
								<option value="internal">internal</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Custom Context JSON -->
				<div class="space-y-2 pt-4 border-t border-slate-100">
					<div class="flex items-center justify-between">
						<span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Custom JSON Attributes</span>
						<span class="text-[10px] text-slate-400 font-mono">Arbitrary key-values</span>
					</div>
					<textarea
						rows="3"
						x-model="customJson"
						@input.debounce.300ms="evaluateNow()"
						class="input-clean w-full text-xs font-mono"
					></textarea>
				</div>
			</div>

			<!-- Right Column: Instant Deterministic Results & cURL (7 cols) -->
			<div class="lg:col-span-7 space-y-8">
				<!-- Results Container -->
				<div class="console-card p-6 sm:p-7 space-y-5">
					<!-- Status bar -->
					<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
						<div class="flex items-center gap-2">
							<span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Engine Telemetry:</span>
							<span class="font-mono text-xs font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
								&lt; 0.05 ms (~80ns native)
							</span>
						</div>
						<div class="text-xs text-slate-500 font-mono">
							Evaluated: <span class="font-bold text-slate-900" x-text="Object.keys(evalResults).length"></span> flag(s)
						</div>
					</div>

					<!-- Flag Evaluation Results Cards -->
					<div class="space-y-3.5 max-h-[500px] overflow-y-auto pr-1">
						<template x-for="(res, key) in evalResults" :key="key">
							<div
								class="console-card-subtle p-5 transition-all"
								:class="res.enabled ? 'border-blue-300 bg-blue-50/20' : 'border-slate-200 bg-slate-50/80'"
							>
								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
									<div>
										<span class="font-mono text-sm font-bold text-slate-900" x-text="key"></span>
									</div>

									<div class="flex items-center gap-2 self-end sm:self-auto">
										<span
											class="inline-flex items-center gap-1.5 rounded-xl px-3 py-1 text-xs font-mono font-bold uppercase shadow-2xs"
											:class="res.enabled ? 'bg-emerald-50 border border-emerald-200 text-emerald-700' : 'bg-rose-50 border border-rose-200 text-rose-700'"
										>
											<i data-lucide="check-circle-2" class="h-3.5 w-3.5 text-emerald-600" x-show="res.enabled"></i>
											<i data-lucide="x-circle" class="h-3.5 w-3.5 text-rose-600" x-show="!res.enabled"></i>
											<span x-text="res.enabled ? 'ON (Served)' : 'OFF (Blocked)'"></span>
										</span>
									</div>
								</div>

								<!-- Evaluation Logic Breakdown -->
								<div class="mt-3.5 pt-3 border-t border-slate-200/80 space-y-2.5 text-xs">
									<div class="flex items-center justify-between text-slate-600">
										<span>Reason / Strategy:</span>
										<span class="font-mono font-semibold text-slate-900" x-text="res.reason"></span>
									</div>

									<!-- Sticky Hash Bucket Progress Bar -->
									<template x-if="res.bucket_val !== undefined">
										<div class="space-y-1.5 bg-white p-3 rounded-xl border border-slate-200">
											<div class="flex justify-between text-xs font-mono">
												<span class="text-slate-500">User FNV-1a Sticky Bucket:</span>
												<span class="font-bold text-slate-900" x-text="'Bucket #' + res.bucket_val + '%'"></span>
											</div>
											<div class="relative h-2 w-full rounded-full bg-slate-100 overflow-hidden">
												<div
													class="absolute top-0 bottom-0 left-0 bg-blue-600 rounded-full"
													style="width: 50%"
												></div>
												<div
													class="absolute top-0 bottom-0 w-2 bg-rose-500 shadow-sm"
													:style="'left: ' + Math.min(res.bucket_val, 98) + '%'"
												></div>
											</div>
										</div>
									</template>

									<!-- Variant & Payload Value -->
									<div class="flex items-start justify-between pt-1 border-t border-slate-200/60 text-xs">
										<span class="text-slate-500 font-mono">Resolved Variant:</span>
										<div class="text-right">
											<span class="font-mono font-semibold text-blue-700" x-text="res.variant || 'default'"></span>
										</div>
									</div>
								</div>
							</div>
						</template>
					</div>
				</div>

				<!-- Generated cURL Section -->
				<div class="console-card p-6 sm:p-7 space-y-3.5">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2 text-xs font-semibold text-slate-900">
							<i data-lucide="terminal" class="h-4 w-4 text-blue-600"></i>
							<span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Direct API cURL Request</span>
						</div>
						<button
							type="button"
							@click="copyCurl()"
							class="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs font-mono font-semibold transition cursor-pointer shadow-2xs flex items-center gap-1.5"
						>
							<i data-lucide="copy" class="h-3.5 w-3.5"></i>
							<span x-text="copiedCurl ? 'Copied!' : 'Copy cURL'"></span>
						</button>
					</div>
					<pre class="overflow-x-auto rounded-xl bg-slate-900 text-slate-100 p-4 text-xs font-mono shadow-sm leading-relaxed" x-text="getCurlCommand()"></pre>
				</div>
			</div>
		</div>
	</div>
}
