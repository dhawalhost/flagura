package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
)

templ ProjectModal(orgs []domain.Organization, projects []domain.Project, activeProjectID string) {
	<!-- Workspace & Project Management Modal Dialog -->
	<div 
		x-data="projectModalComponent()"
		@open-create-project-modal.window="handleOpenProjectModal"
		@open-invite-modal.window="handleOpenInviteModal"
		@keydown.escape.window="close"
		x-show="open"
		role="dialog"
		aria-modal="true"
		aria-label="Workspaces and projects"
		x-cloak
		class="fixed inset-0 z-50 overflow-y-auto"
		style="display: none;"
	>
		<!-- Backdrop -->
		<div 
			x-show="open"
			x-transition:enter="ease-out duration-200"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-150"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			@click="close"
			class="fixed inset-0 bg-scrim/40 transition-opacity"
		></div>

		<div class="flex min-h-full items-center justify-center p-4">
			<div 
				x-show="open"
				x-transition:enter="ease-out duration-200"
				x-transition:enter-start="opacity-0 scale-95"
				x-transition:enter-end="opacity-100 scale-100"
				x-transition:leave="ease-in duration-150"
				x-transition:leave-start="opacity-100 scale-100"
				x-transition:leave-end="opacity-0 scale-95"
				@click.outside="close"
				class="relative w-full max-w-lg bg-surface rounded-xl shadow-pop border border-neutral-200 overflow-hidden"
			>
				<!-- Modal Header -->
				<div class="px-6 py-4 border-b border-neutral-100 flex items-center justify-between bg-surface">
					<div class="flex items-center gap-2">
						<div>
							<h3 class="text-sm font-semibold text-neutral-900">Workspaces and projects</h3>
						</div>
					</div>
					<button 
						@click="close" 
						class="p-1.5 rounded-md text-neutral-400 hover:text-neutral-700 hover:bg-neutral-100 transition cursor-pointer"
					>
						<i data-lucide="x" class="w-4 h-4"></i>
					</button>
				</div>

				<!-- Navigation Tabs -->
				<div class="seg">
					<button 
						type="button" 
						@click="setModalTab('project')" :class="tab === 'project' ? 'seg-on' : ''">
						New Project
					</button>
					<button 
						type="button" 
						@click="setModalTab('org')" :class="tab === 'org' ? 'seg-on' : ''">
						New Workspace
					</button>
					<button 
						type="button" 
						@click="setModalTab('invite')" :class="tab === 'invite' ? 'seg-on' : ''">
						Invite Member
					</button>
				</div>

				<!-- Error / Success banners -->
				<div class="px-6 pt-4 space-y-2">
					<div x-show="errorMessage" class="p-3 rounded-md bg-danger-50 border border-danger-200 text-danger-700 text-xs" x-text="errorMessage"></div>
					<div x-show="successMessage" class="p-3 rounded-md bg-ok-50 border border-ok-200 text-ok-800 text-xs" x-text="successMessage"></div>
				</div>

				<!-- TAB 1: CREATE PROJECT -->
				<form x-show="tab === 'project'" @submit.prevent="createProject()" class="p-4 space-y-4">
					<!-- Organization Select -->
					<div>
						<label for="fld-project-modal-1" class="block text-xs font-semibold text-neutral-700 mb-2">Workspace</label>
						<select id="fld-project-modal-1" 
							name="orgId"
							x-model="orgId"
							class="field"
						>
							for _, org := range orgs {
								<option value={ org.ID }>{ org.Name } ({ org.Slug })</option>
							}
						</select>
					</div>

					<!-- Project Name -->
					<div>
						<label for="fld-project-modal-2" class="block text-xs font-semibold text-neutral-700 mb-2">Project name</label>
						<input id="fld-project-modal-2" 
							type="text" 
							x-model="name" 
							@input="autoSlug()"
							placeholder="e.g. Payments Gateway v2" 
							class="field"
							required
						/>
					</div>

					<!-- Project Slug -->
					<div>
						<label for="fld-project-modal-3" class="block text-xs font-semibold text-neutral-700 mb-2">Project slug</label>
						<input id="fld-project-modal-3" 
							type="text" 
							x-model="slug" 
							placeholder="e.g. payments-gateway-v2" 
							class="field text-accent-700 font-medium"
						/>
					</div>

					<!-- Description -->
					<div>
						<label for="fld-project-modal-4" class="block text-xs font-semibold text-neutral-700 mb-2">Description (Optional)</label>
						<textarea id="fld-project-modal-4" 
							x-model="description" 
							rows="2" 
							placeholder="Scope of flags for this project" 
							class="field"
						></textarea>
					</div>

					<!-- Actions -->
					<div class="pt-3 border-t border-neutral-100 flex items-center justify-end gap-2">
						<button 
							type="button" 
							@click="close" 
							class="btn"
						>
							Cancel
						</button>
						<button 
							type="submit" 
							:disabled="submitting" 
							class="btn btn-primary"
						>
							<i data-lucide="plus" class="w-3.5 h-3.5 text-surface"></i>
							<span x-text="submitting ? 'Creating...' : 'Create Project'"></span>
						</button>
					</div>
				</form>

				<!-- TAB 2: CREATE ORGANIZATION / WORKSPACE -->
				<form x-show="tab === 'org'" @submit.prevent="createOrganization()" class="p-4 space-y-4">
					<div>
						<label for="fld-project-modal-5" class="block text-xs font-semibold text-neutral-700 mb-2">Workspace / Organization Name</label>
						<input id="fld-project-modal-5" 
							type="text" 
							x-model="orgName" 
							@input="autoOrgSlug()"
							placeholder="e.g. Acme Corporation" 
							class="field"
							required
						/>
					</div>

					<div>
						<label for="fld-project-modal-6" class="block text-xs font-semibold text-neutral-700 mb-2">Workspace slug</label>
						<input id="fld-project-modal-6" 
							type="text" 
							x-model="orgSlug" 
							placeholder="e.g. acme-corp" 
							class="field text-accent-700 font-medium"
						/>
					</div>

					<div>
						<label for="fld-project-modal-7" class="block text-xs font-semibold text-neutral-700 mb-2">Description (Optional)</label>
						<textarea id="fld-project-modal-7" 
							x-model="orgDescription" 
							rows="2" 
							placeholder="Engineering division or company scope" 
							class="field"
						></textarea>
					</div>

					<div class="pt-3 border-t border-neutral-100 flex items-center justify-end gap-2">
						<button 
							type="button" 
							@click="close" 
							class="btn"
						>
							Cancel
						</button>
						<button 
							type="submit" 
							:disabled="submitting" 
							class="btn btn-primary"
						>
							<i data-lucide="building" class="w-3.5 h-3.5"></i>
							<span x-text="submitting ? 'Creating...' : 'Create Workspace'"></span>
						</button>
					</div>
				</form>

				<!-- TAB 3: INVITE TEAM MEMBER -->
				<form x-show="tab === 'invite'" @submit.prevent="createInvitation()" class="p-4 space-y-4">
					<div>
						<label for="fld-project-modal-8" class="block text-xs font-semibold text-neutral-700 mb-2">Select workspace</label>
						<select id="fld-project-modal-8" 
							x-model="orgId" 
							class="field"
						>
							for _, org := range orgs {
								<option value={ org.ID }>{ org.Name } ({ org.Slug })</option>
							}
						</select>
					</div>

					<div>
						<label for="fld-project-modal-9" class="block text-xs font-semibold text-neutral-700 mb-2">Colleague email</label>
						<input id="fld-project-modal-9" 
							type="email" 
							x-model="inviteEmail" 
							placeholder="colleague@company.com" 
							class="field"
							required
						/>
					</div>

					<div>
						<label for="fld-project-modal-10" class="block text-xs font-semibold text-neutral-700 mb-2">Role in Workspace</label>
						<select id="fld-project-modal-10" 
							x-model="inviteRole" 
							class="field"
						>
							<option value="developer">Developer (Create &amp; Manage Flags)</option>
							<option value="admin">Admin (Full Access &amp; Approvals)</option>
							<option value="viewer">Viewer (Read-Only Evaluations)</option>
						</select>
					</div>

					<!-- Generated Invite Link Box -->
					<div x-show="inviteUrl" class="space-y-2 p-3 rounded-md bg-accent-50 border border-accent-200">
						<label for="fld-project-modal-11" class="block text-2xs font-medium text-accent-700">Invitation link</label>
						<div class="flex items-center gap-2">
							<input id="fld-project-modal-11" 
								type="text" 
								readonly 
								:value="inviteUrl" 
								class="flex-1 px-2 py-1.5 text-xs font-mono bg-surface rounded-md border border-accent-200 text-neutral-900 select-all"
							/>
							<button 
								type="button" 
								@click="copyInviteLink" 
								class="px-4 py-1.5 rounded-md bg-accent-600 text-surface text-xs font-medium hover:bg-accent-700 transition shrink-0 flex items-center gap-1 cursor-pointer"
							>
								<i data-lucide="copy" class="w-3.5 h-3.5"></i>
								<span x-text="inviteCopied ? 'Copied' : 'Copy'"></span>
							</button>
						</div>
					</div>

					<div class="pt-3 border-t border-neutral-100 flex items-center justify-end gap-2">
						<button 
							type="button" 
							@click="close" 
							class="btn"
						>
							Close
						</button>
						<button 
							type="submit" 
							:disabled="submitting" 
							class="btn btn-primary"
						>
							<i data-lucide="send" class="w-3.5 h-3.5"></i>
							<span x-text="submitting ? 'Generating...' : 'Generate Invite Link'"></span>
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
