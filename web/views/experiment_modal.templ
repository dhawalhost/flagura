package views

templ ExperimentModal() {
	<div
		x-data="experimentModalComponent()"
		@open-experiment-modal.window="openModal($event.detail.key)"
		x-show="isOpen"
		x-cloak
		class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4"
	>
		<div
			@click.away="closeModal()"
			class="bg-white rounded-3xl max-w-3xl w-full border border-slate-200 shadow-2xl overflow-hidden transition-all max-h-[90vh] flex flex-col"
		>
			<!-- Header -->
			<div class="px-6 py-5 border-b border-slate-200 bg-slate-50/70 flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div class="h-10 w-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shadow-2xs">
						<i data-lucide="flask-conical" class="h-5 w-5"></i>
					</div>
					<div>
						<div class="flex items-center gap-2">
							<h3 class="font-extrabold text-slate-900 text-base font-display">A/B Experiment Statistical Engine</h3>
							<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-indigo-50 text-indigo-700 border border-indigo-200" x-text="flagKey"></span>
						</div>
						<p class="text-xs text-slate-500">Bayesian & Frequentist Z-Score significance testing</p>
					</div>
				</div>

				<button
					@click="closeModal()"
					class="p-2 text-slate-400 hover:text-slate-600 rounded-xl hover:bg-slate-100 transition cursor-pointer"
				>
					<i data-lucide="x" class="h-5 w-5"></i>
				</button>
			</div>

			<!-- Body -->
			<div class="p-6 overflow-y-auto space-y-6 flex-1 text-xs">
				<!-- Metric Selector & Quick Controls -->
				<div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-200">
					<div class="flex items-center gap-3">
						<span class="font-bold text-slate-700">Conversion Metric:</span>
						<input
							type="text"
							x-model="metricName"
							@change="fetchReport()"
							placeholder="e.g. checkout_completed"
							class="input-clean font-mono text-xs px-3 py-1.5 w-48"
						/>
					</div>

					<div class="flex items-center gap-2">
						<button
							@click="simulateConversion('treatment')"
							class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition cursor-pointer flex items-center gap-1.5 shadow-xs"
						>
							<i data-lucide="plus-circle" class="h-3.5 w-3.5"></i>
							<span>Simulate Treatment Conversion</span>
						</button>
						<button
							@click="simulateConversion('control')"
							class="px-3 py-1.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold text-xs transition cursor-pointer flex items-center gap-1.5"
						>
							<i data-lucide="plus-circle" class="h-3.5 w-3.5"></i>
							<span>Simulate Control</span>
						</button>
					</div>
				</div>

				<!-- Statistical Summary Banner -->
				<template x-if="report && report.winner_variant">
					<div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center gap-3">
						<div class="h-8 w-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold shrink-0 shadow-xs">
							🏆
						</div>
						<div class="flex-1">
							<div class="font-bold text-sm">Winning Variant Detected: <span class="font-mono" x-text="report.winner_variant"></span></div>
							<p class="text-xs text-emerald-700 mt-0.5" x-text="report.comparisons[report.winner_variant]?.recommended_action"></p>
						</div>
					</div>
				</template>

				<!-- Variant Comparison Cards -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<template x-for="(stats, variant) in (report?.variant_stats || {})" :key="variant">
						<div class="p-5 rounded-2xl border transition-all space-y-3" :class="variant === report?.winner_variant ? 'border-emerald-300 bg-emerald-50/40 shadow-xs' : 'border-slate-200 bg-white'">
							<div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
								<span class="font-mono font-bold text-slate-900 text-sm" x-text="variant"></span>
								<span
									class="px-2 py-0.5 rounded text-[10px] font-mono font-bold"
									:class="variant === report?.control_variant ? 'bg-slate-100 text-slate-700' : (variant === report?.winner_variant ? 'bg-emerald-100 text-emerald-800' : 'bg-indigo-50 text-indigo-700')"
									x-text="variant === report?.control_variant ? 'CONTROL BASELINE' : (variant === report?.winner_variant ? 'WINNER' : 'TREATMENT')"
								></span>
							</div>

							<div class="grid grid-cols-2 gap-2 text-slate-600 text-xs">
								<div>
									<div class="text-[10px] text-slate-400 font-mono">CONVERSION RATE</div>
									<div class="text-base font-extrabold text-slate-900 font-mono" x-text="(stats.conversion_rate * 100).toFixed(2) + '%'"></div>
								</div>
								<div>
									<div class="text-[10px] text-slate-400 font-mono">EXPOSURES / CONVERSIONS</div>
									<div class="font-bold text-slate-700 font-mono" x-text="stats.exposures + ' / ' + stats.conversions"></div>
								</div>
							</div>

							<div class="pt-1 text-[11px] font-mono text-slate-500">
								<span>95% Confidence Interval: </span>
								<span class="font-bold text-slate-800" x-text="'[' + (stats.ci95_lower * 100).toFixed(2) + '%, ' + (stats.ci95_upper * 100).toFixed(2) + '%]'"></span>
							</div>
						</div>
					</template>
				</div>

				<!-- Statistical Comparison Table -->
				<template x-if="report && Object.keys(report.comparisons || {}).length > 0">
					<div class="rounded-2xl border border-slate-200 overflow-hidden">
						<div class="bg-slate-50 px-4 py-2.5 font-bold text-slate-700 border-b border-slate-200">
							Two-Tailed Z-Test Significance vs. Control
						</div>
						<table class="w-full text-left">
							<thead class="bg-slate-50/50 text-[10px] uppercase font-mono text-slate-400 border-b border-slate-200">
								<tr>
									<th class="p-3">Treatment</th>
									<th class="p-3">Relative Lift</th>
									<th class="p-3">Z-Score</th>
									<th class="p-3">P-Value</th>
									<th class="p-3">Confidence</th>
									<th class="p-3">Status</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-100 font-mono">
								<template x-for="(comp, tKey) in report.comparisons" :key="tKey">
									<tr class="hover:bg-slate-50/50">
										<td class="p-3 font-bold text-slate-900" x-text="tKey"></td>
										<td class="p-3 font-bold" :class="comp.relative_lift_pct >= 0 ? 'text-emerald-600' : 'text-rose-600'" x-text="(comp.relative_lift_pct > 0 ? '+' : '') + comp.relative_lift_pct.toFixed(2) + '%'"></td>
										<td class="p-3 text-slate-600" x-text="comp.z_score.toFixed(2)"></td>
										<td class="p-3 text-slate-600" x-text="comp.p_value.toFixed(4)"></td>
										<td class="p-3 font-bold text-indigo-700" x-text="comp.confidence_pct.toFixed(1) + '%'"></td>
										<td class="p-3">
											<span
												class="px-2 py-0.5 rounded text-[10px] font-bold"
												:class="comp.status === 'WINNING' ? 'bg-emerald-100 text-emerald-800' : (comp.status === 'LOSING' ? 'bg-rose-100 text-rose-800' : 'bg-slate-100 text-slate-700')"
												x-text="comp.status"
											></span>
										</td>
									</tr>
								</template>
							</tbody>
						</table>
					</div>
				</template>
			</div>

			<!-- Footer -->
			<div class="px-6 py-4 border-t border-slate-200 bg-slate-50/70 flex items-center justify-between">
				<span class="text-[11px] text-slate-400 font-mono">Statistical model: Two-proportion pooled Z-test (α=0.05)</span>
				<button
					@click="closeModal()"
					class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs cursor-pointer transition shadow-xs"
				>
					Close Analysis
				</button>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('experimentModalComponent', () => ({
				isOpen: false,
				flagKey: '',
				metricName: 'conversion',
				report: null,
				openModal(key) {
					this.flagKey = key;
					this.isOpen = true;
					this.fetchReport();
					this.$nextTick(() => {
						if (window.lucide) window.lucide.createIcons();
					});
				},
				closeModal() {
					this.isOpen = false;
				},
				async fetchReport() {
					if (!this.flagKey) return;
					try {
						const res = await fetch(`/api/v1/experiments/${this.flagKey}?metric=${encodeURIComponent(this.metricName)}`);
						if (res.ok) {
							this.report = await res.json();
							this.$nextTick(() => {
								if (window.lucide) window.lucide.createIcons();
							});
						}
					} catch (e) {
						console.error('Failed to fetch experiment report:', e);
					}
				},
				async simulateConversion(variant) {
					try {
						await fetch('/api/v1/events', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								event: {
									flag_key: this.flagKey,
									variant: variant,
									metric_name: this.metricName,
									value: 1.0,
									environment: 'production',
								}
							})
						});
						this.fetchReport();
					} catch (e) {
						console.error('Simulation failed:', e);
					}
				}
			}));
		});

		window.openExperimentModal = function(flagKey) {
			window.dispatchEvent(new CustomEvent('open-experiment-modal', { detail: { key: flagKey } }));
		};
	</script>
}
