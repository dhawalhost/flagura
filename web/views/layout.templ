package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Flagura</title>
			<link rel="icon" href="/static/img/flagura-logo-circle.svg"/>
			<!-- Google Fonts: Geist & Geist Mono -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- Tailwind CSS CDN -->
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.tailwindcss.com"></script>
			<script nonce={ templ.GetNonce(ctx) }>
				tailwind.config = {
					theme: {
						extend: {
							fontFamily: {
								sans: ['"Geist"', 'Inter', '-apple-system', 'sans-serif'],
								display: ['"Geist"', 'sans-serif'],
								mono: ['"Geist Mono"', 'monospace'],
							}
						}
					}
				}
			</script>
			<!-- App CSS -->
			<link rel="stylesheet" href="/static/app.css"/>
			<!-- Eliminate Alpine.js Flash of Unstyled / Uninitialized Content (FOUC) -->
			<style>
				[x-cloak] { display: none !important; }
			</style>
			<!-- Flagura Application Bundle -->
			<script nonce={ templ.GetNonce(ctx) } defer src="/static/js/app.js"></script>
			<!-- Alpine.js (Official CSP-Hardened Build) & HTMX -->
			<script nonce={ templ.GetNonce(ctx) } defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.17.2/dist/cdn.min.js"></script>
			<script nonce={ templ.GetNonce(ctx) } src="https://unpkg.com/htmx.org@1.9.12"></script>
			<!-- Lucide Icons -->
			<script nonce={ templ.GetNonce(ctx) } src="https://unpkg.com/lucide@latest"></script>
			<!-- Chart.js & Three.js & GSAP -->
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.jsdelivr.net/npm/chart.js"></script>
			<script nonce={ templ.GetNonce(ctx) } src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
			<script nonce={ templ.GetNonce(ctx) } src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
			<script nonce={ templ.GetNonce(ctx) } src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
		</head>
		<body 
			class="h-full antialiased text-slate-900 bg-[#FAFAFA] selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden font-sans"
			x-data="globalApp()"
		>
			<!-- Toast Notification Manager -->
			<div 
				class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex flex-col gap-2.5 max-w-[calc(100vw-2.5rem)] sm:max-w-md w-full pointer-events-none"
				aria-live="polite"
				role="status"
			>
				<template x-for="toast in toasts" :key="toast.id">
					<div 
						class="pointer-events-auto relative overflow-hidden rounded-2xl p-4 shadow-xl border backdrop-blur-xl transition-all duration-300 group flex items-start gap-3.5"
						:class="toastCardClasses(toast)"
						@mouseenter="pauseToast(toast.id)"
						@mouseleave="resumeToast(toast.id)"
						x-transition:enter="transition ease-out duration-300 transform"
						x-transition:enter-start="opacity-0 translate-y-3 scale-95"
						x-transition:enter-end="opacity-100 translate-y-0 scale-100"
						x-transition:leave="transition ease-in duration-200 transform"
						x-transition:leave-start="opacity-100 translate-y-0 scale-100"
						x-transition:leave-end="opacity-0 translate-y-2 scale-95"
					>
						<!-- Left Icon Badge -->
						<div class="shrink-0 mt-0.5">
							<!-- Success Icon -->
							<template x-if="toast.type === 'success'">
								<div class="h-6 w-6 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
									<svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
								</div>
							</template>
							<!-- Error Icon -->
							<template x-if="toast.type === 'error'">
								<div class="h-6 w-6 rounded-full bg-rose-100 flex items-center justify-center text-rose-600">
									<svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="8" x2="12" y2="12"></line>
										<line x1="12" y1="16" x2="12.01" y2="16"></line>
									</svg>
								</div>
							</template>
							<!-- Warning Icon -->
							<template x-if="toast.type === 'warning'">
								<div class="h-6 w-6 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
									<svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
										<line x1="12" y1="9" x2="12" y2="13"></line>
										<line x1="12" y1="17" x2="12.01" y2="17"></line>
									</svg>
								</div>
							</template>
							<!-- Info Icon -->
							<template x-if="toast.type === 'info'">
								<div class="h-6 w-6 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600">
									<svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="16" x2="12" y2="12"></line>
										<line x1="12" y1="8" x2="12.01" y2="8"></line>
									</svg>
								</div>
							</template>
							<!-- Copied Icon -->
							<template x-if="toast.type === 'copied'">
								<div class="h-6 w-6 rounded-full bg-slate-800 flex items-center justify-center text-sky-400">
									<svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
										<rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
									</svg>
								</div>
							</template>
						</div>

						<!-- Message Content -->
						<div class="flex-1 min-w-0 pr-2">
							<template x-if="toast.title">
								<div 
									class="text-xs font-bold leading-tight mb-0.5 tracking-tight font-display"
									:class="toast.type === 'copied' ? 'text-white' : 'text-slate-900'"
									x-text="toast.title"
								></div>
							</template>
							<div 
								class="text-xs leading-relaxed font-sans"
								:class="{
									'text-slate-600 font-medium': toast.type !== 'copied' && toast.title,
									'text-slate-800 font-semibold font-mono': toast.type !== 'copied' && !toast.title,
									'text-slate-300 font-mono text-[11px]': toast.type === 'copied'
								}"
								x-text="toast.message"
							></div>

							<!-- Action Button -->
							<template x-if="toast.action">
								<div class="mt-2.5">
									<button 
										type="button"
										@click="executeToastAction(toast.id)"
										class="px-2.5 py-1 rounded-lg text-[11px] font-bold font-mono transition-colors shadow-2xs cursor-pointer flex items-center gap-1.5"
										:class="toast.type === 'copied' ? 'bg-white text-slate-900 hover:bg-slate-100' : 'bg-slate-900 text-white hover:bg-indigo-600'"
									>
										<span x-text="toast.action.label || 'Action'"></span>
										<svg class="w-3 h-3 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor">
											<polyline points="9 18 15 12 9 6"></polyline>
										</svg>
									</button>
								</div>
							</template>
						</div>

						<!-- Close Button -->
						<button 
							type="button"
							@click="dismissToast(toast.id)"
							class="shrink-0 p-1 rounded-lg transition-colors cursor-pointer"
							:class="toast.type === 'copied' ? 'text-slate-400 hover:text-white hover:bg-slate-800' : 'text-slate-400 hover:text-slate-700 hover:bg-slate-100'"
							aria-label="Dismiss notification"
						>
							<svg class="w-3.5 h-3.5 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<line x1="18" y1="6" x2="6" y2="18"></line>
								<line x1="6" y1="6" x2="18" y2="18"></line>
							</svg>
						</button>

						<!-- Animated Progress Bar -->
						<div 
							class="absolute bottom-0 left-0 h-1 transition-all duration-100 ease-linear rounded-b-2xl"
							:class="toastProgressBarClasses(toast)"
							:style="toastProgressStyle(toast)"
						></div>
					</div>
				</template>
			</div>

			<!-- Main Content Slot -->
			<div class="relative z-10 min-h-full">
				{ children... }
			</div>
		</body>
	</html>
}
