package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Flagura</title>
			<link rel="icon" href="/static/img/flagura-logo-circle.svg"/>
			<!-- Applied before first paint so the stored theme never flashes. -->
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
					var theme = null;
					try { theme = localStorage.getItem('flagura-theme'); } catch (e) {}
					if (theme !== 'light' && theme !== 'dark') {
						theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					document.documentElement.setAttribute('data-theme', theme);
				})();
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet"/>
			<!-- Tailwind CSS CDN -->
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.tailwindcss.com"></script>
			<script nonce={ templ.GetNonce(ctx) }>
				(function () {
					var token = function (name) { return 'rgb(var(--' + name + ') / <alpha-value>)'; };
					var hue = function (name) {
						var tint = token(name + '-tint'), line = token(name + '-line'), bright = token(name + '-bright'), mark = token(name + '-mark'), text = token(name + '-text');
						return { 50: tint, 100: tint, 200: line, 300: bright, 400: bright, 500: mark, 600: mark, 700: text, 800: text, 900: text, 950: text };
					};
					var neutral = {};
					[50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950].forEach(function (step) { neutral[step] = token('n-' + step); });
					tailwind.config = {
						theme: {
							extend: {
								colors: {
									canvas: token('canvas'),
									surface: token('surface'),
									scrim: token('scrim'),
									neutral: neutral,
									accent: hue('accent'),
									ok: hue('ok'),
									warn: hue('warn'),
									danger: hue('danger')
								},
								fontFamily: {
									sans: ['var(--font-sans)'],
									mono: ['var(--font-mono)']
								},
								fontSize: {
									'2xs': ['11px', '16px'],
									xs: ['12px', '16px'],
									sm: ['13px', '18px'],
									base: ['14px', '20px'],
									lg: ['16px', '22px'],
									xl: ['18px', '24px'],
									'2xl': ['20px', '26px'],
									'3xl': ['24px', '30px'],
									'4xl': ['30px', '36px'],
									'5xl': ['38px', '44px']
								},
								boxShadow: {
									pop: 'var(--shadow-pop)'
								}
							}
						}
					};
				})();
			</script>
			<!-- App CSS -->
			<link rel="stylesheet" href="/static/app.css"/>
			<!-- Eliminate Alpine.js Flash of Unstyled / Uninitialized Content (FOUC) -->
			<style>
				[x-cloak] { display: none !important; }
			</style>
			<!-- Flagura Application Bundle -->
			<script nonce={ templ.GetNonce(ctx) } defer src="/static/js/app.js"></script>
			<!-- Alpine.js (Official CSP-Hardened Build) & HTMX -->
			<script nonce={ templ.GetNonce(ctx) } defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.17.2/dist/cdn.min.js"></script>
			<script nonce={ templ.GetNonce(ctx) } src="https://unpkg.com/htmx.org@1.9.12"></script>
			<!-- Lucide Icons -->
			<script nonce={ templ.GetNonce(ctx) } src="https://unpkg.com/lucide@latest"></script>
			<!-- Chart.js -->
			<script nonce={ templ.GetNonce(ctx) } src="https://cdn.jsdelivr.net/npm/chart.js"></script>
		</head>
		<body 
			class="h-full antialiased text-neutral-900 bg-canvas overflow-x-hidden font-sans"
			x-data="globalApp()"
		>
			<!-- Toast Notification Manager -->
			<div 
				class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-[calc(100vw-2rem)] sm:max-w-sm w-full pointer-events-none"
				aria-live="polite"
				role="status"
			>
				<template x-for="toast in toasts" :key="toast.id">
					<div 
						class="pointer-events-auto relative overflow-hidden rounded-md p-3 shadow-pop border bg-surface border-neutral-200 text-neutral-900 flex items-start gap-2.5"
						@mouseenter="pauseToast(toast.id)"
						@mouseleave="resumeToast(toast.id)"
						x-transition:enter="transition ease-out duration-150"
						x-transition:enter-start="opacity-0"
						x-transition:enter-end="opacity-100"
						x-transition:leave="transition ease-in duration-100"
						x-transition:leave-start="opacity-100"
						x-transition:leave-end="opacity-0"
					>
						<div class="shrink-0 mt-px" :class="toastIconClasses(toast)">
							<template x-if="toast.type === 'success'">
								<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>
							</template>
							<template x-if="toast.type === 'error'">
								<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
							</template>
							<template x-if="toast.type === 'warning'">
								<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
							</template>
							<template x-if="toast.type === 'info'">
								<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
							</template>
							<template x-if="toast.type === 'copied'">
								<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
							</template>
						</div>

						<div class="flex-1 min-w-0">
							<template x-if="toast.title">
								<div class="text-sm font-medium" x-text="toast.title"></div>
							</template>
							<div class="text-sm text-neutral-600 break-words" x-text="toast.message"></div>
							<template x-if="toast.action">
								<button 
									type="button"
									@click="executeToastAction(toast.id)"
									class="mt-1.5 text-xs font-medium text-accent-600 hover:underline cursor-pointer"
									x-text="toast.action.label || 'Action'"
								></button>
							</template>
						</div>

						<button 
							type="button"
							@click="dismissToast(toast.id)"
							class="shrink-0 p-0.5 rounded text-neutral-400 hover:text-neutral-900 transition-colors cursor-pointer"
							aria-label="Dismiss notification"
						>
							<svg class="w-4 h-4 stroke-2" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
						</button>

						<div 
							class="absolute bottom-0 left-0 h-0.5 ease-linear"
							:class="toastProgressBarClasses(toast)"
							:style="toastProgressStyle(toast)"
						></div>
					</div>
				</template>
			</div>

			<!-- Main Content Slot -->
			<div class="relative z-10 min-h-full">
				{ children... }
			</div>
		</body>
	</html>
}
