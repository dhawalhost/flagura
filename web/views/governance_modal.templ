package views

import (
	"fmt"
	"github.com/dhawalhost/flagura/pkg/domain"
)

templ GovernanceModal(user *domain.User, changeRequests []domain.ChangeRequest) {
	<div
		x-data="governanceModalComponent()"
		@open-governance-modal.window="open = true"
		@keydown.escape.window="close"
		x-show="open"
		x-cloak
		class="fixed inset-0 z-50 overflow-y-auto"
		aria-labelledby="modal-title"
		role="dialog"
		aria-modal="true"
	>
		<!-- Backdrop -->
		<div
			x-show="open"
			x-transition:enter="ease-out duration-150"
			x-transition:enter-start="opacity-0"
			x-transition:enter-end="opacity-100"
			x-transition:leave="ease-in duration-200"
			x-transition:leave-start="opacity-100"
			x-transition:leave-end="opacity-0"
			class="fixed inset-0 bg-scrim/40 transition-opacity"
			@click="close"
		></div>

		<div class="flex min-h-full items-center justify-center p-4 text-center sm:p-4">
			<div
				x-show="open"
				x-transition:enter="ease-out duration-150"
				x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave="ease-in duration-200"
				x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
				x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
				class="relative w-full max-w-4xl transform overflow-hidden rounded-xl bg-surface border border-neutral-200 text-left shadow-pop transition-colors"
				@click.away="close"
			>
				<!-- Header -->
				<div class="flex items-center justify-between border-b border-neutral-100 bg-surface px-6 py-4">
					<div class="flex items-center space-x-3">
						<div>
							<h3 class="text-base font-semibold text-neutral-900 flex items-center gap-2">
								Change approvals
							</h3>
							<p class="text-xs text-neutral-500 font-sans">Review, approve, and audit production flag mutations before deployment</p>
						</div>
					</div>
					<button @click="close" class="rounded-md p-1.5 text-neutral-400 hover:bg-neutral-100 hover:text-neutral-700 transition cursor-pointer">
						<i data-lucide="x" class="h-5 w-5"></i>
					</button>
				</div>

				<!-- Content Body -->
				<div class="p-4">
					if len(changeRequests) == 0 {
						<div class="py-12 text-center space-y-3">
							<div class="mx-auto flex h-14 w-14 items-center justify-center rounded-md bg-ok-50 text-ok-600 border border-ok-200 mb-2">
								<i data-lucide="check-circle-2" class="h-7 w-7 text-ok-600"></i>
							</div>
							<h4 class="text-base font-semibold text-neutral-900">No changes waiting for approval</h4>
							<p class="text-xs text-neutral-500 max-w-sm mx-auto font-sans leading-relaxed">
								All production configurations are synced. New change proposals requiring peer review will appear here.
							</p>
						</div>
					} else {
						<div class="space-y-4">
							for _, cr := range changeRequests {
								<div class="rounded-md border border-neutral-200 bg-neutral-50/50 p-5 hover:border-neutral-300 transition-colors font-mono">
									<div class="flex items-start justify-between gap-4">
										<div class="space-y-2">
											<div class="flex items-center gap-2 flex-wrap">
												<span class="font-mono text-sm font-medium text-accent-700">{ cr.FlagKey }</span>
												<span class="badge badge-ok">
													{ string(cr.Environment) }
												</span>
												<span class="badge badge-warn">
													{ string(cr.Status) }
												</span>
											</div>
											<h4 class="text-base font-semibold text-neutral-900 font-sans">{ cr.Title }</h4>
											if cr.Description != "" {
												<p class="text-xs text-neutral-500 font-sans">{ cr.Description }</p>
											}
											<div class="flex items-center gap-3 pt-2 text-xs text-neutral-500">
												<span>Author: <strong class="text-neutral-900">{ cr.AuthorEmail }</strong></span>
												<span>Strategy: <strong class="text-neutral-900">{ string(cr.ProposedConfig.Strategy) }</strong></span>
												<span>Rollout: <strong class="text-accent-600">{ fmt.Sprintf("%.0f%%", cr.ProposedConfig.Percentage) }</strong></span>
											</div>
										</div>

										<!-- Actions -->
										if cr.Status == domain.ChangeRequestStatusPending {
											if user != nil && user.Email == cr.AuthorEmail {
												<div class="text-right">
													<span class="inline-flex items-center gap-2 rounded-md bg-warn-50 px-3 py-1.5 text-xs font-medium text-warn-700 border border-warn-200">
														<i data-lucide="alert-circle" class="h-3.5 w-3.5"></i>
														Awaiting Peer Review (Self-Approval Prohibited)
													</span>
												</div>
											} else {
												<div class="flex items-center gap-2">
													<button
														data-cr-id={ cr.ID }
														data-approved="true"
														@click="handleReviewClick"
														:disabled="submitting"
														class="inline-flex items-center gap-2 rounded-md bg-accent-600 hover:bg-accent-700 px-4 py-2 text-xs font-medium text-surface transition-colors cursor-pointer disabled:opacity-50"
													>
														<i data-lucide="check" class="h-3.5 w-3.5 text-surface"></i>
														Approve &amp; Apply
													</button>
													<button
														data-cr-id={ cr.ID }
														data-approved="false"
														@click="handleReviewClick"
														:disabled="submitting"
														class="btn btn-danger disabled:opacity-50"
													>
														<i data-lucide="x" class="h-3.5 w-3.5"></i>
														Reject
													</button>
												</div>
											}
										}
									</div>
								</div>
							}
						</div>
					}
				</div>

				<!-- Footer -->
				<div class="flex items-center justify-between border-t border-neutral-100 bg-neutral-50 px-6 py-4 text-xs text-neutral-500">
					<span></span>
					<button @click="close" class="btn">
						Close
					</button>
				</div>
			</div>
		</div>
	</div>
}
