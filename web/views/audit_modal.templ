package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ AuditModal(auditLogs []domain.AuditLogEntry) {
	<div class="space-y-5" x-show="activeView === 'audit'" x-cloak x-data="auditViewComponent()">
		<!-- Top Header Card -->
		<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-3">
			<p class="text-sm text-neutral-500">Hash-chained record of flag, rollout and kill-switch changes</p>

			<div class="flex flex-wrap items-center gap-2 self-end sm:self-auto">
				<!-- Integrity Verification Status Badge -->
				<template x-if="integrityResult && integrityResult.valid">
					<span class="px-3 py-1.5 rounded-md bg-ok-50 text-ok-700 border border-ok-200 text-xs font-mono font-medium flex items-center gap-2">
						<i data-lucide="shield-check" class="h-3.5 w-3.5 text-ok-600"></i>
						<span x-text="'Verified (' + integrityResult.total_verified + ' linked)'"></span>
					</span>
				</template>
				<template x-if="integrityResult && !integrityResult.valid">
					<span class="px-3 py-1.5 rounded-md bg-danger-50 text-danger-700 border border-danger-200 text-xs font-mono font-medium flex items-center gap-2">
						<i data-lucide="alert-triangle" class="h-3.5 w-3.5 text-danger-600"></i>
						<span x-text="'Tamper: ' + (integrityResult.error_message || 'broken chain')"></span>
					</span>
				</template>

				<button
					@click="verifyIntegrity()"
					class="btn"
					:disabled="verifying"
					title="Cryptographically verify SHA-256 hash chaining of audit logs"
				>
					<span class="inline-flex" :class="verifying ? 'animate-spin' : ''"><i data-lucide="shield-alert" class="h-3.5 w-3.5"></i></span>
					<span x-text="verifying ? 'Verifying...' : 'Verify Chain'"></span>
				</button>

				<button
					@click="exportLogs('csv')"
					class="btn"
					title="Export audit logs as RFC 4180 CSV"
				>
					<i data-lucide="file-spreadsheet" class="h-3.5 w-3.5 text-neutral-500"></i>
					<span>Export CSV</span>
				</button>
				<button
					@click="exportLogs('json')"
					class="btn"
					title="Export audit logs as JSON"
				>
					<i data-lucide="file-code" class="h-3.5 w-3.5 text-neutral-500"></i>
					<span>JSON</span>
				</button>

				<button
					@click="fetchLogs()"
					class="btn"
					:disabled="loading"
				>
					<span class="inline-flex" :class="loading ? 'animate-spin' : ''"><i data-lucide="rotate-ccw" class="h-3.5 w-3.5"></i></span>
					<span>Refresh</span>
				</button>
			</div>
		</div>

		<!-- Logs Container -->
		<section class="panel overflow-hidden">
			<div class="flex items-center justify-between border-b border-neutral-200 px-4 py-2">
				<h3 class="text-sm text-neutral-900">Events</h3>
				<input type="search" x-model="auditFilter" aria-label="Filter events" placeholder="Filter by flag, actor or action" class="field flex-1 max-w-xs mx-3"/>
				<span class="text-xs text-neutral-500">{ fmt.Sprintf("%d recorded", len(auditLogs)) }</span>
			</div>
			<ul class="divide-y divide-neutral-100">
				for _, log := range auditLogs {
					<li class="px-4 py-2 space-y-1" data-search={ log.FlagKey + " " + log.Actor + " " + log.Action } x-show="matchesAudit($el, auditFilter)">
						<div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
							<div class="flex items-center gap-2 min-w-0">
								<span class="font-mono text-sm text-neutral-900 truncate">{ log.FlagKey }</span>
								<span
									class="font-mono text-2xs"
									class={ templ.KV("text-danger-700", log.Action == "KILL_SWITCH_TOGGLED"), templ.KV("text-neutral-500", log.Action != "KILL_SWITCH_TOGGLED") }
								>{ log.Action }</span>
							</div>
							<span class="font-mono text-2xs text-neutral-400">{ log.Timestamp.Format("2006-01-02 15:04:05") }</span>
						</div>
						<p class="text-xs text-neutral-600">{ log.Details }</p>
						<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-2xs text-neutral-500">
							<span>{ log.Actor }</span>
							<span>env <span class="font-mono">{ string(log.Environment) }</span></span>
							if log.EntryHash != "" {
								<span title={ log.EntryHash }>
									hash <span class="font-mono">
										if len(log.EntryHash) > 12 {
											{ log.EntryHash[:12] }
										} else {
											{ log.EntryHash }
										}
									</span>
								</span>
							}
							if log.PrevHash != "" {
								<span title={ log.PrevHash }>
									prev <span class="font-mono">
										if len(log.PrevHash) > 12 {
											{ log.PrevHash[:12] }
										} else {
											{ log.PrevHash }
										}
									</span>
								</span>
							}
						</div>
					</li>
				}
				if len(auditLogs) == 0 {
					<li class="p-6 text-center text-sm text-neutral-500">No changes recorded yet.</li>
				}
			</ul>
		</section>
	</div>
}
