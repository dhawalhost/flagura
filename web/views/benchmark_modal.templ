package views

templ BenchmarkModal() {
	<div class="space-y-4" x-show="activeView === 'benchmark'" x-cloak x-data="benchmarkViewComponent()">
		<div class="page-head flex flex-wrap items-center justify-between gap-3">
			<p class="text-sm text-neutral-500">Measure flag evaluation latency on this server</p>
			<button type="button" @click="navigateTo('evaluator')" class="text-xs text-accent-600 hover:underline cursor-pointer">Back to evaluator</button>
		</div>

		<div class="panel p-4 flex flex-col sm:flex-row sm:items-end gap-4">
			<div class="flex-1 w-full">
				<div class="flex justify-between">
					<label for="fld-benchmark-modal-1" class="field-label">Iterations</label>
					<span class="font-mono text-xs text-neutral-900" x-text="formatNumber(iterations)"></span>
				</div>
				<input id="fld-benchmark-modal-1" type="range" min="1000" max="50000" step="1000" x-model="iterations" class="w-full cursor-pointer"/>
			</div>
			<button @click="runStressTest()" class="btn btn-primary" :disabled="isRunning">
				<i data-lucide="play" class="h-3.5 w-3.5"></i>
				<span x-text="isRunning ? 'Running' : 'Run benchmark'"></span>
			</button>
		</div>

		<p class="text-sm text-neutral-500" x-show="!metrics">No results yet. Run the benchmark to measure this server.</p>

		<template x-if="metrics">
			<div class="space-y-4">
				<div class="panel grid grid-cols-2 lg:grid-cols-4 divide-x divide-neutral-200">
					<div class="px-4 py-3">
						<div class="text-xs text-neutral-500">Throughput</div>
						<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" x-text="metrics.opsPerSec ? formatNumber(metrics.opsPerSec) : 'N/A'"></div>
						<div class="text-2xs text-neutral-500">ops/s</div>
					</div>
					<div class="px-4 py-3">
						<div class="text-xs text-neutral-500">P50</div>
						<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" x-text="metrics.p50Ns"></div>
						<div class="text-2xs text-neutral-500">ns</div>
					</div>
					<div class="px-4 py-3 border-t border-neutral-200 lg:border-t-0">
						<div class="text-xs text-neutral-500">P99</div>
						<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" x-text="metrics.p99Ns"></div>
						<div class="text-2xs text-neutral-500">ns</div>
					</div>
					<div class="px-4 py-3 border-t border-neutral-200 lg:border-t-0">
						<div class="text-xs text-neutral-500">Total</div>
						<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" x-text="metrics.totalDurationMs"></div>
						<div class="text-2xs text-neutral-500">ms</div>
					</div>
				</div>

				<section class="panel p-4">
					<h3 class="text-sm text-neutral-900">Hash bucket distribution</h3>
					<p class="text-xs text-neutral-500 mb-3">Evaluations per bucket, 100 buckets. Even bars mean even rollouts.</p>
					<div class="h-56 w-full">
						<canvas id="benchmarkHistogramCanvas"></canvas>
					</div>
				</section>

				<section class="panel overflow-hidden">
					<div class="px-4 py-2 border-b border-neutral-200 flex items-center justify-between gap-3">
						<div>
							<h3 class="text-sm text-neutral-900">Local evaluation vs network</h3>
							<p class="text-xs text-neutral-500">Probe round trips from this browser to compare</p>
						</div>
						<button @click="probeLiveNetwork()" class="btn shrink-0" :disabled="networkProbing">
							<span class="inline-flex" :class="networkProbing ? 'animate-spin' : ''"><i data-lucide="activity" class="h-3.5 w-3.5"></i></span>
							<span x-text="networkProbing ? 'Probing' : 'Probe network'"></span>
						</button>
					</div>
					<dl class="divide-y divide-neutral-100 text-sm">
						<div class="flex justify-between px-4 py-2">
							<dt class="text-neutral-600">In-process P50</dt>
							<dd class="font-mono text-neutral-900" x-text="metrics.p50Ns + ' ns'"></dd>
						</div>
						<template x-if="networkResults">
							<div class="divide-y divide-neutral-100">
								<div class="flex justify-between gap-3 px-4 py-2">
									<dt class="text-neutral-600">Network target</dt>
									<dd class="font-mono text-neutral-900 truncate" x-text="getTargetOrigin()"></dd>
								</div>
								<div class="flex justify-between px-4 py-2">
									<dt class="text-neutral-600">Samples</dt>
									<dd class="font-mono text-neutral-900" x-text="networkResults.samples.length"></dd>
								</div>
								<div class="flex justify-between px-4 py-2">
									<dt class="text-neutral-600">Min round trip</dt>
									<dd class="font-mono text-neutral-900" x-text="networkResults.min.toFixed(2) + ' ms'"></dd>
								</div>
								<div class="flex justify-between px-4 py-2">
									<dt class="text-neutral-600">Median round trip</dt>
									<dd class="font-mono text-neutral-900" x-text="networkResults.p50.toFixed(2) + ' ms'"></dd>
								</div>
								<div class="flex justify-between px-4 py-2">
									<dt class="text-neutral-600">Average round trip</dt>
									<dd class="font-mono text-neutral-900" x-text="networkResults.avg.toFixed(2) + ' ms'"></dd>
								</div>
								<div class="flex justify-between px-4 py-2">
									<dt class="text-neutral-600">Local is faster by</dt>
									<dd class="font-mono text-neutral-900" x-text="getSpeedupFactor()"></dd>
								</div>
							</div>
						</template>
					</dl>
				</section>
			</div>
		</template>
	</div>
}
