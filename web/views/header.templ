package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"strings"
)

templ HeaderBar(user *domain.User, flags []domain.FeatureFlag, currentEnv string) {
	<header class="bg-surface px-4 py-2 border-b border-neutral-200 sticky top-0 z-30 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-2 md:gap-4">
		<!-- Left: View Title & Environment Pill -->
		<div class="flex items-center gap-3">
			<button 
				@click="isMobileSidebarOpen = !isMobileSidebarOpen"
				class="lg:hidden p-2 rounded-md bg-neutral-50 hover:bg-neutral-100 text-neutral-700 border border-neutral-200 cursor-pointer"
			>
				<i data-lucide="menu" class="w-4 h-4"></i>
			</button>

			<div class="flex items-center gap-2.5">
				<h2 class="text-sm font-semibold text-neutral-900" x-text="getViewTitle()">
					Overview
				</h2>
				<span class="text-neutral-300 font-mono">/</span>
				
				<!-- Environment Selector Dropdown -->
				<div class="relative" x-data="dropdownComponent()">
					<button 
						@click="toggle()" 
						class="flex items-center gap-1.5 px-3 py-1.5 rounded text-2xs font-medium transition border cursor-pointer"
						:class="{
							'bg-ok-50 text-ok-700 border-ok-200': currentEnv === 'production',
							'bg-warn-50 text-warn-700 border-warn-200': currentEnv === 'staging',
							'bg-accent-50 text-accent-700 border-accent-200': currentEnv === 'development'
						}"
					>
						<span class="w-1.5 h-1.5 rounded-full" :class="{
							'bg-ok-500': currentEnv === 'production',
							'bg-warn-500': currentEnv === 'staging',
							'bg-accent-500': currentEnv === 'development'
						}"></span>
						<span class="font-medium" x-text="currentEnv"></span>
						<i data-lucide="chevron-down" class="w-3 h-3 opacity-60"></i>
					</button>

					<div 
						x-show="isOpen" 
						@click.outside="close()" 
						class="absolute left-0 mt-2 w-44 bg-surface p-1.5 z-50 shadow-pop border border-neutral-200 rounded-md space-y-1"
						style="display: none;"
						x-transition
					>
						<button 
							@click="selectEnv('production')"
							class="w-full text-left px-3 py-2 rounded-md text-xs flex items-center justify-between hover:bg-ok-50 hover:text-ok-700 text-neutral-700 cursor-pointer transition-colors"
						>
							<span>Production</span>
							<span class="w-2 h-2 rounded-full bg-ok-500"></span>
						</button>
						<button 
							@click="selectEnv('staging')"
							class="w-full text-left px-3 py-2 rounded-md text-xs flex items-center justify-between hover:bg-warn-50 hover:text-warn-700 text-neutral-700 cursor-pointer transition-colors"
						>
							<span>Staging</span>
							<span class="w-2 h-2 rounded-full bg-warn-500"></span>
						</button>
						<button 
							@click="selectEnv('development')"
							class="w-full text-left px-3 py-2 rounded-md text-xs flex items-center justify-between hover:bg-accent-50 hover:text-accent-700 text-neutral-700 cursor-pointer transition-colors"
						>
							<span>Development</span>
							<span class="w-2 h-2 rounded-full bg-accent-500"></span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Center: Fast Search -->
		<div class="flex-1 max-w-md mx-auto w-full relative font-mono">
			<i data-lucide="search" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
			<input 
				type="text" 
				x-model="searchQuery"
				placeholder="Search flags" 
				class="w-full bg-neutral-50 border border-neutral-200 rounded-md pl-9 pr-9 py-2 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors"
				@keydown.window.prevent.slash="focusSearch($el)"
			/>
			<kbd class="hidden sm:inline-block absolute right-2.5 top-1/2 -translate-y-1/2 px-1.5 py-0.5 text-2xs font-mono text-neutral-400 bg-surface border border-neutral-200 rounded">
				/
			</kbd>
		</div>

		<!-- Right: Action Bar -->
		<div class="flex items-center justify-end gap-2.5 font-mono">
			<!-- Latency Benchmark Quick Button -->
			<button 
				@click="navigateTo('benchmark')"
				class="px-3 py-1.5 rounded-md bg-surface hover:bg-neutral-50 text-neutral-700 text-xs font-semibold flex items-center gap-1.5 border border-neutral-200 transition cursor-pointer"
				title="Run Live Latency Benchmark"
			>
				<i data-lucide="activity" class="w-3.5 h-3.5"></i>
				<span class="hidden sm:inline">Benchmark</span>
			</button>

			<!-- Theme -->
			<button 
				type="button"
				@click="toggleTheme()"
				class="p-1.5 rounded-md bg-surface hover:bg-neutral-50 text-neutral-600 border border-neutral-200 transition-colors cursor-pointer"
				aria-label="Switch colour theme"
				title="Switch colour theme"
			>
				<span x-show="isDark"><i data-lucide="sun" class="w-3.5 h-3.5"></i></span>
				<span x-show="!isDark"><i data-lucide="moon" class="w-3.5 h-3.5"></i></span>
			</button>

			<!-- Real Authenticated User Profile Menu -->
			<div class="relative" x-data="dropdownComponent()">
				<button 
					@click="toggle()"
					class="flex items-center gap-2 pl-1.5 pr-2.5 py-1 rounded-md bg-surface hover:bg-neutral-50 border border-neutral-200 transition cursor-pointer"
				>
					<div class="w-6 h-6 rounded-full bg-accent-600 text-surface flex items-center justify-center text-2xs font-medium">
						if user != nil && user.Name != "" {
							<span>{ string([]rune(user.Name)[0]) }</span>
						} else {
							<span>U</span>
						}
					</div>
					<span class="text-xs font-medium text-neutral-700 hidden sm:inline">
						if user != nil && user.Name != "" {
							{ user.Name }
						} else {
							Developer
						}
					</span>
					<i data-lucide="chevron-down" class="w-3 h-3 text-neutral-400"></i>
				</button>

				<div 
					x-show="isOpen" 
					@click.outside="close()" 
					class="absolute right-0 mt-2 w-64 bg-surface p-3 z-50 shadow-pop border border-neutral-200 rounded-md space-y-2"
					style="display: none;"
					x-transition
				>
					<div class="p-2 border-b border-neutral-100 mb-1 space-y-1">
						<div class="text-xs font-medium text-neutral-900">
							if user != nil && user.Name != "" {
								{ user.Name }
							} else {
								Developer
							}
						</div>
						<div class="text-2xs font-mono text-neutral-500 truncate">
							if user != nil && user.Email != "" {
								{ user.Email }
							} else {
								user@flagura.dev
							}
						</div>
						<div class={"inline-block mt-1 px-2 py-0.5 rounded text-2xs font-mono uppercase font-medium " + orgRoleClass(user)}>
							if user != nil && user.EffectiveRole() != "" {
								{ "Role: " + strings.ToUpper(user.EffectiveRole()[:1]) + strings.ToLower(user.EffectiveRole()[1:]) }
							} else {
								Role: Member
							}
						</div>
					</div>

					<button 
						@click="openProfile()"
						class="w-full text-left px-2.5 py-1.5 rounded text-xs hover:bg-accent-50 text-neutral-700 hover:text-accent-700 flex items-center gap-2 cursor-pointer transition font-sans font-medium"
					>
						<i data-lucide="user-cog" class="w-3.5 h-3.5 text-accent-600"></i>
						<span>Profile Settings</span>
					</button>

					<a 
						href="/"
						class="w-full text-left px-2.5 py-1.5 rounded text-xs hover:bg-neutral-50 text-neutral-700 flex items-center gap-2 cursor-pointer transition font-sans"
					>
						<i data-lucide="external-link" class="w-3.5 h-3.5 text-neutral-400"></i>
						<span>Landing Page</span>
					</a>

					<div class="border-t border-neutral-100 my-1"></div>

					<!-- Real Logout Button -->
					<button 
						@click="logout()"
						class="w-full text-left px-2.5 py-1.5 rounded text-xs hover:bg-danger-50 text-danger-600 flex items-center gap-2 cursor-pointer transition font-semibold font-sans"
					>
						<i data-lucide="log-out" class="w-3.5 h-3.5 text-danger-600"></i>
						<span>Sign Out</span>
					</button>
				</div>
			</div>

			<!-- Create Flag Button -->
			<button 
				@click="openNewFlagEditor()"
				class="px-4 py-2 rounded-md bg-accent-600 hover:bg-accent-700 text-surface font-medium text-xs transition-colors flex items-center gap-1.5 cursor-pointer"
			>
				<i data-lucide="plus" class="w-3.5 h-3.5 text-surface"></i>
				<span class="hidden sm:inline">New Flag</span>
			</button>
		</div>
	</header>
}

// orgRoleClass returns Tailwind CSS classes for the role badge based on the
// org-scoped role. Owner/Admin get a distinct color to signal elevated access.
func orgRoleClass(user *domain.User) string {
	if user == nil {
		return "bg-neutral-50 text-neutral-600 border border-neutral-200"
	}
	switch user.EffectiveRole() {
	case "owner":
		return "bg-accent-50 text-accent-700 border border-accent-200"
	case "admin":
		if user.Role == domain.RoleAdmin && user.ActiveMembership == nil {
			return "bg-danger-50 text-danger-700 border border-danger-200"
		}
		return "bg-accent-50 text-accent-700 border border-accent-200"
	case "developer":
		return "bg-accent-50 text-accent-700 border border-accent-200"
	case "viewer":
		return "bg-neutral-50 text-neutral-600 border border-neutral-200"
	default:
		return "bg-neutral-50 text-neutral-600 border border-neutral-200"
	}
}
