package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ AnalyticsDashboard(flags []domain.FeatureFlag) {
	<div class="space-y-5" x-show="activeView === 'analytics'" x-cloak x-data="analyticsViewComponent()">
		<!-- Page Header -->
		<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-3">
			<p class="text-sm text-neutral-500">Evaluation volume reported by connected SDKs over the last 24 hours</p>

			<!-- Global actions -->
			<div class="flex items-center gap-2">
				<button
					@click="navigateTo('flags')"
					class="btn"
				>
					<i data-lucide="sliders" class="h-3.5 w-3.5 text-neutral-500"></i>
					<span>Manage flags</span>
				</button>
				<button
					@click="navigateTo('evaluator')"
					class="btn btn-primary"
				>
					<i data-lucide="zap" class="h-3.5 w-3.5 text-surface"></i>
					<span>Open evaluator</span>
				</button>
			</div>
		</div>

		<div class="panel grid grid-cols-2 divide-x divide-neutral-200">
			<div class="px-4 py-3">
				<div class="text-xs text-neutral-500">Evaluations, last 24h</div>
				<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" x-text="totalEvaluationsLabel"></div>
			</div>
			<div class="px-4 py-3">
				<div class="text-xs text-neutral-500">Partial rollouts in production</div>
				<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900">{ fmt.Sprintf("%d", summarizeEnvironments(flags)[0].Partial) }</div>
			</div>
		</div>

		<!-- 24-Hour Evaluation Volume Hourly Chart -->
		<div class="panel p-4 space-y-5">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-neutral-100 pb-4">
				<div>
					<div class="text-xs font-medium text-neutral-600">Evaluations by hour</div>
					<div class="text-xs text-neutral-500 mt-0.5 font-sans">Two-hour buckets, last 24 hours</div>
				</div>
				<div class="flex items-center gap-2">
					<select 
						aria-label="Choose flag" x-model="selectedAnalyticsFlag" 
						@change="updateAnalyticsChart()"
						class="field font-mono"
					>
						<option value="all">All flags</option>
						for _, f := range flags {
							<option value={ f.Key }>{ f.Key } ({ f.Name })</option>
						}
					</select>
				</div>
			</div>

			<p class="text-sm text-neutral-500" x-show="!hasData">No evaluations reported yet. Connect an SDK with telemetry enabled to see volume here.</p>
			<div class="h-64 w-full" x-show="hasData">
				<canvas id="analyticsChartCanvas"></canvas>
			</div>
		</div>

		<!-- Per-Flag Performance Breakdown Table -->
		<div class="panel p-4 space-y-5">
			<div class="flex items-center justify-between border-b border-neutral-100 pb-4">
				<span class="text-xs font-medium text-neutral-600">Flags</span>
				<span class="text-xs font-mono text-neutral-500"><span class="font-mono" x-text="currentEnv"></span></span>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs font-mono">
					<thead class="border-b border-neutral-200 text-xs text-neutral-500">
						<tr>
							<th class="px-4 py-2 font-normal">Key</th>
							<th class="px-4 py-2 font-normal">Rollout</th>
							<th class="px-4 py-2 font-normal">Strategy</th>
							<th class="px-4 py-2 text-right font-normal">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-neutral-100">
						for _, f := range flags {
							<tr class="group hover:bg-neutral-50 transition-colors">
								<td class="px-4 py-4">
									<div class="font-medium text-neutral-900 font-mono">{ f.Key }</div>
									<div class="text-xs text-neutral-500 mt-0.5 font-sans">{ f.Name }</div>
								</td>
								<td class="px-4 py-4 font-mono text-neutral-800"><div class="flex items-center gap-2"><span class="rollbar" aria-hidden="true"><span :style={ fmt.Sprintf("'width: %.0f%%'", f.ProdPercentage()) }></span></span>{ fmt.Sprintf("%.0f%%", f.ProdPercentage()) }</div></td>
								<td class="px-4 py-4">
									<span class="font-mono text-xs text-neutral-600">{ f.ProdStrategy() }</span>
								</td>
								<td class="px-4 py-4 text-right">
									<button 
										data-key={ f.Key }
										@click="openEvaluatorForFlag($el)"
										class="text-accent-600 hover:underline flex items-center gap-1 justify-end ml-auto cursor-pointer lg:opacity-0 lg:group-hover:opacity-100 focus:opacity-100 transition-opacity"
									>
										<span>Test</span>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
