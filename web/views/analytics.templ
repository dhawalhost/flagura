package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ AnalyticsDashboard(flags []domain.FeatureFlag) {
	<div class="space-y-8" x-show="activeView === 'analytics'" x-cloak x-data="analyticsViewComponent()">
		<!-- Page Header -->
		<div class="console-card p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div>
				<div class="flex items-center gap-3 mb-1.5">
					<span class="p-2 rounded-xl bg-blue-50 text-blue-600 border border-blue-200">
						<i data-lucide="bar-chart-3" class="h-5 w-5"></i>
					</span>
					<h1 class="text-lg font-bold tracking-tight text-slate-900 font-display">
						Evaluation Analytics & Telemetry
					</h1>
					<span 
						class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase border"
						:class="{
							'text-emerald-700 bg-emerald-50 border-emerald-200': currentEnv === 'production',
							'text-amber-700 bg-amber-50 border-amber-200': currentEnv === 'staging',
							'text-blue-700 bg-blue-50 border-blue-200': currentEnv === 'development'
						}"
						x-text="currentEnv"
					></span>
				</div>
				<p class="text-xs text-slate-600">
					Real-time evaluation throughput, peak load patterns, and traffic distribution over the trailing 24 hours.
				</p>
			</div>

			<!-- Global actions -->
			<div class="flex items-center gap-2.5">
				<button
					@click="activeView = 'flags'"
					class="px-3.5 py-2 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 shadow-2xs transition-all cursor-pointer flex items-center gap-1.5"
				>
					<i data-lucide="sliders" class="h-3.5 w-3.5 text-slate-500"></i>
					<span>Manage Flags</span>
				</button>
				<button
					@click="activeView = 'evaluator'"
					class="px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-xs font-semibold text-white shadow-md shadow-blue-600/25 transition-all cursor-pointer flex items-center gap-1.5"
				>
					<i data-lucide="zap" class="h-3.5 w-3.5"></i>
					<span>Live Sandbox</span>
				</button>
			</div>
		</div>

		<!-- KPI Metric Summary Cards -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
			<!-- Total 24h Volume -->
			<div class="console-card p-6 space-y-2.5">
				<div class="flex items-center justify-between text-xs font-medium text-slate-500">
					<span class="font-mono uppercase text-xs font-bold">24h Evaluations</span>
					<i data-lucide="activity" class="h-4 w-4 text-blue-600"></i>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-3xl font-extrabold font-mono tracking-tight text-slate-900">
						2.8M
					</span>
					<span class="text-xs font-mono text-slate-500">
						(2,841,920 reqs)
					</span>
				</div>
				<div class="flex items-center gap-1.5 text-xs font-mono">
					<span class="font-bold text-emerald-700 inline-flex items-center">
						<i data-lucide="trending-up" class="h-3.5 w-3.5 mr-0.5 inline"></i>
						+18.4%
					</span>
					<span class="text-slate-500">vs previous 12h window</span>
				</div>
			</div>

			<!-- Edge Decision Latency -->
			<div class="console-card p-6 space-y-2.5">
				<div class="flex items-center justify-between text-xs font-medium text-slate-500">
					<span class="font-mono uppercase text-xs font-bold">P99 Evaluation</span>
					<i data-lucide="clock" class="h-4 w-4 text-emerald-600"></i>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-3xl font-extrabold font-mono tracking-tight text-slate-900">
						0.08<span class="text-sm font-normal text-slate-500">ms</span>
					</span>
					<span class="px-2 py-0.5 rounded-md text-[10px] font-mono font-bold bg-emerald-50 border border-emerald-200 text-emerald-700">
						In-Memory
					</span>
				</div>
				<div class="text-xs font-mono text-slate-500">
					Local thread cache & zero network hops
				</div>
			</div>

			<!-- Edge Cache Hit Rate -->
			<div class="console-card p-6 space-y-2.5">
				<div class="flex items-center justify-between text-xs font-medium text-slate-500">
					<span class="font-mono uppercase text-xs font-bold">Cache Hit Ratio</span>
					<i data-lucide="shield-check" class="h-4 w-4 text-purple-600"></i>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-3xl font-extrabold font-mono tracking-tight text-slate-900">
						99.94%
					</span>
					<span class="text-xs font-mono text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded">
						Optimal
					</span>
				</div>
				<div class="text-xs font-mono text-slate-500">
					Rules compiled into atomic state bitmaps
				</div>
			</div>

			<!-- Active Canary Rollouts -->
			<div class="console-card p-6 space-y-2.5">
				<div class="flex items-center justify-between text-xs font-medium text-slate-500">
					<span class="font-mono uppercase text-xs font-bold">Canary Splits</span>
					<i data-lucide="sliders" class="h-4 w-4 text-amber-600"></i>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-3xl font-extrabold font-mono tracking-tight text-slate-900">
						4
					</span>
					<span class="text-xs font-mono text-slate-500">
						Sticky Gradual Rollouts
					</span>
				</div>
				<div class="text-xs font-mono text-slate-500">
					Dynamic traffic balancing active
				</div>
			</div>
		</div>

		<!-- 24-Hour Evaluation Volume Hourly Chart -->
		<div class="console-card p-6 sm:p-7 space-y-5">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
				<div>
					<div class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">24-Hour Evaluation Throughput</div>
					<div class="text-xs text-slate-500 mt-0.5">Hourly request distribution across edge POP nodes</div>
				</div>
				<div class="flex items-center gap-2">
					<select 
						x-model="selectedAnalyticsFlag" 
						@change="updateAnalyticsChart()"
						class="input-clean font-mono text-xs"
					>
						<option value="all">All Fleet Flags Aggregate</option>
						for _, f := range flags {
							<option value={ f.Key }>{ f.Key } ({ f.Name })</option>
						}
					</select>
				</div>
			</div>

			<div class="h-64 w-full">
				<canvas id="analyticsChartCanvas"></canvas>
			</div>
		</div>

		<!-- Per-Flag Performance Breakdown Table -->
		<div class="console-card p-6 sm:p-7 space-y-5">
			<div class="flex items-center justify-between border-b border-slate-100 pb-4">
				<span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Flag Performance & 24h Metrics</span>
				<span class="text-xs font-mono text-slate-500">Environment: <strong class="uppercase text-slate-900" x-text="currentEnv"></strong></span>
			</div>

			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs font-mono">
					<thead class="bg-slate-50 text-slate-500 text-[10px] uppercase border-b border-slate-200">
						<tr>
							<th class="px-4 py-3 font-bold">Flag Key & Name</th>
							<th class="px-4 py-3 font-bold">24h Evals</th>
							<th class="px-4 py-3 font-bold">Rollout</th>
							<th class="px-4 py-3 font-bold">Strategy</th>
							<th class="px-4 py-3 font-bold">P99 Latency</th>
							<th class="px-4 py-3 text-right font-bold">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 font-sans">
						for _, f := range flags {
							<tr class="hover:bg-slate-50/70 transition">
								<td class="px-4 py-3.5">
									<div class="font-bold text-slate-900 font-mono">{ f.Key }</div>
									<div class="text-xs text-slate-500 mt-0.5">{ f.Name }</div>
								</td>
								<td class="px-4 py-3.5 text-blue-700 font-bold font-mono">482,100</td>
								<td class="px-4 py-3.5 font-mono">{ fmt.Sprintf("%.0f%%", f.ProdPercentage()) }</td>
								<td class="px-4 py-3.5">
									<span class="px-2 py-0.5 rounded bg-purple-50 text-purple-700 font-semibold border border-purple-200 text-[10px] uppercase font-mono">
										{ f.ProdStrategy() }
									</span>
								</td>
								<td class="px-4 py-3.5 text-emerald-700 font-bold font-mono">&lt; 0.08 ms</td>
								<td class="px-4 py-3.5 text-right">
									<button 
										@click={ fmt.Sprintf("openEvaluatorForFlag('%s');", f.Key) }
										class="text-blue-600 hover:underline font-semibold flex items-center gap-1 justify-end ml-auto cursor-pointer"
									>
										<span>Test in Sandbox</span>
										<i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
