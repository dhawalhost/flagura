package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ FlagMatrix(flags []domain.FeatureFlag) {
	<div class="space-y-5" x-show="activeView === 'flags'" x-cloak x-data="flagMatrixEnterpriseComponent()">
		
		<!-- Enterprise Filter & Actions Toolbar -->
		<div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs space-y-3 font-mono">
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
				<!-- Left: Search & Filter Inputs -->
				<div class="flex flex-wrap items-center gap-2.5 flex-1">
					<!-- Search Input -->
					<div class="relative w-full sm:w-72">
						<i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
						<input
							type="text"
							x-model="searchQuery"
							placeholder="Filter flags by key, name, or #tag..."
							class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-1.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:bg-white transition-colors"
						/>
					</div>

					<!-- Environment Filter Dropdown -->
					<select
						x-model="envFilter"
						class="bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-indigo-500 transition-colors"
					>
						<option value="all">All Environments</option>
						<option value="prod_enabled">Live in Production</option>
						<option value="prod_disabled">Off in Production</option>
						<option value="canary">Canary Rollouts</option>
					</select>

					<!-- Tag Filter Dropdown -->
					<select
						x-model="selectedTag"
						class="bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-indigo-500 transition-colors"
					>
						<option value="all">All Tags</option>
						<option value="core-ai">#core-ai</option>
						<option value="billing">#billing</option>
						<option value="infra">#infra</option>
						<option value="ui">#ui</option>
					</select>

					<!-- Health Filter -->
					<select
						x-model="healthFilter"
						class="bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-indigo-500 transition-colors"
					>
						<option value="all">All Health States</option>
						<option value="stale">Stale (100% Launched)</option>
						<option value="healthy">Active / Healthy</option>
					</select>
				</div>

				<!-- Right: Actions -->
				<div class="flex items-center gap-2">
					<span class="text-xs text-slate-500 pr-2 border-r border-slate-200">
						{ fmt.Sprintf("%d Flags", len(flags)) }
					</span>
					<button
						@click="openNewFlagEditor()"
						class="px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold flex items-center gap-1.5 shadow-xs transition cursor-pointer"
					>
						<i data-lucide="plus" class="h-3.5 w-3.5 text-white"></i>
						<span>Create Flag</span>
					</button>
				</div>
			</div>

			<!-- Floating Bulk Actions Bar (Appears when 1+ rows selected) -->
			<div 
				x-show="selectedFlags.length > 0" 
				x-transition
				class="p-2.5 bg-indigo-50 border border-indigo-200 rounded-lg flex flex-wrap items-center justify-between gap-3 text-xs"
			>
				<div class="flex items-center gap-2">
					<span class="font-bold text-indigo-900" x-text="selectedFlags.length + ' flags selected'"></span>
					<button @click="selectedFlags = []" class="text-indigo-600 hover:underline cursor-pointer">Clear</button>
				</div>
				<div class="flex items-center gap-2">
					<button 
						@click="bulkToggleEnv('production', true)" 
						class="px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-[11px] font-bold cursor-pointer"
					>
						Enable in Prod
					</button>
					<button 
						@click="bulkToggleEnv('production', false)" 
						class="px-2.5 py-1 rounded bg-red-600 hover:bg-red-700 text-white text-[11px] font-bold cursor-pointer"
					>
						Disable in Prod
					</button>
					<button 
						@click="bulkDelete()" 
						class="px-2.5 py-1 rounded bg-white hover:bg-red-50 text-red-600 border border-red-200 text-[11px] font-bold cursor-pointer"
					>
						Delete Selected
					</button>
				</div>
			</div>
		</div>

		<!-- High-Density Multi-Environment Data Table -->
		<div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs border-collapse">
					<thead class="bg-slate-50 border-b border-slate-200 font-mono text-[11px] uppercase text-slate-500 font-semibold tracking-wider">
						<tr>
							<th class="py-3 px-3 w-8 text-center">
								<input 
									type="checkbox" 
									@change="toggleSelectAll($event.target.checked)"
									class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" 
								/>
							</th>
							<th class="py-3 px-4 min-w-[220px]">Flag Key &amp; Name</th>
							<th class="py-3 px-3 min-w-[140px]">Development</th>
							<th class="py-3 px-3 min-w-[140px]">Staging</th>
							<th class="py-3 px-3 min-w-[160px]">Production</th>
							<th class="py-3 px-3">Type &amp; Tags</th>
							<th class="py-3 px-3">Health</th>
							<th class="py-3 px-3 text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 font-mono">
						for _, f := range flags {
							<tr 
								id={ "flag-row-" + f.Key }
								x-data={ fmt.Sprintf("{ envs: %s, copied: false, get isDev() { return (this.envs && this.envs.development && this.envs.development.enabled) || false; }, get isStg() { return (this.envs && this.envs.staging && this.envs.staging.enabled) || false; }, get isProd() { return (this.envs && this.envs.production && this.envs.production.enabled) || false; }, get prodPct() { return (this.envs && this.envs.production && this.envs.production.percentage !== undefined ? this.envs.production.percentage : 0); }, get devPct() { return (this.envs && this.envs.development && this.envs.development.percentage !== undefined ? this.envs.development.percentage : 0); }, get stgPct() { return (this.envs && this.envs.staging && this.envs.staging.percentage !== undefined ? this.envs.staging.percentage : 0); } }", f.EnvironmentsJSON()) }
								x-show={ fmt.Sprintf("matchesEnterpriseFilter('%s', '%s', '%s', isProd, prodPct)", f.Key, f.Name, f.Tags) }
								class="hover:bg-slate-50/80 transition-colors"
							>
								<!-- Checkbox -->
								<td class="py-3 px-3 text-center">
									<input 
										type="checkbox" 
										value={ f.Key }
										x-model="selectedFlags"
										class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" 
									/>
								</td>

								<!-- Flag Key & Identity -->
								<td class="py-3 px-4 min-w-[220px]">
									<div class="flex items-center gap-1.5">
										<button
											@click="navigator.clipboard.writeText('{ f.Key }'); copied = true; setTimeout(() => copied = false, 1500);"
											class="font-mono font-bold text-slate-900 hover:text-indigo-600 transition flex items-center gap-1 text-xs cursor-pointer group"
											title="Copy flag key"
										>
											<span>{ f.Key }</span>
											<i data-lucide="check" class="h-3 w-3 text-emerald-600" x-show="copied"></i>
											<i data-lucide="copy" class="h-3 w-3 text-slate-300 group-hover:text-slate-600" x-show="!copied"></i>
										</button>
									</div>
									<div class="text-[11px] text-slate-500 font-sans truncate max-w-xs mt-0.5">{ f.Name }</div>
								</td>

								<!-- Development Environment Column -->
								<td class="py-3 px-3 min-w-[140px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop={ fmt.Sprintf("const next = !isDev; if (!envs.development) envs.development = {}; envs.development.enabled = next; toggleFlagEnvStatus('%s', 'development', next);", f.Key) }
											class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isDev ? 'bg-emerald-600' : 'bg-slate-200'"
											title="Toggle Development"
										>
											<span 
												class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
												:class="isDev ? 'translate-x-3' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-[10px] font-bold px-1.5 py-0.2 rounded"
											:class="isDev ? 'text-emerald-700 bg-emerald-50' : 'text-slate-400 bg-slate-100'"
											x-text="isDev ? (devPct < 100 ? devPct + '%' : 'ON') : 'OFF'"
										></span>
									</div>
								</td>

								<!-- Staging Environment Column -->
								<td class="py-3 px-3 min-w-[140px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop={ fmt.Sprintf("const next = !isStg; if (!envs.staging) envs.staging = {}; envs.staging.enabled = next; toggleFlagEnvStatus('%s', 'staging', next);", f.Key) }
											class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isStg ? 'bg-amber-500' : 'bg-slate-200'"
											title="Toggle Staging"
										>
											<span 
												class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
												:class="isStg ? 'translate-x-3' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-[10px] font-bold px-1.5 py-0.2 rounded"
											:class="isStg ? 'text-amber-700 bg-amber-50' : 'text-slate-400 bg-slate-100'"
											x-text="isStg ? (stgPct < 100 ? stgPct + '%' : 'ON') : 'OFF'"
										></span>
									</div>
								</td>

								<!-- Production Environment Column -->
								<td class="py-3 px-3 min-w-[160px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop={ fmt.Sprintf("const next = !isProd; if (!envs.production) envs.production = {}; envs.production.enabled = next; toggleFlagEnvStatus('%s', 'production', next);", f.Key) }
											class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isProd ? 'bg-emerald-600' : 'bg-red-500'"
											title="Toggle Production Kill Switch"
										>
											<span 
												class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
												:class="isProd ? 'translate-x-4' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-[11px] font-bold px-2 py-0.5 rounded border"
											:class="isProd ? (prodPct < 100 ? 'text-sky-700 bg-sky-50 border-sky-200' : 'text-emerald-700 bg-emerald-50 border-emerald-200') : 'text-red-700 bg-red-50 border-red-200'"
											x-text="isProd ? (prodPct < 100 ? 'Canary ' + prodPct + '%' : 'Live 100%') : 'Circuit Off'"
										></span>
									</div>
								</td>

								<!-- Type & Tags -->
								<td class="py-3 px-3">
									<div class="flex items-center gap-1.5 flex-wrap">
										<span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[10px] uppercase font-bold border border-slate-200">
											{ f.Type }
										</span>
										for _, tag := range f.Tags {
											<span class="text-[10px] text-slate-500 bg-slate-50 px-1 rounded border border-slate-200">
												#{ tag }
											</span>
										}
									</div>
								</td>

								<!-- Health Alert Column -->
								<td class="py-3 px-3">
									if report := domain.AnalyzeFlagHealth(f); report.Status == domain.HealthStatusStale {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-700 text-[10px] font-bold" title={ report.SuggestedAction }>
											<i data-lucide="sparkles" class="h-3 w-3 text-amber-600"></i>
											<span>Stale</span>
										</span>
									} else {
										<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-bold">
											<i data-lucide="check" class="h-3 w-3 text-emerald-600"></i>
											<span>Active</span>
										</span>
									}
								</td>

								<!-- Row Quick Actions -->
								<td class="py-3 px-3 text-right">
									<div class="flex items-center justify-end gap-1 font-sans">
										<button
											@click={ fmt.Sprintf("openEditFlagEditor('%s');", f.Key) }
											class="p-1.5 text-slate-500 hover:text-indigo-600 hover:bg-slate-100 rounded-lg transition cursor-pointer"
											title="Edit targeting rules"
										>
											<i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
										</button>
										<button
											@click={ fmt.Sprintf("openExperimentModal('%s');", f.Key) }
											class="p-1.5 text-slate-500 hover:text-purple-600 hover:bg-slate-100 rounded-lg transition cursor-pointer"
											title="A/B Experiment Stats"
										>
											<i data-lucide="flask-conical" class="h-3.5 w-3.5"></i>
										</button>
										<button
											@click={ fmt.Sprintf("deleteFlagRow('%s');", f.Key) }
											class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition cursor-pointer"
											title="Delete flag"
										>
											<i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			if len(flags) == 0 {
				<div class="p-12 text-center space-y-3">
					<div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center mx-auto">
						<i data-lucide="flag" class="w-5 h-5"></i>
					</div>
					<div class="space-y-1">
						<h3 class="text-sm font-bold text-slate-900 font-display">No Feature Flags Configured</h3>
						<p class="text-xs text-slate-500 max-w-sm mx-auto font-sans">Create your first flag to start toggling features and controlling rollouts.</p>
					</div>
					<button
						@click="openNewFlagEditor()"
						class="px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold inline-flex items-center gap-1.5 shadow-xs cursor-pointer font-mono"
					>
						<i data-lucide="plus" class="h-3.5 w-3.5 text-white"></i>
						<span>Create Feature Flag</span>
					</button>
				</div>
			}
		</div>
	</div>
}
