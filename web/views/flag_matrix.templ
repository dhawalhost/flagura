package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ FlagMatrix(flags []domain.FeatureFlag) {
	<div class="space-y-5" x-show="activeView === 'flags'" x-cloak x-data="flagMatrixEnterpriseComponent()">
		
		<!-- Filters -->
		<div class="flex flex-wrap items-center gap-2">
			<div class="relative w-full sm:w-64">
				<i data-lucide="search" class="w-3.5 h-3.5 text-neutral-400 absolute left-2.5 top-1/2 -translate-y-1/2"></i>
				<input type="text" x-model="searchQuery" placeholder="Filter by key, name or #tag" aria-label="Filter flags" class="field !pl-8"/>
			</div>
			<select aria-label="Filter by rollout state" x-model="envFilter"
						class="field w-auto"
					>
						<option value="all">All Environments</option>
						<option value="prod_enabled">Live in Production</option>
						<option value="prod_disabled">Off in Production</option>
						<option value="canary">Canary Rollouts</option>
					</select>
			<select aria-label="Filter by tag" x-model="selectedTag"
						class="field w-auto"
					>
						<option value="all">All Tags</option>
						<option value="core-ai">#core-ai</option>
						<option value="billing">#billing</option>
						<option value="infra">#infra</option>
						<option value="ui">#ui</option>
					</select>
			<select aria-label="Filter by health" x-model="healthFilter"
						class="field w-auto"
					>
						<option value="all">All Health States</option>
						<option value="stale">Stale (100% Launched)</option>
						<option value="dead">Dead (0% / Disabled)</option>
						<option value="active">Active / Healthy</option>
					</select>
			<span class="ml-auto font-mono text-xs text-neutral-500">{ fmt.Sprintf("%d flags", len(flags)) }</span>
		</div>

		<!-- Bulk Actions -->
		<div x-show="selectedFlags.length > 0" class="panel shadow-pop sticky bottom-4 z-20 px-3 py-2 flex flex-wrap items-center justify-between gap-2">
			<div class="flex items-center gap-3 text-sm">
				<span class="text-neutral-900" x-text="selectedFlags.length + ' selected'"></span>
				<button @click="selectedFlags = []" class="text-xs text-accent-600 hover:underline cursor-pointer">Clear</button>
			</div>
			<div class="flex items-center gap-2">
				<button @click="bulkToggleEnv('production', true)" class="btn">Enable in production</button>
				<button @click="bulkToggleEnv('production', false)" class="btn">Disable in production</button>
				<button @click="bulkDelete()" class="btn text-danger-600">Delete</button>
			</div>
		</div>

		<p x-show="noMatches" class="text-sm text-neutral-500">No flags match these filters</p>

		<div class="panel overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs border-collapse">
					<thead class="border-b border-neutral-200 text-xs text-neutral-500">
						<tr>
							<th class="sticky left-0 z-10 bg-surface py-2 px-3 min-w-[190px] font-normal">
								<label class="flex items-center gap-2 font-normal cursor-pointer">
									<input type="checkbox" @change="toggleSelectAll($event.target.checked)" aria-label="Select all flags" class="cursor-pointer"/>
									<span>Flag</span>
								</label>
							</th>
							<th class="py-2 px-3 min-w-[132px] font-normal" :class="currentEnv === 'development' ? 'text-neutral-900 font-medium' : ''">Development</th>
							<th class="py-2 px-3 min-w-[132px] font-normal" :class="currentEnv === 'staging' ? 'text-neutral-900 font-medium' : ''">Staging</th>
							<th class="py-2 px-3 min-w-[132px] font-normal" :class="currentEnv === 'production' ? 'text-neutral-900 font-medium' : ''">Production</th>
							<th class="py-2 px-3 font-normal">Tags</th>
							<th class="py-2 px-3 font-normal">Health</th>
							<th class="py-2 px-3 font-normal" aria-label="Actions"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-neutral-100">
						for _, f := range flags {
							<tr 
								id={ "flag-row-" + f.Key }
								x-data="flagRowComponent()"
								data-key={ f.Key }
								data-name={ f.Name }
								data-tags={ f.Tags }
								data-health={ domain.AnalyzeFlagHealth(f).Status }
								data-envs={ f.EnvironmentsJSON() }
								x-show="matchesRow($el, isProd, prodPct)"
								class="group hover:bg-neutral-50 transition-colors"
							>
								<!-- Flag Identity -->
								<td class="sticky left-0 z-10 bg-surface group-hover:bg-neutral-50 transition-colors py-2 px-3 min-w-[190px]">
									<div class="flex items-center gap-2">
										<input type="checkbox" value={ f.Key } x-model="selectedFlags" aria-label={ "Select " + f.Key } class="cursor-pointer"/>
										<div class="min-w-0">
											<button @click="copyKey" class="font-mono text-sm text-neutral-900 hover:text-accent-600 transition-colors flex items-center gap-1 cursor-pointer" title="Copy flag key">
												<span>{ f.Key }</span>
												<span x-show="copied" class="inline-flex"><i data-lucide="check" class="h-3 w-3 text-ok-600"></i></span>
											</button>
											<div class="text-xs text-neutral-500 truncate max-w-[150px] sm:max-w-xs">{ f.Name }</div>
										</div>
									</div>
								</td>

								<!-- Development Environment Column -->
								<td class="py-2 px-3">
									<div class="flex items-center gap-2">
										@Switch(f.Key+" in development", "isDev", "devPct", "isBusy('development')", "toggleDev")
										<span 
											class="font-mono text-2xs"
											:class="isDev ? 'text-ok-700' : 'text-neutral-500'"
											x-text="isDev ? (devPct < 100 ? devPct + '%' : 'on') : 'off'"
										></span>
									</div>
								</td>

								<!-- Staging Environment Column -->
								<td class="py-2 px-3">
									<div class="flex items-center gap-2">
										@Switch(f.Key+" in staging", "isStg", "stgPct", "isBusy('staging')", "toggleStg")
										<span 
											class="font-mono text-2xs"
											:class="isStg ? 'text-ok-700' : 'text-neutral-500'"
											x-text="isStg ? (stgPct < 100 ? stgPct + '%' : 'on') : 'off'"
										></span>
									</div>
								</td>

								<!-- Production Environment Column -->
								<td class="py-2 px-3">
									<div class="flex items-center gap-2">
										@Switch(f.Key+" in production", "isProd", "prodPct", "isBusy('production')", "toggleProd")
										<span 
											class="font-mono text-2xs font-medium"
											:class="isProd ? (prodPct < 100 ? 'text-warn-700' : 'text-ok-700') : 'text-neutral-500'"
											x-text="isProd ? (prodPct < 100 ? prodPct + '%' : 'on') : 'off'"
										></span>
									</div>
								</td>

								<!-- Type & Tags -->
								<td class="py-2 px-3 font-mono text-2xs text-neutral-500 whitespace-nowrap">
									for _, tag := range f.Tags {
										<span class="mr-1.5">#{ tag }</span>
									}
								</td>

								<!-- Health Alert Column -->
								<td class="py-2 px-3">
									if report := domain.AnalyzeFlagHealth(f); report.Status == domain.HealthStatusStale {
										<button
											type="button"
											data-health-key={ f.Key }
											data-health-name={ f.Name }
											data-health-status={ report.Status }
											data-health-reason={ report.Reason }
											data-health-action={ report.SuggestedAction }
											@click="openHygiene($el)"
											class="text-xs text-warn-700 hover:underline whitespace-nowrap cursor-pointer"
											title="100% launched in production. Click for automated cleanup guide."
										>
										Ready for cleanup
										</button>
									} else if report.Status == domain.HealthStatusDead {
										<button
											type="button"
											data-health-key={ f.Key }
											data-health-name={ f.Name }
											data-health-status={ report.Status }
											data-health-reason={ report.Reason }
											data-health-action={ report.SuggestedAction }
											@click="openHygiene($el)"
											class="text-xs text-danger-700 hover:underline whitespace-nowrap cursor-pointer"
											title="Kill-switched / 0% traffic. Click for cleanup guide."
										>
										Dead flag
										</button>
									}
								</td>

								<!-- Row Quick Actions -->
								<td class="py-2 px-3 text-right">
									<div class="flex items-center justify-end gap-0.5 lg:opacity-0 lg:group-hover:opacity-100 lg:focus-within:opacity-100 transition-opacity">
										<button
											data-key={ f.Key }
											@click="openEditFlag($el)"
											class="p-1.5 text-neutral-500 hover:text-accent-600 hover:bg-neutral-100 rounded transition cursor-pointer"
											title="Edit targeting rules"
										>
											<i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
										</button>
										<button
											data-key={ f.Key }
											@click="openExperiment($el)"
											class="p-1.5 text-neutral-500 hover:text-accent-600 hover:bg-neutral-100 rounded transition cursor-pointer"
											title="A/B Experiment Stats"
										>
											<i data-lucide="flask-conical" class="h-3.5 w-3.5"></i>
										</button>
										<button
											data-key={ f.Key }
											@click="deleteFlag($el)"
											class="p-1.5 text-neutral-400 hover:text-danger-600 hover:bg-danger-50 rounded transition cursor-pointer"
											title="Delete flag"
										>
											<i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			if len(flags) == 0 {
				<div class="p-12 text-center space-y-3">
					<div class="space-y-1">
						<h3 class="text-sm font-semibold text-neutral-900">No flags yet</h3>
						<p class="text-xs text-neutral-500 max-w-sm mx-auto font-sans">Create a flag to control a feature per environment</p>
					</div>
					<button
						@click="openNewFlagEditor()"
						class="btn btn-primary"
					>
						<span>Create flag</span>
					</button>
				</div>
			}
		</div>
	</div>
}
