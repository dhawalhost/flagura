package views

import (
	"github.com/dhawalhost/flagura/internal/domain"
	"fmt"
)

templ FlagMatrix(flags []domain.FeatureFlag) {
	<div class="space-y-6" x-show="activeView === 'flags'" x-data="flagMatrixViewComponent()">
		<!-- Header & Controls Frame -->
		<div class="console-card p-6 sm:p-7 space-y-5">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
				<div class="flex items-center gap-3">
					<span class="text-xs font-bold text-slate-500 uppercase tracking-wider font-mono">Feature Flag Directory</span>
					<span class="rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-xs font-mono text-blue-700 font-bold">
						{ fmt.Sprintf("%d of %d Flags", len(flags), len(flags)) }
					</span>
				</div>

				<div class="flex items-center gap-2">
					<button
						@click="openNewFlagEditor()"
						class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold flex items-center gap-1.5 shadow-md shadow-blue-600/25 cursor-pointer"
					>
						<i data-lucide="plus" class="h-3.5 w-3.5 stroke-[2.5]"></i>
						<span>Create Feature Flag</span>
					</button>
				</div>
			</div>

			<!-- Status Filters & Tags -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
				<!-- Status Filters -->
				<div class="flex flex-wrap items-center gap-2">
					<button
						@click="statusFilter = 'all'"
						class="rounded-xl px-3.5 py-1.5 text-xs font-medium transition-all cursor-pointer"
						:class="statusFilter === 'all' ? 'bg-slate-900 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'"
					>
						All ({ fmt.Sprintf("%d", len(flags)) })
					</button>
					<button
						@click="statusFilter = 'enabled'"
						class="rounded-xl px-3.5 py-1.5 text-xs font-medium transition-all cursor-pointer"
						:class="statusFilter === 'enabled' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'"
					>
						Enabled
					</button>
					<button
						@click="statusFilter = 'rollout'"
						class="rounded-xl px-3.5 py-1.5 text-xs font-medium transition-all cursor-pointer"
						:class="statusFilter === 'rollout' ? 'bg-slate-900 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'"
					>
						Gradual Rollout
					</button>
					<button
						@click="statusFilter = 'rules'"
						class="rounded-xl px-3.5 py-1.5 text-xs font-medium transition-all cursor-pointer"
						:class="statusFilter === 'rules' ? 'bg-slate-900 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'"
					>
						Targeting Rules
					</button>
					<button
						@click="statusFilter = 'disabled'"
						class="rounded-xl px-3.5 py-1.5 text-xs font-medium transition-all cursor-pointer"
						:class="statusFilter === 'disabled' ? 'bg-rose-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'"
					>
						Kill Switch Off
					</button>
				</div>

				<!-- Tag Filters -->
				<div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 text-xs">
					<span class="text-slate-500 font-semibold flex items-center gap-1">
						<i data-lucide="tag" class="h-3 w-3"></i> Tag:
					</span>
					<button
						@click="selectedTag = 'all'"
						class="rounded-lg px-2.5 py-1 text-xs transition-all cursor-pointer"
						:class="selectedTag === 'all' ? 'bg-slate-900 text-white font-semibold' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
					>
						all
					</button>
					<button
						@click="selectedTag = 'core-ai'"
						class="rounded-lg px-2.5 py-1 text-xs font-mono transition-all cursor-pointer"
						:class="selectedTag === 'core-ai' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
					>
						#core-ai
					</button>
					<button
						@click="selectedTag = 'billing'"
						class="rounded-lg px-2.5 py-1 text-xs font-mono transition-all cursor-pointer"
						:class="selectedTag === 'billing' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
					>
						#billing
					</button>
					<button
						@click="selectedTag = 'infra'"
						class="rounded-lg px-2.5 py-1 text-xs font-mono transition-all cursor-pointer"
						:class="selectedTag === 'infra' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
					>
						#infra
					</button>
					<button
						@click="selectedTag = 'ui'"
						class="rounded-lg px-2.5 py-1 text-xs font-mono transition-all cursor-pointer"
						:class="selectedTag === 'ui' ? 'bg-blue-600 text-white font-bold' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
					>
						#ui
					</button>
				</div>
			</div>
		</div>

		<!-- Flag Items List -->
		<div class="grid gap-4">
			for _, f := range flags {
				<div
					id={ "flag-card-" + f.Key }
					x-data={ fmt.Sprintf("{ enabled: %t, rollout: %g, copied: false }", f.IsProdEnabled(), f.ProdPercentage()) }
					x-show={ fmt.Sprintf("matchesFilter('%s', '%s', '%s', enabled, %d, '%s')", f.Key, f.Name, f.Tags, f.ProdRulesCount(), f.ProdStrategy()) }
					class="console-card p-6 transition-all"
					:class="enabled ? 'border-slate-200' : 'border-rose-200 bg-rose-50/20'"
				>
					<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
						<!-- Left: Flag Meta -->
						<div class="flex-1 space-y-2.5 min-w-0">
							<div class="flex flex-wrap items-center gap-2.5">
								<!-- Live State Pill -->
								<span
									class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-mono font-bold tracking-tight border shadow-2xs transition-colors"
									:class="enabled ? 'bg-emerald-50 border-emerald-200 text-emerald-700' : 'bg-rose-50 border-rose-200 text-rose-700'"
								>
									<span class="relative flex h-2 w-2">
										<template x-if="enabled">
											<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
										</template>
										<span class="relative inline-flex rounded-full h-2 w-2" :class="enabled ? 'bg-emerald-500' : 'bg-rose-500'"></span>
									</span>
									<span x-text="enabled ? 'LIVE' : 'INACTIVE'"></span>
								</span>

								<!-- Type Badge -->
								<span class="rounded-md px-2 py-0.5 text-[10px] font-mono font-medium uppercase bg-slate-100 text-slate-700 border border-slate-200">
									{ f.Type }
								</span>

								<!-- Flag Key with Copy -->
								<button
									@click="navigator.clipboard.writeText('{ f.Key }'); copied = true; setTimeout(() => copied = false, 1800);"
									class="flex items-center gap-1.5 rounded-lg bg-slate-50 px-2.5 py-0.5 font-mono text-xs font-semibold text-slate-900 hover:text-blue-600 border border-slate-200 shadow-2xs transition-colors cursor-pointer"
									title="Click to copy flag key"
								>
									<span>{ f.Key }</span>
									<i data-lucide="check" class="h-3 w-3 text-emerald-600" x-show="copied"></i>
									<i data-lucide="copy" class="h-3 w-3 text-slate-400" x-show="!copied"></i>
								</button>

								<!-- Title -->
								<span class="text-sm font-bold text-slate-900 truncate">{ f.Name }</span>
							</div>

							<!-- Description -->
							<p class="text-xs text-slate-600 line-clamp-1">{ f.Description }</p>

							<!-- Tags & Rules Indicators -->
							<div class="flex flex-wrap items-center gap-2 pt-0.5">
								for _, tag := range f.Tags {
									<span class="rounded-full bg-slate-50 border border-slate-200 px-2.5 py-0.5 text-[11px] font-mono text-slate-600">
										#{ tag }
									</span>
								}

								if f.ProdRulesCount() > 0 {
									<span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-[11px] font-mono text-blue-700 font-medium">
										<i data-lucide="users" class="h-3 w-3"></i>
										{ fmt.Sprintf("%d rules active", f.ProdRulesCount()) }
									</span>
								}

								<span class="rounded-full bg-slate-50 border border-slate-200 px-2.5 py-0.5 text-[10px] font-mono text-slate-600 capitalize">
									strategy: { f.ProdStrategy() }
								</span>
							</div>
						</div>

						<!-- Right: Controls -->
						<div class="flex flex-wrap items-center gap-3.5 border-t lg:border-t-0 border-slate-100 pt-3 lg:pt-0">
							<!-- Rollout Slider -->
							<template x-if="enabled">
								<div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2 shadow-2xs">
									<i data-lucide="percent" class="h-3.5 w-3.5 text-blue-600"></i>
									<div class="space-y-1">
										<div class="flex items-center justify-between text-[11px] font-mono">
											<span class="text-slate-500">Rollout</span>
											<span class="font-bold text-slate-900" x-text="rollout + '%'"></span>
										</div>
										<input
											type="range"
											min="0"
											max="100"
											step="5"
											x-model="rollout"
											@input={ fmt.Sprintf("updateRollout('%s', $event.target.value)", f.Key) }
											class="w-28 accent-blue-600 cursor-pointer"
										/>
									</div>
								</div>
							</template>

							<!-- Kill Switch Toggle Button -->
							<button
								@click={ fmt.Sprintf("enabled = !enabled; toggleFlagStatus('%s', enabled);", f.Key) }
								class="flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs font-mono font-bold transition-all shadow-2xs cursor-pointer"
								:class="enabled ? 'bg-slate-900 text-white hover:bg-slate-800' : 'bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100'"
							>
								<i data-lucide="power" class="h-3.5 w-3.5" :class="enabled ? 'text-emerald-400' : 'text-rose-600'"></i>
								<span x-text="enabled ? 'ENABLED' : 'KILL SWITCH OFF'"></span>
							</button>

							<!-- Action Buttons -->
							<div class="flex items-center gap-1.5">
								<!-- Test in Sandbox -->
								<button
									@click={ fmt.Sprintf("openEvaluatorForFlag('%s');", f.Key) }
									class="p-2.5 h-9 w-9 flex items-center justify-center text-slate-700 hover:bg-slate-100 rounded-xl border border-slate-200 bg-white transition cursor-pointer"
									title="Evaluate this flag with live user context"
								>
									<i data-lucide="play" class="h-3.5 w-3.5 fill-blue-600 text-blue-600"></i>
								</button>

								<!-- Edit Flag -->
								<button
									@click={ fmt.Sprintf("openEditFlagEditor('%s', '%s', '%s', '%s', '%s');", f.ID, f.Key, f.Name, f.Description, f.Type) }
									class="p-2.5 h-9 w-9 flex items-center justify-center text-slate-700 hover:bg-slate-100 rounded-xl border border-slate-200 bg-white transition cursor-pointer"
									title="Edit targeting rules & config"
								>
									<i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
								</button>

								<!-- Delete Flag -->
								<button
									@click={ fmt.Sprintf("deleteFlagRow('%s');", f.Key) }
									class="p-2.5 h-9 w-9 flex items-center justify-center text-rose-600 hover:bg-rose-50 rounded-xl border border-rose-200 bg-white transition cursor-pointer"
									title="Delete flag"
								>
									<i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
								</button>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}
