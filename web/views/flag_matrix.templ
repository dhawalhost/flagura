package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ FlagMatrix(flags []domain.FeatureFlag) {
	<div class="space-y-5" x-show="activeView === 'flags'" x-cloak x-data="flagMatrixEnterpriseComponent()">
		
		<!-- Filter & Actions Toolbar -->
		<div class="bg-surface p-4 rounded-md border border-neutral-200 space-y-3 font-mono">
			<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
				<!-- Left: Search & Filter Inputs -->
				<div class="flex flex-wrap items-center gap-2.5 flex-1">
					<!-- Search Input -->
					<div class="relative w-full sm:w-72">
						<i data-lucide="search" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
						<input
							type="text"
							x-model="searchQuery"
							placeholder="Filter flags by key, name, or #tag..."
							class="w-full bg-neutral-50 border border-neutral-200 rounded pl-9 pr-3 py-1.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 focus:bg-surface transition-colors"
						/>
					</div>

					<!-- Environment Filter Dropdown -->
					<select
						x-model="envFilter"
						class="bg-neutral-50 border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-700 focus:outline-none focus:border-accent-500 transition-colors"
					>
						<option value="all">All Environments</option>
						<option value="prod_enabled">Live in Production</option>
						<option value="prod_disabled">Off in Production</option>
						<option value="canary">Canary Rollouts</option>
					</select>

					<!-- Tag Filter Dropdown -->
					<select
						x-model="selectedTag"
						class="bg-neutral-50 border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-700 focus:outline-none focus:border-accent-500 transition-colors"
					>
						<option value="all">All Tags</option>
						<option value="core-ai">#core-ai</option>
						<option value="billing">#billing</option>
						<option value="infra">#infra</option>
						<option value="ui">#ui</option>
					</select>

					<!-- Health Filter -->
					<select
						x-model="healthFilter"
						class="bg-neutral-50 border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-700 focus:outline-none focus:border-accent-500 transition-colors"
					>
						<option value="all">All Health States</option>
						<option value="stale">Stale (100% Launched)</option>
						<option value="dead">Dead (0% / Disabled)</option>
						<option value="active">Active / Healthy</option>
					</select>
				</div>

				<!-- Right: Actions -->
				<div class="flex items-center gap-2">
					<span class="text-xs text-neutral-500 pr-2 border-r border-neutral-200">
						{ fmt.Sprintf("%d Flags", len(flags)) }
					</span>
					<button
						@click="openNewFlagEditor()"
						class="px-3.5 py-1.5 rounded bg-accent-600 hover:bg-accent-700 text-surface text-xs font-medium flex items-center gap-1.5 transition cursor-pointer"
					>
						<i data-lucide="plus" class="h-3.5 w-3.5 text-surface"></i>
						<span>Create Flag</span>
					</button>
				</div>
			</div>

			<!-- Floating Bulk Actions Bar (Appears when 1+ rows selected) -->
			<div 
				x-show="selectedFlags.length > 0" 
				x-transition
				class="p-2.5 bg-accent-50 border border-accent-200 rounded flex flex-wrap items-center justify-between gap-3 text-xs"
			>
				<div class="flex items-center gap-2">
					<span class="font-medium text-accent-900" x-text="selectedFlags.length + ' flags selected'"></span>
					<button @click="selectedFlags = []" class="text-accent-600 hover:underline cursor-pointer">Clear</button>
				</div>
				<div class="flex items-center gap-2">
					<button 
						@click="bulkToggleEnv('production', true)" 
						class="px-2.5 py-1 rounded bg-ok-600 hover:bg-ok-700 text-surface text-2xs font-medium cursor-pointer"
					>
						Enable in Prod
					</button>
					<button 
						@click="bulkToggleEnv('production', false)" 
						class="px-2.5 py-1 rounded bg-danger-600 hover:bg-danger-700 text-surface text-2xs font-medium cursor-pointer"
					>
						Disable in Prod
					</button>
					<button 
						@click="bulkDelete()" 
						class="px-2.5 py-1 rounded bg-surface hover:bg-danger-50 text-danger-600 border border-danger-200 text-2xs font-medium cursor-pointer"
					>
						Delete Selected
					</button>
				</div>
			</div>
		</div>

		<!-- High-Density Multi-Environment Data Table -->
		<div class="bg-surface rounded-md border border-neutral-200 overflow-hidden">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs border-collapse">
					<thead class="bg-neutral-50 border-b border-neutral-200 text-2xs text-neutral-500 font-semibold">
						<tr>
							<th class="py-3 px-3 w-8 text-center">
								<input 
									type="checkbox" 
									@change="toggleSelectAll($event.target.checked)"
									class="rounded border-neutral-300 text-accent-600 focus:ring-accent-500 cursor-pointer" 
								/>
							</th>
							<th class="py-3 px-4 min-w-[220px]">Flag Key &amp; Name</th>
							<th class="py-3 px-3 min-w-[140px]">Development</th>
							<th class="py-3 px-3 min-w-[140px]">Staging</th>
							<th class="py-3 px-3 min-w-[160px]">Production</th>
							<th class="py-3 px-3">Type &amp; Tags</th>
							<th class="py-3 px-3">Health</th>
							<th class="py-3 px-3 text-right">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-neutral-100 font-mono">
						for _, f := range flags {
							<tr 
								id={ "flag-row-" + f.Key }
								x-data="flagRowComponent()"
								data-key={ f.Key }
								data-name={ f.Name }
								data-tags={ f.Tags }
								data-health={ domain.AnalyzeFlagHealth(f).Status }
								data-envs={ f.EnvironmentsJSON() }
								x-show="matchesRow($el, isProd, prodPct)"
								class="hover:bg-neutral-50/80 transition-colors"
							>
								<!-- Checkbox -->
								<td class="py-3 px-3 text-center">
									<input 
										type="checkbox" 
										value={ f.Key }
										x-model="selectedFlags"
										class="rounded border-neutral-300 text-accent-600 focus:ring-accent-500 cursor-pointer" 
									/>
								</td>

								<!-- Flag Key & Identity -->
								<td class="py-3 px-4 min-w-[220px]">
									<div class="flex items-center gap-1.5">
										<button
											@click="copyKey"
											class="font-medium text-neutral-900 hover:text-accent-600 transition flex items-center gap-1 text-xs cursor-pointer group"
											title="Copy flag key"
										>
											<span class="font-mono">{ f.Key }</span>
											<i data-lucide="check" class="h-3 w-3 text-ok-600" x-show="copied"></i>
											<i data-lucide="copy" class="h-3 w-3 text-neutral-300 group-hover:text-neutral-600" x-show="!copied"></i>
										</button>
									</div>
									<div class="text-2xs text-neutral-500 font-sans truncate max-w-xs mt-0.5">{ f.Name }</div>
								</td>

								<!-- Development Environment Column -->
								<td class="py-3 px-3 min-w-[140px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop="toggleDev"
											class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isDev ? 'bg-ok-600' : 'bg-neutral-200'"
											title="Toggle Development"
										>
											<span 
												class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-surface shadow ring-0 transition duration-200 ease-in-out"
												:class="isDev ? 'translate-x-3' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-2xs font-medium px-1.5 py-0.2 rounded"
											:class="isDev ? 'text-ok-700 bg-ok-50' : 'text-neutral-400 bg-neutral-100'"
											x-text="isDev ? (devPct < 100 ? devPct + '%' : 'ON') : 'OFF'"
										></span>
									</div>
								</td>

								<!-- Staging Environment Column -->
								<td class="py-3 px-3 min-w-[140px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop="toggleStg"
											class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isStg ? 'bg-ok-600' : 'bg-neutral-300'"
											title="Toggle Staging"
										>
											<span 
												class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-surface shadow ring-0 transition duration-200 ease-in-out"
												:class="isStg ? 'translate-x-3' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-2xs font-medium px-1.5 py-0.2 rounded"
											:class="isStg ? 'text-ok-700 bg-ok-50' : 'text-neutral-500 bg-neutral-100'"
											x-text="isStg ? (stgPct < 100 ? stgPct + '%' : 'ON') : 'OFF'"
										></span>
									</div>
								</td>

								<!-- Production Environment Column -->
								<td class="py-3 px-3 min-w-[160px]">
									<div class="flex items-center gap-2">
										<button
											@click.stop="toggleProd"
											class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
											:class="isProd ? 'bg-ok-600' : 'bg-neutral-300'"
											title="Toggle Production Kill Switch"
										>
											<span 
												class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-surface shadow ring-0 transition duration-200 ease-in-out"
												:class="isProd ? 'translate-x-4' : 'translate-x-0'"
											></span>
										</button>
										<span 
											class="text-2xs font-medium px-2 py-0.5 rounded border"
											:class="isProd ? (prodPct < 100 ? 'text-warn-700 bg-warn-50 border-warn-200' : 'text-ok-700 bg-ok-50 border-ok-200') : 'text-neutral-500 bg-neutral-100 border-neutral-200'"
											x-text="isProd ? (prodPct < 100 ? 'On, ' + prodPct + '%' : 'On') : 'Off'"
										></span>
									</div>
								</td>

								<!-- Type & Tags -->
								<td class="py-3 px-3">
									<div class="flex items-center gap-1.5 flex-wrap">
										<span class="px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-600 text-2xs font-medium border border-neutral-200">
											{ f.Type }
										</span>
										for _, tag := range f.Tags {
											<span class="text-2xs text-neutral-500 bg-neutral-50 px-1 rounded border border-neutral-200">
												#{ tag }
											</span>
										}
									</div>
								</td>

								<!-- Health Alert Column -->
								<td class="py-3 px-3">
									if report := domain.AnalyzeFlagHealth(f); report.Status == domain.HealthStatusStale {
										<button
											type="button"
											data-health-key={ f.Key }
											data-health-name={ f.Name }
											data-health-status={ report.Status }
											data-health-reason={ report.Reason }
											data-health-action={ report.SuggestedAction }
											@click="openHygiene($el)"
											class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-warn-50 hover:bg-warn-100 border border-warn-200 text-warn-800 text-2xs font-medium transition cursor-pointer group"
											title="100% launched in production. Click for automated cleanup guide."
										>
											<i data-lucide="sparkles" class="h-3 w-3 text-warn-600 transition-transform"></i>
											<span>Ready for Cleanup</span>
										</button>
									} else if report.Status == domain.HealthStatusDead {
										<button
											type="button"
											data-health-key={ f.Key }
											data-health-name={ f.Name }
											data-health-status={ report.Status }
											data-health-reason={ report.Reason }
											data-health-action={ report.SuggestedAction }
											@click="openHygiene($el)"
											class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-danger-50 hover:bg-danger-100 border border-danger-200 text-danger-800 text-2xs font-medium transition cursor-pointer group"
											title="Kill-switched / 0% traffic. Click for cleanup guide."
										>
											<i data-lucide="alert-triangle" class="h-3 w-3 text-danger-600 transition-transform"></i>
											<span>Dead Flag</span>
										</button>
									} else {
										<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-ok-50 border border-ok-200 text-ok-700 text-2xs font-medium">
											<i data-lucide="check" class="h-3 w-3 text-ok-600"></i>
											<span>Active</span>
										</span>
									}
								</td>

								<!-- Row Quick Actions -->
								<td class="py-3 px-3 text-right">
									<div class="flex items-center justify-end gap-1 font-sans">
										<button
											data-key={ f.Key }
											@click="openEditFlag($el)"
											class="p-1.5 text-neutral-500 hover:text-accent-600 hover:bg-neutral-100 rounded transition cursor-pointer"
											title="Edit targeting rules"
										>
											<i data-lucide="edit-3" class="h-3.5 w-3.5"></i>
										</button>
										<button
											data-key={ f.Key }
											@click="openExperiment($el)"
											class="p-1.5 text-neutral-500 hover:text-accent-600 hover:bg-neutral-100 rounded transition cursor-pointer"
											title="A/B Experiment Stats"
										>
											<i data-lucide="flask-conical" class="h-3.5 w-3.5"></i>
										</button>
										<button
											data-key={ f.Key }
											@click="deleteFlag($el)"
											class="p-1.5 text-neutral-400 hover:text-danger-600 hover:bg-danger-50 rounded transition cursor-pointer"
											title="Delete flag"
										>
											<i data-lucide="trash-2" class="h-3.5 w-3.5"></i>
										</button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			if len(flags) == 0 {
				<div class="p-12 text-center space-y-3">
					<div class="w-10 h-10 rounded-md bg-accent-50 text-accent-600 border border-accent-200 flex items-center justify-center mx-auto">
						<i data-lucide="flag" class="w-5 h-5"></i>
					</div>
					<div class="space-y-1">
						<h3 class="text-sm font-semibold text-neutral-900">No Feature Flags Configured</h3>
						<p class="text-xs text-neutral-500 max-w-sm mx-auto font-sans">Create your first flag to start toggling features and controlling rollouts.</p>
					</div>
					<button
						@click="openNewFlagEditor()"
						class="px-3.5 py-1.5 rounded bg-accent-600 hover:bg-accent-700 text-surface text-xs font-medium inline-flex items-center gap-1.5 cursor-pointer"
					>
						<i data-lucide="plus" class="h-3.5 w-3.5 text-surface"></i>
						<span>Create Feature Flag</span>
					</button>
				</div>
			}
		</div>
	</div>
}
