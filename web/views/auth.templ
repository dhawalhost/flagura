package views

templ AuthPage(showLanding ...bool) {
	@Layout("Authentication — Flagura Console") {
		<div class="min-h-screen flex items-center justify-center p-4 sm:p-6" x-data="authPageComponent()">
			<div class="console-card p-8 sm:p-10 w-full max-w-md space-y-6 shadow-xl">
				<!-- Brand Header -->
				<div class="text-center space-y-2">
					<img src="/static/img/flagura-logo.png" alt="Flagura" class="w-12 h-12 rounded-2xl shadow-lg mx-auto" />
					<h2 class="text-2xl font-bold text-slate-900 font-display">Flagura Console</h2>
					<p class="text-xs text-slate-500">Sub-microsecond deterministic feature flag engine</p>
				</div>

				<!-- Mode Tabs: Sign In / Create Account -->
				<div class="flex items-center rounded-xl bg-slate-100 p-1 border border-slate-200 text-xs font-semibold">
					<button
						type="button"
						@click="mode = 'signin'; error = '';"
						class="flex-1 py-2 rounded-lg transition-all text-center cursor-pointer"
						:class="mode === 'signin' ? 'bg-white text-slate-900 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'"
					>
						Sign In
					</button>
					<button
						type="button"
						@click="mode = 'signup'; error = '';"
						class="flex-1 py-2 rounded-lg transition-all text-center cursor-pointer"
						:class="mode === 'signup' ? 'bg-white text-slate-900 shadow-xs font-bold' : 'text-slate-600 hover:text-slate-900'"
					>
						Create Account
					</button>
				</div>

				<!-- Error Alert -->
				<template x-if="error">
					<div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700 flex items-start gap-2.5">
						<i data-lucide="alert-circle" class="w-4 h-4 text-rose-600 shrink-0 mt-0.5"></i>
						<span x-text="error" class="leading-relaxed"></span>
					</div>
				</template>

				<!-- Sign In Form -->
				<form x-show="mode === 'signin'" @submit.prevent="submitLogin()" class="space-y-4 text-xs">
					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1.5">Work Email</label>
						<input 
							type="email" 
							x-model="loginForm.email" 
							required
							class="input-clean w-full text-xs font-mono"
							placeholder="you@company.com"
						/>
					</div>
					<div>
						<div class="flex items-center justify-between mb-1.5">
							<label class="text-xs font-semibold text-slate-700">Password</label>
						</div>
						<input 
							type="password" 
							x-model="loginForm.password" 
							required
							class="input-clean w-full text-xs font-mono"
							placeholder="••••••••••••"
						/>
					</div>

					<button 
						type="submit" 
						class="w-full py-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 shadow-md bg-blue-600 hover:bg-blue-700 text-white transition-all cursor-pointer"
						:disabled="loading"
					>
						<i data-lucide="loader-2" class="w-4 h-4 animate-spin" x-show="loading"></i>
						<span x-text="loading ? 'Authenticating...' : 'Sign In to Console'"></span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5" x-show="!loading"></i>
					</button>
				</form>

				<!-- Sign Up Form -->
				<form x-show="mode === 'signup'" @submit.prevent="submitSignUp()" class="space-y-4 text-xs" style="display: none;">
					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1.5">Full Name</label>
						<input 
							type="text" 
							x-model="signUpForm.name" 
							required
							class="input-clean w-full text-xs"
							placeholder="Dhawal Dyavanpalli"
						/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1.5">Work Email</label>
						<input 
							type="email" 
							x-model="signUpForm.email" 
							required
							class="input-clean w-full text-xs font-mono"
							placeholder="you@company.com"
						/>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
						<div>
							<label class="block text-xs font-semibold text-slate-700 mb-1.5">Password</label>
							<input 
								type="password" 
								x-model="signUpForm.password" 
								required
								minlength="6"
								class="input-clean w-full text-xs font-mono"
								placeholder="Min 6 chars"
							/>
						</div>
						<div>
							<label class="block text-xs font-semibold text-slate-700 mb-1.5">Confirm Password</label>
							<input 
								type="password" 
								x-model="signUpForm.confirmPassword" 
								required
								minlength="6"
								class="input-clean w-full text-xs font-mono"
								placeholder="Repeat password"
							/>
						</div>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1.5">Your Role</label>
						<select 
							x-model="signUpForm.role"
							class="input-clean w-full text-xs font-mono"
						>
							<option value="developer">Developer / Engineer</option>
							<option value="qa">QA / Test Engineer</option>
							<option value="admin">Administrator / Tech Lead</option>
							<option value="member">Product / Member</option>
						</select>
					</div>

					<button 
						type="submit" 
						class="w-full py-3 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 shadow-md bg-blue-600 hover:bg-blue-700 text-white transition-all cursor-pointer"
						:disabled="loading"
					>
						<i data-lucide="loader-2" class="w-4 h-4 animate-spin" x-show="loading"></i>
						<span x-text="loading ? 'Creating Account...' : 'Create Account & Enter Console'"></span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5" x-show="!loading"></i>
					</button>
				</form>

				if len(showLanding) > 0 && showLanding[0] {
					<div class="text-center pt-2 border-t border-slate-100">
						<a href="/" class="text-xs text-slate-500 hover:text-slate-800 font-medium flex items-center justify-center gap-1.5 transition">
							<i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
							<span>Back to Product Overview</span>
						</a>
					</div>
				}
			</div>
		</div>

		<script>
			document.addEventListener('alpine:init', () => {
				Alpine.data('authPageComponent', () => ({
					mode: 'signin',
					loading: false,
					error: '',
					loginForm: {
						email: '',
						password: ''
					},
					signUpForm: {
						name: '',
						email: '',
						password: '',
						confirmPassword: '',
						role: 'developer'
					},
					async submitLogin() {
						this.loading = true;
						this.error = '';
						window.synth.playClick(600);
						try {
							const res = await fetch('/api/v1/auth/login', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify(this.loginForm)
							});
							const data = await res.json();
							if (!res.ok) {
								this.error = data.message || 'Invalid email or password';
								return;
							}
							this.showToast('Login successful! Welcome back.');
							setTimeout(() => {
								window.location.href = '/dashboard';
							}, 400);
						} catch(err) {
							this.error = 'Network error. Please try again.';
						} finally {
							this.loading = false;
						}
					},
					async submitSignUp() {
						if (this.signUpForm.password !== this.signUpForm.confirmPassword) {
							this.error = 'Passwords do not match';
							return;
						}
						this.loading = true;
						this.error = '';
						window.synth.playClick(600);
						try {
							const res = await fetch('/api/v1/auth/signup', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({
									name: this.signUpForm.name,
									email: this.signUpForm.email,
									password: this.signUpForm.password,
									role: this.signUpForm.role
								})
							});
							const data = await res.json();
							if (!res.ok) {
								this.error = data.message || 'Failed to create account';
								return;
							}
							this.showToast('Account created successfully! Welcome to Flagura.');
							setTimeout(() => {
								window.location.href = '/dashboard';
							}, 400);
						} catch(err) {
							this.error = 'Network error. Please try again.';
						} finally {
							this.loading = false;
						}
					}
				}));
			});
		</script>
	}
}
