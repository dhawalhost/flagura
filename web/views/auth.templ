package views

templ AuthPage(showLanding ...bool) {
	@Layout("Authentication — Flagura") {
		<div class="min-h-screen flex items-center justify-center p-4 sm:p-4 lg:p-10 relative bg-canvas" x-data="authPageComponent()" x-init="initAuth()">
			<div class="relative z-10 w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
				
				<!-- Left Product Summary (Desktop) -->
				<div class="hidden lg:flex lg:col-span-6 flex-col space-y-4 pr-6">
					<a href="/" class="flex items-center gap-2 w-fit">
						@LogoMark("h-7 w-7")
						@LogoWordmark("h-[22px] translate-y-[3px]")
					</a>
					<h1 class="text-2xl font-semibold text-neutral-900">Feature flags you run yourself.</h1>
					<ul class="text-sm text-neutral-600 space-y-1.5">
						<li>Percentage rollouts and targeting rules per environment</li>
						<li>Two-person approval for production changes</li>
						<li>Tamper-evident audit trail</li>
						<li>SDKs that evaluate in process</li>
					</ul>
				</div>

				<!-- Right Auth Card -->
				<div class="lg:col-span-6 w-full max-w-md mx-auto">
					<div class="panel p-5 space-y-4 relative">
						
						<!-- Header & Title -->
						<div class="space-y-1.5">
							<div class="flex items-center justify-between">
								<h2 class="text-2xl font-semibold text-neutral-900" x-text="getTitleText()">
									Sign In
								</h2>
							</div>
							<p class="text-xs text-neutral-500 font-sans" x-text="getSubtitleText()">
								Access your team feature flags, rollouts, and environments
							</p>
						</div>

						<!-- Mode Tabs: Sign In / Create Account -->
						<div x-show="isMainAuthMode()" class="flex items-center rounded-md bg-neutral-100 p-1 border border-neutral-200 text-xs font-semibold">
							<button
								type="button"
								@click="setMode('signin')"
								class="flex-1 py-2 rounded transition-colors text-center cursor-pointer font-medium"
								:class="mode === 'signin' ? 'bg-neutral-900 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								Sign In
							</button>
							<button
								type="button"
								@click="setMode('signup')"
								class="flex-1 py-2 rounded transition-colors text-center cursor-pointer font-medium"
								:class="mode === 'signup' ? 'bg-neutral-900 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								Create Account
							</button>
						</div>

						<!-- Error Alert -->
						<template x-if="error">
							<div class="p-3.5 rounded-md bg-danger-50 border border-danger-200 text-xs text-danger-700 flex items-start gap-2.5">
								<i data-lucide="alert-circle" class="w-4 h-4 text-danger-600 shrink-0 mt-0.5"></i>
								<span x-text="error" class="leading-relaxed"></span>
							</div>
						</template>

						<!-- Success Alert -->
						<template x-if="successMessage">
							<div class="p-3.5 rounded-md bg-ok-50 border border-ok-200 text-xs text-ok-800 flex items-start gap-2.5">
								<i data-lucide="check-circle-2" class="w-4 h-4 text-ok-600 shrink-0 mt-0.5"></i>
								<span x-text="successMessage" class="leading-relaxed font-medium"></span>
							</div>
						</template>

						<!-- 1. Sign In Form -->
						<form x-show="mode === 'signin'" @submit.prevent="submitLogin()" class="space-y-4 text-xs">
							<div>
								<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Work Email</label>
								<div class="relative">
									<i data-lucide="mail" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
									<input 
										type="email" 
										x-model="loginForm.email" 
										required
										class="w-full bg-surface border border-neutral-200 rounded-md pl-9 pr-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
										placeholder="you@company.com"
									/>
								</div>
							</div>
							<div>
								<div class="flex items-center justify-between mb-1.5">
									<label class="text-xs font-semibold text-neutral-700">Password</label>
									<button 
										type="button" 
										@click="setMode('forgot')" 
										class="text-2xs text-accent-600 hover:underline font-semibold transition cursor-pointer"
									>
										Forgot password?
									</button>
								</div>
								<div class="relative">
									<i data-lucide="lock" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
									<input 
										:type="showPassword ? 'text' : 'password'" 
										x-model="loginForm.passphrase" 
										required
										class="w-full bg-surface border border-neutral-200 rounded-md pl-9 pr-10 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
										placeholder="••••••••••••"
									/>
									<button 
										type="button" 
										@click="showPassword = !showPassword"
										class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 cursor-pointer"
									>
										<span class="inline-flex" x-show="!showPassword"><i data-lucide="eye" class="w-4 h-4"></i></span>
										<span class="inline-flex" x-show="showPassword"><i data-lucide="eye-off" class="w-4 h-4"></i></span>
									</button>
								</div>
							</div>

							<button 
								type="submit" 
								class="w-full py-3 rounded-md text-xs font-medium flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-700 text-surface transition-colors cursor-pointer"
								:disabled="loading"
							>
								<span class="inline-flex" x-show="loading"><i data-lucide="loader-2" class="w-4 h-4 animate-spin text-surface"></i></span>
								<span x-text="loading ? 'Authenticating...' : 'Sign in'"></span>
								<span class="inline-flex" x-show="!loading"><i data-lucide="arrow-right" class="w-3.5 h-3.5 text-surface"></i></span>
							</button>

							<div class="relative my-3.5">
								<div class="absolute inset-0 flex items-center"><span class="w-full border-t border-neutral-200"></span></div>
								<div class="relative flex justify-center text-2xs"><span class="bg-surface px-2 text-neutral-400">Or continue with</span></div>
							</div>

							<!-- Social OAuth Buttons (Google & GitHub) -->
							<div x-show="oauthProviders.google || oauthProviders.github" class="space-y-2">
								<a 
									x-show="oauthProviders.google" 
									href="/api/v1/auth/oauth/google/login"
									class="w-full py-2.5 px-3.5 rounded-md text-xs font-semibold flex items-center justify-center gap-2.5 border border-neutral-200 hover:border-neutral-300 hover:bg-neutral-50 text-neutral-700 transition cursor-pointer font-sans"
								>
									<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
										<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
										<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
										<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"></path>
										<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"></path>
									</svg>
									<span>Sign in with Google</span>
								</a>
								<a 
									x-show="oauthProviders.github" 
									href="/api/v1/auth/oauth/github/login"
									class="w-full py-2.5 px-3.5 rounded-md text-xs font-semibold flex items-center justify-center gap-2.5 border border-neutral-200 hover:border-neutral-300 hover:bg-neutral-50 text-neutral-700 transition cursor-pointer font-sans"
								>
									<svg class="w-4 h-4 shrink-0 fill-current text-neutral-800" viewBox="0 0 24 24">
										<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
									</svg>
									<span>Sign in with GitHub</span>
								</a>
							</div>

							<button 
								type="button" 
								@click="setMode('sso')" 
								class="w-full py-2.5 rounded-md text-xs font-medium flex items-center justify-center gap-2 border border-neutral-200 hover:border-accent-300 hover:bg-accent-50/50 text-neutral-700 transition cursor-pointer"
							>
								<i data-lucide="shield-check" class="w-4 h-4 text-accent-600"></i>
								<span>Single Sign-On (SSO / OIDC)</span>
							</button>
						</form>

						<!-- Enterprise SSO Form -->
						<form x-show="mode === 'sso'" @submit.prevent="submitSSO()" class="space-y-4 text-xs" style="display: none;">
							<div class="p-3.5 rounded-md bg-accent-50 border border-accent-200 text-neutral-700 space-y-1">
								<div class="font-medium flex items-center gap-1.5 text-accent-700">
									<i data-lucide="shield-check" class="w-4 h-4"></i>
									<span>Enterprise Single Sign-On</span>
								</div>
								<p class="text-2xs text-neutral-600 leading-relaxed font-sans">
									Enter your corporate email address or organization domain to authenticate with your enterprise identity provider (Google, Okta, Azure AD, Keycloak).
								</p>
							</div>

							<div>
								<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Company Email or Domain</label>
								<div class="relative">
									<i data-lucide="globe" class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
									<input 
										type="text" 
										x-model="ssoForm.domain" 
										required
										class="w-full bg-surface border border-neutral-200 rounded-md pl-9 pr-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
										placeholder="company.com or you@company.com"
									/>
								</div>
							</div>

							<button 
								type="submit" 
								class="w-full py-3 rounded-md text-xs font-medium flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-700 text-surface transition-colors cursor-pointer"
								:disabled="loading"
							>
								<span class="inline-flex" x-show="loading"><i data-lucide="loader-2" class="w-4 h-4 animate-spin text-surface"></i></span>
								<span x-text="loading ? 'Redirecting to IdP...' : 'Continue with SSO'"></span>
								<span class="inline-flex" x-show="!loading"><i data-lucide="arrow-right" class="w-3.5 h-3.5 text-surface"></i></span>
							</button>

							<div class="text-center pt-2">
								<button 
									type="button" 
									@click="setMode('signin')" 
									class="text-xs text-neutral-500 hover:text-neutral-900 font-semibold flex items-center justify-center gap-1 mx-auto transition cursor-pointer"
								>
									<i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
									<span>Back to Email &amp; Password</span>
								</button>
							</div>
						</form>

						<!-- 2. Sign Up Form -->
						<form x-show="mode === 'signup'" @submit.prevent="submitSignUp()" class="space-y-4 text-xs" style="display: none;">
							<div>
								<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Full Name</label>
								<input 
									type="text" 
									x-model="signUpForm.name" 
									required
									class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors"
									placeholder="Jane Doe"
								/>
							</div>

							<div>
								<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Work Email</label>
								<input 
									type="email" 
									x-model="signUpForm.email" 
									required
									class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
									placeholder="you@company.com"
								/>
							</div>

							<div class="space-y-2">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
									<div>
										<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Password</label>
										<input 
											type="password" 
											x-model="signUpForm.passphrase" 
											@input="evaluatePassword(signUpForm.passphrase)"
											required
											minlength="8"
											class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
											placeholder="Min 8 characters"
										/>
									</div>
									<div>
										<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Confirm Password</label>
										<input 
											type="password" 
											x-model="signUpForm.confirmPassphrase" 
											required
											minlength="8"
											class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
											placeholder="Repeat password"
										/>
									</div>
								</div>

								<!-- Real-Time Password Complexity Requirements -->
								<div x-show="signUpForm.passphrase.length > 0" class="p-3 rounded-md bg-neutral-50 border border-neutral-200 space-y-2 text-2xs">
									<div class="flex items-center justify-between font-semibold">
										<span class="text-neutral-500">Password Strength:</span>
										<span :class="passwordStrengthColor" x-text="passwordStrengthText"></span>
									</div>
									<div class="h-1.5 w-full bg-neutral-200 rounded-full overflow-hidden flex gap-1">
										<div class="h-full rounded-full transition-all duration-150" :class="passwordStrengthClass" :style="'width: ' + passwordStrengthPct + '%'"></div>
									</div>
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-1 pt-1 text-2xs">
										<div class="flex items-center gap-1.5" :class="criteria.len ? 'text-ok-700 font-medium' : 'text-neutral-400'">
											<span x-text="criteria.len ? '✓' : '○'"></span>
											<span>8+ characters</span>
										</div>
										<div class="flex items-center gap-1.5" :class="criteria.upper ? 'text-ok-700 font-medium' : 'text-neutral-400'">
											<span x-text="criteria.upper ? '✓' : '○'"></span>
											<span>Uppercase letter (A-Z)</span>
										</div>
										<div class="flex items-center gap-1.5" :class="criteria.lower ? 'text-ok-700 font-medium' : 'text-neutral-400'">
											<span x-text="criteria.lower ? '✓' : '○'"></span>
											<span>Lowercase letter (a-z)</span>
										</div>
										<div class="flex items-center gap-1.5" :class="criteria.digit ? 'text-ok-700 font-medium' : 'text-neutral-400'">
											<span x-text="criteria.digit ? '✓' : '○'"></span>
											<span>Number (0-9)</span>
										</div>
										<div class="flex items-center gap-1.5 sm:col-span-2" :class="criteria.special ? 'text-ok-700 font-medium' : 'text-neutral-400'">
											<span x-text="criteria.special ? '✓' : '○'"></span>
											<span>Special symbol (!@#$%^&amp;*)</span>
										</div>
									</div>
								</div>
							</div>


							<button 
								type="submit" 
								class="w-full py-3 rounded-md text-xs font-medium flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-700 text-surface transition-colors cursor-pointer"
								:disabled="loading"
							>
								<span class="inline-flex" x-show="loading"><i data-lucide="loader-2" class="w-4 h-4 animate-spin text-surface"></i></span>
								<span x-text="loading ? 'Creating Account...' : 'Create Account & Enter Console'"></span>
								<span class="inline-flex" x-show="!loading"><i data-lucide="arrow-right" class="w-3.5 h-3.5 text-surface"></i></span>
							</button>

							<div x-show="oauthProviders.google || oauthProviders.github" class="relative my-3.5">
								<div class="absolute inset-0 flex items-center"><span class="w-full border-t border-neutral-200"></span></div>
								<div class="relative flex justify-center text-2xs"><span class="bg-surface px-2 text-neutral-400">Or sign up with</span></div>
							</div>

							<!-- Social OAuth Buttons (Google & GitHub) -->
							<div x-show="oauthProviders.google || oauthProviders.github" class="space-y-2">
								<a 
									x-show="oauthProviders.google" 
									href="/api/v1/auth/oauth/google/login"
									class="w-full py-2.5 px-3.5 rounded-md text-xs font-semibold flex items-center justify-center gap-2.5 border border-neutral-200 hover:border-neutral-300 hover:bg-neutral-50 text-neutral-700 transition cursor-pointer font-sans"
								>
									<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
										<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
										<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
										<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"></path>
										<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"></path>
									</svg>
									<span>Sign up with Google</span>
								</a>
								<a 
									x-show="oauthProviders.github" 
									href="/api/v1/auth/oauth/github/login"
									class="w-full py-2.5 px-3.5 rounded-md text-xs font-semibold flex items-center justify-center gap-2.5 border border-neutral-200 hover:border-neutral-300 hover:bg-neutral-50 text-neutral-700 transition cursor-pointer font-sans"
								>
									<svg class="w-4 h-4 shrink-0 fill-current text-neutral-800" viewBox="0 0 24 24">
										<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
									</svg>
									<span>Sign up with GitHub</span>
								</a>
							</div>
						</form>

						<!-- 3. Forgot Password View -->
						<div x-show="mode === 'forgot'" class="space-y-5 text-xs" style="display: none;">
							<div class="p-4 rounded-md bg-accent-50 border border-accent-200 text-neutral-700 space-y-1">
								<div class="font-medium flex items-center gap-1.5 text-accent-700">
									<i data-lucide="key-round" class="w-4 h-4"></i>
									<span>Account Recovery</span>
								</div>
								<p class="text-2xs text-neutral-600 leading-relaxed font-sans">
									Enter your registered work email. We will send you a secure, single-use 15-minute recovery link.
								</p>
							</div>

							<form @submit.prevent="submitForgotPassword()" class="space-y-4">
								<div>
									<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Registered Email Address</label>
									<input 
										type="email" 
										x-model="forgotForm.email" 
										required
										class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
										placeholder="you@company.com"
									/>
								</div>

								<button 
									type="submit" 
									class="w-full py-3 rounded-md text-xs font-medium flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-700 text-surface transition-colors cursor-pointer"
									:disabled="loading"
								>
									<span class="inline-flex" x-show="loading"><i data-lucide="loader-2" class="w-4 h-4 animate-spin text-surface"></i></span>
									<span x-text="loading ? 'Sending Recovery Link...' : 'Send Password Reset Link'"></span>
									<span class="inline-flex" x-show="!loading"><i data-lucide="mail" class="w-3.5 h-3.5 text-surface"></i></span>
								</button>
							</form>

							<div class="text-center pt-2">
								<button 
									type="button" 
									@click="setMode('signin')" 
									class="text-xs text-neutral-500 hover:text-neutral-900 font-semibold flex items-center justify-center gap-1 mx-auto transition cursor-pointer"
								>
									<i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
									<span>Back to Sign In</span>
								</button>
							</div>
						</div>

						<!-- 4. Reset Password View -->
						<div x-show="mode === 'reset'" class="space-y-5 text-xs" style="display: none;">
							<div class="p-4 rounded-md bg-accent-50 border border-accent-200 text-neutral-700 space-y-1">
								<div class="font-medium flex items-center gap-1.5 text-accent-700">
									<i data-lucide="shield-check" class="w-4 h-4"></i>
									<span>Set New Password</span>
								</div>
								<p class="text-2xs text-neutral-600 leading-relaxed font-sans">
									Choose a strong password conforming to security guidelines.
								</p>
							</div>

							<form @submit.prevent="submitResetPassword()" class="space-y-4">
								<div class="space-y-2">
									<div>
										<label class="block text-xs font-semibold text-neutral-700 mb-1.5">New Password</label>
										<input 
											type="password" 
											x-model="resetForm.passphrase" 
											@input="evaluatePassword(resetForm.passphrase)"
											required
											minlength="8"
											class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
											placeholder="Min 8 characters"
										/>
									</div>

									<!-- Real-Time Password Complexity Requirements -->
									<div x-show="resetForm.passphrase.length > 0" class="p-3 rounded-md bg-neutral-50 border border-neutral-200 space-y-2 text-2xs">
										<div class="flex items-center justify-between font-semibold">
											<span class="text-neutral-500">Strength:</span>
											<span :class="passwordStrengthColor" x-text="passwordStrengthText"></span>
										</div>
										<div class="h-1.5 w-full bg-neutral-200 rounded-full overflow-hidden flex gap-1">
											<div class="h-full rounded-full transition-all duration-150" :class="passwordStrengthClass" :style="'width: ' + passwordStrengthPct + '%'"></div>
										</div>
										<div class="grid grid-cols-1 sm:grid-cols-2 gap-1 pt-1 text-2xs">
											<div class="flex items-center gap-1.5" :class="criteria.len ? 'text-ok-700 font-medium' : 'text-neutral-400'">
												<span x-text="criteria.len ? '✓' : '○'"></span>
												<span>8+ characters</span>
											</div>
											<div class="flex items-center gap-1.5" :class="criteria.upper ? 'text-ok-700 font-medium' : 'text-neutral-400'">
												<span x-text="criteria.upper ? '✓' : '○'"></span>
												<span>Uppercase (A-Z)</span>
											</div>
											<div class="flex items-center gap-1.5" :class="criteria.lower ? 'text-ok-700 font-medium' : 'text-neutral-400'">
												<span x-text="criteria.lower ? '✓' : '○'"></span>
												<span>Lowercase (a-z)</span>
											</div>
											<div class="flex items-center gap-1.5" :class="criteria.digit ? 'text-ok-700 font-medium' : 'text-neutral-400'">
												<span x-text="criteria.digit ? '✓' : '○'"></span>
												<span>Number (0-9)</span>
											</div>
											<div class="flex items-center gap-1.5 sm:col-span-2" :class="criteria.special ? 'text-ok-700 font-medium' : 'text-neutral-400'">
												<span x-text="criteria.special ? '✓' : '○'"></span>
												<span>Special symbol (!@#$%^&amp;*)</span>
											</div>
										</div>
									</div>

									<div>
										<label class="block text-xs font-semibold text-neutral-700 mb-1.5">Confirm New Password</label>
										<input 
											type="password" 
											x-model="resetForm.confirmPassphrase" 
											required
											minlength="8"
											class="w-full bg-surface border border-neutral-200 rounded-md px-3.5 py-2.5 text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-accent-500 transition-colors font-mono"
											placeholder="Repeat new password"
										/>
									</div>
								</div>

								<button 
									type="submit" 
									class="w-full py-3 rounded-md text-xs font-medium flex items-center justify-center gap-2 bg-neutral-900 hover:bg-neutral-700 text-surface transition-colors cursor-pointer"
									:disabled="loading"
								>
									<span class="inline-flex" x-show="loading"><i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i></span>
									<span x-text="loading ? 'Updating Password...' : 'Save Strong Password & Sign In'"></span>
									<span class="inline-flex" x-show="!loading"><i data-lucide="check" class="w-3.5 h-3.5"></i></span>
								</button>
							</form>

							<div class="text-center pt-2">
								<button 
									type="button" 
									@click="setMode('signin')" 
									class="text-xs text-neutral-500 hover:text-neutral-900 font-semibold flex items-center justify-center gap-1 mx-auto transition cursor-pointer"
								>
									<i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
									<span>Back to Sign In</span>
								</button>
							</div>
						</div>

						<!-- Email Support & Help Links -->
						<div class="pt-4 border-t border-neutral-100 flex flex-col items-center gap-2 text-center text-2xs text-neutral-500">
							if len(showLanding) > 0 && showLanding[0] {
								<div>
									<span>Need assistance? Contact our team at </span>
									<a href="mailto:support@flagura.dev" class="text-accent-600 hover:underline font-semibold">{"support@flagura.dev"}</a>
								</div>
								<div>
									<a href="/" class="text-neutral-500 hover:text-neutral-900 font-medium flex items-center justify-center gap-1 transition">
										<i data-lucide="arrow-left" class="w-3 h-3"></i>
										<span>Back to Product Overview</span>
									</a>
								</div>
							} else {
								<div>
									<span>Flagura self-hosted console</span>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
