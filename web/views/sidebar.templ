package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

func resolveActiveOrgName(orgs []domain.Organization, projects []domain.Project, activeProjectID string) string {
	var targetOrgID string
	for _, p := range projects {
		if p.ID == activeProjectID || (activeProjectID == "" && p.ID == "proj_default") {
			targetOrgID = p.OrganizationID
			break
		}
	}
	for _, o := range orgs {
		if o.ID == targetOrgID {
			return o.Name
		}
	}
	if len(orgs) > 0 {
		return orgs[0].Name
	}
	return "Organization"
}

templ Sidebar(user *domain.User, flags []domain.FeatureFlag, auditLogs []domain.AuditLogEntry, orgs []domain.Organization, projects []domain.Project, activeProjectID string) {
	<aside 
		class="w-60 fixed lg:sticky top-0 h-screen bg-shell p-3 flex flex-col justify-between z-40 transition-transform duration-150 shrink-0"
		:class="isMobileSidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'"
	>
		<div class="space-y-5">
			<!-- Logo & Flagura Brand -->
			<div class="flex items-center justify-between px-1">
				<a href="/" class="flex items-center gap-3 group">
					@LogoMark("h-7 w-7")
					<div class="flex flex-col">
						<span class="font-semibold text-neutral-900 text-base leading-none flex items-center gap-2">
							@LogoWordmark("h-[22px] translate-y-[3px]")
							<span class="text-2xs font-mono font-normal text-neutral-600">v{ domain.CleanVersion() }</span>
						</span>
					</div>
				</a>
				<button 
					@click="isMobileSidebarOpen = false"
					class="lg:hidden p-1.5 rounded text-neutral-400 hover:text-neutral-700"
				>
					<i data-lucide="x" class="w-4 h-4"></i>
				</button>
			</div>

			<!-- Organization & Project Selector Dropdown -->
			<div class="relative" x-data="dropdownComponent()">
				<button 
					@click="toggle()"
					class="w-full flex items-center justify-between p-2 rounded-md bg-surface hover:bg-neutral-50 nav-card text-left transition group cursor-pointer"
				>
					<div class="flex items-center gap-2 min-w-0">
						<div class="min-w-0">
							<div class="text-2xs font-semibold text-neutral-500 truncate">
								{ resolveActiveOrgName(orgs, projects, activeProjectID) }
							</div>
							<div class="text-xs font-medium text-neutral-900 truncate">
								for _, p := range projects {
									if p.ID == activeProjectID || (activeProjectID == "" && p.ID == "proj_default") {
										{ p.Name }
									}
								}
							</div>
						</div>
					</div>
					<i data-lucide="chevrons-up-down" class="w-3.5 h-3.5 text-neutral-400 group-hover:text-neutral-600 shrink-0"></i>
				</button>

				<!-- Dropdown Menu -->
				<div 
					x-show="isOpen" 
					@click.outside="close()" 
					class="absolute left-0 mt-2 w-full bg-surface p-2 z-50 shadow-pop border border-neutral-200 rounded-xl space-y-1"
					style="display: none;"
					x-transition
				>
					<div class="max-h-56 overflow-y-auto space-y-2">
						for _, org := range orgs {
							<div class="px-2 pt-1 text-2xs font-medium text-neutral-400">
								{ org.Name }
							</div>
							for _, p := range projects {
								if p.OrganizationID == org.ID || (org.ID == "org_default" && p.OrganizationID == "") {
									<button 
										data-project-id={ p.ID }
										@click="selectProject($el)"
										class="w-full text-left px-2 py-2 rounded-md text-xs flex items-center justify-between hover:bg-neutral-50 text-neutral-700 hover:text-neutral-900 cursor-pointer transition-colors"
									>
										<div class="truncate">
											<div class="font-semibold text-neutral-900 truncate">{ p.Name }</div>
											<div class="text-2xs text-neutral-400 font-mono truncate">{ p.Slug }</div>
										</div>
										if p.ID == activeProjectID || (activeProjectID == "" && p.ID == "proj_default") {
											<i data-lucide="check" class="w-3.5 h-3.5 text-accent-600 shrink-0"></i>
										}
									</button>
								}
							}
						}
					</div>
					<div class="border-t border-neutral-100 pt-2 mt-1 space-y-0.5">
						<button 
							@click="openCreateProject()"
							class="w-full text-left px-2 py-1.5 rounded text-xs font-semibold text-accent-600 hover:bg-accent-50 flex items-center gap-2 cursor-pointer"
						>
							<i data-lucide="plus" class="w-3.5 h-3.5"></i>
							<span>New project</span>
						</button>
						<button 
							@click="openInvite()"
							class="w-full text-left px-2 py-1.5 rounded text-xs font-semibold text-neutral-600 hover:bg-neutral-50 flex items-center gap-2 cursor-pointer"
						>
							<i data-lucide="user-plus" class="w-3.5 h-3.5 text-neutral-500"></i>
							<span>Invite teammate</span>
						</button>
					</div>
				</div>
			</div>

			<!-- Navigation Links -->
			<nav class="space-y-6">
				<div class="nav-group">
					<p class="nav-label">Release</p>
					<!-- 1: Overview -->
				<button 
					@click="navigateTo('overview')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'overview' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="layout-dashboard" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Overview</span>
					</div>
					
				</button>
					<!-- 2: Flags -->
				<button 
					@click="navigateTo('flags')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'flags' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="sliders" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Flags</span>
					</div>
					<span class="text-2xs font-mono text-neutral-600">{ fmt.Sprintf("%02d", len(flags)) }</span>
				</button>
					<!-- 8: 4-Eyes Approvals -->
				<button 
					@click="openGovernanceModal()"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="shield-check" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Approvals</span>
					</div>
					
				</button>
				</div>
				<div class="nav-group">
					<p class="nav-label">Inspect</p>
					<!-- 4: Evaluator -->
				<button 
					@click="navigateTo('evaluator')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'evaluator' || activeView === 'benchmark' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="zap" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Evaluator</span>
					</div>
					
				</button>
					<!-- 3: Analytics -->
				<button 
					@click="navigateTo('analytics')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'analytics' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="bar-chart-3" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Analytics</span>
					</div>
					
				</button>
					<!-- 6: Audit trail -->
				<button 
					@click="navigateTo('audit')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'audit' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="file-text" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Audit trail</span>
					</div>
					<span class="text-2xs font-mono text-neutral-600">{ fmt.Sprintf("%d", len(auditLogs)) }</span>
				</button>
				</div>
				<div class="nav-group">
					<p class="nav-label">Connect</p>
					<!-- 7: SDKs -->
				<button 
					@click="navigateTo('sdk')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'sdk' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="code-2" class="w-4 h-4"></i>
						<span class="font-sans font-medium">SDKs</span>
					</div>
					
				</button>
					<!-- API Keys -->
				<button 
					@click="navigateTo('apikeys')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'apikeys' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="key" class="w-4 h-4"></i>
						<span class="font-sans font-medium">API keys</span>
					</div>
				</button>
				</div>
				<div class="nav-group">
					<!-- 9: Settings -->
				<button 
					@click="navigateTo('profile')"
					class="w-full flex items-center justify-between px-3 h-9 rounded-md text-sm font-normal transition-colors cursor-pointer"
					:class="activeView === 'profile' ? 'nav-active' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900'"
				>
					<div class="flex items-center gap-2">
						<i data-lucide="user-cog" class="w-4 h-4"></i>
						<span class="font-sans font-medium">Settings</span>
					</div>
					
				</button>
				</div>
			</nav>
		</div>

		<div class="pt-3 border-t border-neutral-200">
			<button 
				@click="navigateTo('profile')"
				class="w-full text-left text-xs text-neutral-600 hover:text-neutral-900 truncate transition-colors cursor-pointer"
				title={ user.Email }
			>
				if user != nil && user.Name != "" {
					{ user.Name }
				} else {
					Developer
				}
			</button>
		</div>
	</aside>
}
