package views

templ HygieneModal() {
	<div
		x-data="hygieneModalComponent()"
		@open-hygiene-modal.window="openModal($event.detail)"
		x-show="isOpen"
		x-cloak
		class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/40 backdrop-blur-md flex items-center justify-center p-4"
	>
		<div
			@click.away="closeModal()"
			class="bg-white rounded-3xl max-w-2xl w-full border border-slate-200 shadow-2xl overflow-hidden transition-all max-h-[90vh] flex flex-col"
		>
			<!-- Header -->
			<div class="px-6 py-5 border-b border-slate-100 bg-white flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div 
						class="h-10 w-10 rounded-2xl flex items-center justify-center shadow-2xs border"
						:class="flagStatus === 'DEAD_FLAG' ? 'bg-red-50 border-red-200 text-red-600' : 'bg-amber-50 border-amber-200 text-amber-600'"
					>
						<i :data-lucide="flagStatus === 'DEAD_FLAG' ? 'alert-triangle' : 'sparkles'" class="h-5 w-5"></i>
					</div>
					<div>
						<div class="flex items-center gap-2">
							<h3 class="font-bold text-slate-900 text-base font-display">Automated Code Hygiene &amp; Cleanup</h3>
							<span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-slate-100 text-slate-800 border border-slate-200" x-text="flagKey"></span>
						</div>
						<p class="text-xs text-slate-500 font-sans">Eliminate dead branching code and reduce architectural tech debt</p>
					</div>
				</div>

				<button
					@click="closeModal()"
					class="p-2 text-slate-400 hover:text-slate-700 rounded-xl hover:bg-slate-100 transition cursor-pointer"
				>
					<i data-lucide="x" class="h-5 w-5"></i>
				</button>
			</div>

			<!-- Body -->
			<div class="p-6 overflow-y-auto space-y-5 flex-1 text-xs font-mono">
				<!-- Diagnostic Card -->
				<div 
					class="p-4 rounded-2xl border space-y-2"
					:class="flagStatus === 'DEAD_FLAG' ? 'bg-red-50/60 border-red-200 text-red-950' : 'bg-amber-50/60 border-amber-200 text-amber-950'"
				>
					<div class="flex items-center justify-between">
						<span class="font-bold uppercase tracking-wider text-[10px] flex items-center gap-1.5">
							<span class="inline-block w-2 h-2 rounded-full" :class="flagStatus === 'DEAD_FLAG' ? 'bg-red-500' : 'bg-amber-500'"></span>
							<span x-text="flagStatus === 'DEAD_FLAG' ? 'Dead Flag Detected' : 'Ready for Code Cleanup (Stale)'"></span>
						</span>
						<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-white border border-slate-200 text-slate-700 font-mono" x-text="flagStatus === 'DEAD_FLAG' ? '0% Traffic' : '100% Launched'"></span>
					</div>
					<p class="text-xs text-slate-700 font-sans leading-relaxed" x-text="flagReason"></p>
					<div class="text-[11px] font-sans font-semibold text-slate-600 flex items-center gap-1.5 pt-1 border-t border-slate-200/60">
						<span>Suggested Action:</span>
						<span class="text-slate-900" x-text="flagAction"></span>
					</div>
				</div>

				<!-- Code Refactoring Clean-up Diff -->
				<div class="space-y-3">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<i data-lucide="code-2" class="w-4 h-4 text-indigo-600"></i>
							<span class="font-bold text-slate-800 uppercase tracking-wider text-[11px]">Recommended Code Cleanup</span>
						</div>
						
						<!-- Language Switcher -->
						<div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200 text-[11px]">
							<button
								@click="cleanupLang = 'go'"
								class="px-2.5 py-1 rounded-lg font-bold transition cursor-pointer"
								:class="cleanupLang === 'go' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
							>
								Go
							</button>
							<button
								@click="cleanupLang = 'ts'"
								class="px-2.5 py-1 rounded-lg font-bold transition cursor-pointer"
								:class="cleanupLang === 'ts' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
							>
								TypeScript
							</button>
							<button
								@click="cleanupLang = 'py'"
								class="px-2.5 py-1 rounded-lg font-bold transition cursor-pointer"
								:class="cleanupLang === 'py' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
							>
								Python
							</button>
						</div>
					</div>

					<!-- Refactoring Diff Window -->
					<div class="rounded-2xl border border-slate-800 bg-slate-900 overflow-hidden shadow-sm">
						<div class="px-4 py-2.5 bg-slate-950 border-b border-slate-800 flex items-center justify-between text-[10px] text-slate-400">
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
								<span class="ml-2 font-mono">Refactor Diff — Remove Conditional Flag Branch</span>
							</div>
							<button
								@click="copyDiffSnippet()"
								class="text-indigo-400 hover:text-indigo-300 transition flex items-center gap-1 cursor-pointer"
							>
								<i data-lucide="copy" class="w-3 h-3"></i>
								<span x-text="copiedDiff ? 'Copied!' : 'Copy Code'"></span>
							</button>
						</div>
						<pre class="p-4 text-xs font-mono leading-relaxed overflow-x-auto text-slate-200" x-html="getDiffHtml()"></pre>
					</div>
				</div>

				<!-- Debt Prevention Tip -->
				<div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-[11px] font-sans flex items-start gap-2.5">
					<i data-lucide="shield-check" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
					<div>
						<strong class="text-slate-800 font-mono">Why clean up this flag?</strong>
						<p class="mt-0.5 leading-relaxed">
							Flags with 100% rollout generate unnecessary CPU branch evaluations and clutter tests. Removing the conditional check turns your feature into permanent mainline code.
						</p>
					</div>
				</div>
			</div>

			<!-- Footer -->
			<div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between font-mono">
				<button
					@click="deleteFlag(flagKey)"
					class="px-3.5 py-2 rounded-xl text-xs font-bold text-red-600 hover:bg-red-50 border border-red-200 transition cursor-pointer flex items-center gap-1.5"
				>
					<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
					<span>Delete Flag from Console</span>
				</button>

				<button
					@click="closeModal()"
					class="px-4 py-2 rounded-xl text-xs font-bold bg-slate-200 hover:bg-slate-300 text-slate-800 transition cursor-pointer"
				>
					Close
				</button>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('alpine:init', () => {
			Alpine.data('hygieneModalComponent', () => ({
				isOpen: false,
				flagKey: '',
				flagName: '',
				flagStatus: 'READY_FOR_CLEANUP',
				flagReason: '',
				flagAction: '',
				cleanupLang: 'go',
				copiedDiff: false,
				openModal(data) {
					this.flagKey = data.key || '';
					this.flagName = data.name || '';
					this.flagStatus = data.status || 'READY_FOR_CLEANUP';
					this.flagReason = data.reason || '';
					this.flagAction = data.action || '';
					this.isOpen = true;
					this.$nextTick(() => {
						if (window.lucide) window.lucide.createIcons();
					});
				},
				closeModal() {
					this.isOpen = false;
				},
				getDiffHtml() {
					const k = this.flagKey || 'my-feature-flag';
					if (this.cleanupLang === 'go') {
						if (this.flagStatus === 'DEAD_FLAG') {
							return '<span class="text-red-400 font-bold">- if client.IsEnabled(ctx, "' + k + '", userCtx) {</span>\n' +
								'<span class="text-red-400 font-bold">-     doFeatureWork()</span>\n' +
								'<span class="text-red-400 font-bold">- } else {</span>\n' +
								'<span class="text-emerald-400 font-bold">+ // Feature abandoned / dead code removed:</span>\n' +
								'<span class="text-emerald-400 font-bold">+ doFallbackWork()</span>\n' +
								'<span class="text-red-400 font-bold">-     doFallbackWork()</span>\n' +
								'<span class="text-red-400 font-bold">- }</span>';
						}
						return '<span class="text-red-400 font-bold">- if client.IsEnabled(ctx, "' + k + '", userCtx) {</span>\n' +
							'<span class="text-red-400 font-bold">-     renderNewExperience()</span>\n' +
							'<span class="text-red-400 font-bold">- } else {</span>\n' +
							'<span class="text-red-400 font-bold">-     renderLegacyExperience()</span>\n' +
							'<span class="text-red-400 font-bold">- }</span>\n' +
							'<span class="text-emerald-400 font-bold">+ // 100% launched: permanent in-line code</span>\n' +
							'<span class="text-emerald-400 font-bold">+ renderNewExperience()</span>';
					} else if (this.cleanupLang === 'ts') {
						if (this.flagStatus === 'DEAD_FLAG') {
							return '<span class="text-red-400 font-bold">- if (await client.evaluate("' + k + '", user)) {</span>\n' +
								'<span class="text-red-400 font-bold">-   executeFeature();</span>\n' +
								'<span class="text-red-400 font-bold">- } else {</span>\n' +
								'<span class="text-emerald-400 font-bold">+ executeFallback();</span>\n' +
								'<span class="text-red-400 font-bold">-   executeFallback();</span>\n' +
								'<span class="text-red-400 font-bold">- }</span>';
						}
						return '<span class="text-red-400 font-bold">- if (await client.evaluate("' + k + '", user)) {</span>\n' +
							'<span class="text-red-400 font-bold">-   renderNewUI();</span>\n' +
							'<span class="text-red-400 font-bold">- } else {</span>\n' +
							'<span class="text-red-400 font-bold">-   renderLegacyUI();</span>\n' +
							'<span class="text-red-400 font-bold">- }</span>\n' +
							'<span class="text-emerald-400 font-bold">+ // Permanent mainline code:</span>\n' +
							'<span class="text-emerald-400 font-bold">+ renderNewUI();</span>';
					} else {
						if (this.flagStatus === 'DEAD_FLAG') {
							return '<span class="text-red-400 font-bold">- if client.is_enabled("' + k + '", user):</span>\n' +
								'<span class="text-red-400 font-bold">-     run_experimental_feature()</span>\n' +
								'<span class="text-red-400 font-bold">- else:</span>\n' +
								'<span class="text-emerald-400 font-bold">+ run_default_feature()</span>\n' +
								'<span class="text-red-400 font-bold">-     run_default_feature()</span>';
						}
						return '<span class="text-red-400 font-bold">- if client.is_enabled("' + k + '", user):</span>\n' +
							'<span class="text-red-400 font-bold">-     run_new_experience()</span>\n' +
							'<span class="text-red-400 font-bold">- else:</span>\n' +
							'<span class="text-red-400 font-bold">-     run_legacy_experience()</span>\n' +
							'<span class="text-emerald-400 font-bold">+ # 100% launched: permanent mainline code</span>\n' +
							'<span class="text-emerald-400 font-bold">+ run_new_experience()</span>';
					}
				},
				getCleanCode() {
					if (this.flagStatus === 'DEAD_FLAG') {
						if (this.cleanupLang === 'go') return 'doFallbackWork()';
						if (this.cleanupLang === 'ts') return 'executeFallback();';
						return 'run_default_feature()';
					}
					if (this.cleanupLang === 'go') return 'renderNewExperience()';
					if (this.cleanupLang === 'ts') return 'renderNewUI();';
					return 'run_new_experience()';
				},
				copyDiffSnippet() {
					navigator.clipboard.writeText(this.getCleanCode());
					this.copiedDiff = true;
					setTimeout(() => this.copiedDiff = false, 2000);
				},
				async deleteFlag(key) {
					if (!confirm(`Permanently delete feature flag '${key}' from database?`)) return;
					try {
						const res = await fetch('/api/v1/flags/' + key, { method: 'DELETE' });
						if (res.ok) {
							this.closeModal();
							window.location.reload();
						} else {
							alert('Failed to delete flag: ' + (await res.text()));
						}
					} catch (e) {
						alert('Network error: ' + e.message);
					}
				}
			}));
		});

		window.openHygieneModal = function(data) {
			window.dispatchEvent(new CustomEvent('open-hygiene-modal', { detail: data }));
		};
	</script>
}
