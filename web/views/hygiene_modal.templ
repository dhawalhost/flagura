package views

templ HygieneModal() {
	<div
		x-data="hygieneModalComponent()"
		@open-hygiene-modal.window="openModal($event.detail)"
		x-show="isOpen"
		x-cloak
		class="fixed inset-0 z-50 overflow-y-auto bg-scrim/40 flex items-center justify-center p-4"
	>
		<div
			@click.away="closeModal()"
			class="bg-surface rounded-md max-w-2xl w-full border border-neutral-200 shadow-2xl overflow-hidden transition-colors max-h-[90vh] flex flex-col"
		>
			<!-- Header -->
			<div class="px-6 py-5 border-b border-neutral-100 bg-surface flex items-center justify-between">
				<div class="flex items-center gap-3">
					<div 
						class="h-10 w-10 rounded-md flex items-center justify-center border"
						:class="flagStatus === 'DEAD_FLAG' ? 'bg-danger-50 border-danger-200 text-danger-600' : 'bg-warn-50 border-warn-200 text-warn-600'"
					>
						<i :data-lucide="flagStatus === 'DEAD_FLAG' ? 'alert-triangle' : 'sparkles'" class="h-5 w-5"></i>
					</div>
					<div>
						<div class="flex items-center gap-2">
							<h3 class="font-semibold text-neutral-900 text-base">Automated Code Hygiene &amp; Cleanup</h3>
							<span class="px-2 py-0.5 rounded text-2xs font-mono font-medium bg-neutral-100 text-neutral-800 border border-neutral-200" x-text="flagKey"></span>
						</div>
						<p class="text-xs text-neutral-500 font-sans">Eliminate dead branching code and reduce architectural tech debt</p>
					</div>
				</div>

				<button
					@click="closeModal()"
					class="p-2 text-neutral-400 hover:text-neutral-700 rounded-md hover:bg-neutral-100 transition cursor-pointer"
				>
					<i data-lucide="x" class="h-5 w-5"></i>
				</button>
			</div>

			<!-- Body -->
			<div class="p-4 overflow-y-auto space-y-5 flex-1 text-xs">
				<!-- Diagnostic Card -->
				<div 
					class="p-4 rounded-md border space-y-2"
					:class="flagStatus === 'DEAD_FLAG' ? 'bg-danger-50/60 border-danger-200 text-danger-950' : 'bg-warn-50/60 border-warn-200 text-warn-950'"
				>
					<div class="flex items-center justify-between">
						<span class="font-medium text-2xs flex items-center gap-1.5">
							<span class="inline-block w-2 h-2 rounded-full" :class="flagStatus === 'DEAD_FLAG' ? 'bg-danger-500' : 'bg-warn-500'"></span>
							<span x-text="flagStatus === 'DEAD_FLAG' ? 'Dead Flag Detected' : 'Ready for Code Cleanup (Stale)'"></span>
						</span>
						<span class="text-2xs font-medium px-2 py-0.5 rounded bg-surface border border-neutral-200 text-neutral-700 font-mono" x-text="flagStatus === 'DEAD_FLAG' ? '0% Traffic' : '100% Launched'"></span>
					</div>
					<p class="text-xs text-neutral-700 font-sans leading-relaxed" x-text="flagReason"></p>
					<div class="text-2xs font-sans font-semibold text-neutral-600 flex items-center gap-1.5 pt-1 border-t border-neutral-200/60">
						<span>Suggested Action:</span>
						<span class="text-neutral-900" x-text="flagAction"></span>
					</div>
				</div>

				<!-- Code Refactoring Clean-up Diff -->
				<div class="space-y-3">
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<i data-lucide="code-2" class="w-4 h-4 text-accent-600"></i>
							<span class="font-medium text-neutral-800 text-2xs">Recommended Code Cleanup</span>
						</div>
						
						<!-- Language Switcher -->
						<div class="flex items-center gap-1 bg-neutral-100 p-1 rounded-md border border-neutral-200 text-2xs">
							<button
								@click="cleanupLang = 'go'"
								class="px-2.5 py-1 rounded font-medium transition cursor-pointer"
								:class="cleanupLang === 'go' ? 'bg-neutral-900 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								Go
							</button>
							<button
								@click="cleanupLang = 'ts'"
								class="px-2.5 py-1 rounded font-medium transition cursor-pointer"
								:class="cleanupLang === 'ts' ? 'bg-neutral-900 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								TypeScript
							</button>
							<button
								@click="cleanupLang = 'py'"
								class="px-2.5 py-1 rounded font-medium transition cursor-pointer"
								:class="cleanupLang === 'py' ? 'bg-neutral-900 text-surface' : 'text-neutral-600 hover:text-neutral-900'"
							>
								Python
							</button>
						</div>
					</div>

					<!-- Refactoring Diff Window -->
					<div class="rounded-md border border-neutral-800 bg-neutral-900 overflow-hidden code-scope">
						<div class="px-4 py-2.5 bg-neutral-950 border-b border-neutral-800 flex items-center justify-between text-2xs text-neutral-400 code-scope">
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-danger-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-warn-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-ok-500/80"></span>
								<span class="ml-2 font-mono">Refactor Diff — Remove Conditional Flag Branch</span>
							</div>
							<button
								@click="copyDiffSnippet()"
								class="text-accent-400 hover:text-accent-300 transition flex items-center gap-1 cursor-pointer"
							>
								<i data-lucide="copy" class="w-3 h-3"></i>
								<span x-text="copiedDiff ? 'Copied!' : 'Copy Code'"></span>
							</button>
						</div>
						<pre class="p-4 text-xs font-mono leading-relaxed overflow-x-auto text-neutral-200" x-ref="diffBox" x-effect="renderDiff()"></pre>
					</div>
				</div>

				<!-- Debt Prevention Tip -->
				<div class="p-3.5 rounded-md bg-neutral-50 border border-neutral-200 text-neutral-600 text-2xs font-sans flex items-start gap-2.5">
					<i data-lucide="shield-check" class="w-4 h-4 text-ok-600 shrink-0 mt-0.5"></i>
					<div>
						<strong class="text-neutral-800 font-mono">Why clean up this flag?</strong>
						<p class="mt-0.5 leading-relaxed">
							Flags with 100% rollout generate unnecessary CPU branch evaluations and clutter tests. Removing the conditional check turns your feature into permanent mainline code.
						</p>
					</div>
				</div>
			</div>

			<!-- Footer -->
			<div class="px-6 py-4 border-t border-neutral-100 bg-neutral-50 flex items-center justify-between">
				<button
					@click="deleteFlag(flagKey)"
					class="px-3.5 py-2 rounded-md text-xs font-medium text-danger-600 hover:bg-danger-50 border border-danger-200 transition cursor-pointer flex items-center gap-1.5"
				>
					<i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
					<span>Delete Flag from Console</span>
				</button>

				<button
					@click="closeModal()"
					class="px-4 py-2 rounded-md text-xs font-medium bg-neutral-200 hover:bg-neutral-300 text-neutral-800 transition cursor-pointer"
				>
					Close
				</button>
			</div>
		</div>
	</div>
}
