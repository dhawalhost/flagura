package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
)

func resolveDashboardTitle(titles []string) string {
	if len(titles) > 0 && titles[0] != "" {
		return titles[0]
	}
	return "Developer Console"
}

templ Dashboard(user *domain.User, flags []domain.FeatureFlag, auditLogs []domain.AuditLogEntry, changeRequests []domain.ChangeRequest, driverName string, orgs []domain.Organization, projects []domain.Project, activeProjectID string, title ...string) {
	@Layout(resolveDashboardTitle(title)) {
		<div class="min-h-screen flex bg-shell text-neutral-900 relative">
			<!-- Docked Left Sidebar -->
			<div x-show="isMobileSidebarOpen" @click="isMobileSidebarOpen = false" class="fixed inset-0 z-30 bg-scrim/40 lg:hidden" x-cloak></div>
				@Sidebar(user, flags, auditLogs, orgs, projects, activeProjectID)

			<!-- Main Content Viewport -->
			<div class="app-sheet flex-1 flex flex-col min-w-0">
				<!-- Docked Top Header Bar -->
				@HeaderBar(user, flags, "production")

				<!-- Wide-Canvas Fluid Workspace -->
				<main class="flex-1 p-4 sm:p-6 max-w-[1600px] mx-auto w-full space-y-5">
					<h1 class="page-title" x-text="getViewTitle()">Overview</h1>
					@BentoOverview(flags, auditLogs, changeRequests, driverName)

					<!-- VIEW 2: Flags & Rollouts Matrix (Split-Pane Master-Detail Inspector) -->
					@FlagMatrix(flags)

					<!-- VIEW 3: Dedicated Analytics & Telemetry -->
					@AnalyticsDashboard(flags)

					<!-- VIEW 4: Live Evaluation Sandbox -->
					@LiveEvaluator(flags)

					<!-- VIEW 5: Latency Benchmark Suite -->
					@BenchmarkModal()

					<!-- VIEW 6: Audit Logs Trail -->
					@AuditModal(auditLogs)

					<!-- VIEW 7: SDK Integration & API -->
					@SDKModal()

					<!-- VIEW 7b: API Keys -->
					@APIKeysPage()

					<!-- VIEW 8: Flag Editor & Rule Creator -->
					@FlagEditorModal()

					<!-- VIEW 9: A/B Testing & Statistical Experimentation -->
					@ExperimentModal()

					<!-- VIEW 10: 4-Eyes Change Governance Approvals -->
					@GovernanceModal(user, changeRequests)

					<!-- VIEW 11: Project & Workspace Modal -->
					@ProjectModal(orgs, projects, activeProjectID)

					<!-- VIEW 12: Automated Code Hygiene & Cleanup Modal -->
					@HygieneModal()

					<!-- VIEW 13: Profile & Account Settings -->
					@ProfileSettings(user, orgs, projects)

					@ToggleConfirm()
				</main>
			</div>
		</div>
	}
}

// ToggleConfirm asks before a change that reaches production traffic.
templ ToggleConfirm() {
	<div
		id="toggle-confirm"
		x-show="confirmOpen"
		x-cloak
		role="dialog"
		aria-modal="true"
		aria-labelledby="toggle-confirm-title"
		@keydown.escape.window="cancelToggle()"
		@click.self="cancelToggle()"
		@click.stop
		class="fixed inset-0 z-50 bg-scrim/40 flex items-center justify-center p-4"
	>
		<div class="panel shadow-pop w-full max-w-sm p-4 space-y-3">
			<h2 id="toggle-confirm-title" class="text-base text-neutral-900" x-text="confirmTitle"></h2>
			<p class="text-sm text-neutral-600" x-text="confirmBody"></p>
			<div class="flex justify-end gap-2 pt-1">
				<button type="button" @click="cancelToggle()" class="btn">Cancel</button>
				<button type="button" @click="confirmToggleNow()" class="btn btn-primary" x-text="confirmAction"></button>
			</div>
		</div>
	</div>
}
