package views

import (
	"github.com/dhawalhost/flagura/pkg/domain"
	"fmt"
)

templ BentoOverview(flags []domain.FeatureFlag, audits []domain.AuditLogEntry, driverName string) {
	<div class="space-y-6" x-show="activeView === 'overview'" x-cloak x-data="bentoEnterpriseDashboardComponent()">

		<!-- Top Enterprise KPI Metric Cards -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<!-- Total Flags Card -->
			<div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-2">
				<div class="flex items-center justify-between text-slate-500 font-mono text-xs">
					<span class="font-semibold uppercase tracking-wider text-[10px]">Total Feature Flags</span>
					<div class="p-1.5 rounded-lg bg-indigo-50 text-indigo-600">
						<i data-lucide="flag" class="w-4 h-4"></i>
					</div>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-2xl font-extrabold text-slate-900 font-mono">{ fmt.Sprintf("%d", len(flags)) }</span>
					<span class="text-xs text-slate-500 font-mono">managed flags</span>
				</div>
				<div class="text-[11px] text-slate-500 font-sans flex items-center gap-1.5 pt-1 border-t border-slate-100">
					<span class="text-indigo-600 font-bold font-mono">100% Sync</span>
					<span>across all environments</span>
				</div>
			</div>

			<!-- Production Active Card -->
			<div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-2">
				<div class="flex items-center justify-between text-slate-500 font-mono text-xs">
					<span class="font-semibold uppercase tracking-wider text-[10px]">Active in Production</span>
					<div class="p-1.5 rounded-lg bg-emerald-50 text-emerald-600">
						<i data-lucide="check-circle-2" class="w-4 h-4"></i>
					</div>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-2xl font-extrabold text-emerald-700 font-mono" x-text="activeProdCount"></span>
					<span class="text-xs text-slate-500 font-mono">circuits live</span>
				</div>
				<div class="text-[11px] text-slate-500 font-sans flex items-center gap-1.5 pt-1 border-t border-slate-100">
					<span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
					<span>Non-blocking evaluated</span>
				</div>
			</div>

			<!-- Stale Flags Cleanup Card -->
			<div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-2">
				<div class="flex items-center justify-between text-slate-500 font-mono text-xs">
					<span class="font-semibold uppercase tracking-wider text-[10px]">Stale Flags (Cleanup)</span>
					<div class="p-1.5 rounded-lg bg-amber-50 text-amber-600">
						<i data-lucide="sparkles" class="w-4 h-4"></i>
					</div>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-2xl font-extrabold text-amber-700 font-mono" x-text="staleCount"></span>
					<span class="text-xs text-slate-500 font-mono">100% launched</span>
				</div>
				<div class="text-[11px] text-slate-500 font-sans flex items-center gap-1.5 pt-1 border-t border-slate-100">
					<span class="text-amber-700 font-semibold">Action:</span>
					<span>Ready to archive safely</span>
				</div>
			</div>

			<!-- Evaluation Speed / Latency -->
			<div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs space-y-2">
				<div class="flex items-center justify-between text-slate-500 font-mono text-xs">
					<span class="font-semibold uppercase tracking-wider text-[10px]">Avg In-Process Latency</span>
					<div class="p-1.5 rounded-lg bg-sky-50 text-sky-600">
						<i data-lucide="zap" class="w-4 h-4"></i>
					</div>
				</div>
				<div class="flex items-baseline gap-2">
					<span class="text-2xl font-extrabold text-slate-900 font-mono">85ns</span>
					<span class="text-xs text-emerald-700 font-mono font-bold">0 bytes alloc</span>
				</div>
				<div class="text-[11px] text-slate-500 font-sans flex items-center gap-1.5 pt-1 border-t border-slate-100">
					<span class="text-indigo-600 font-bold font-mono">FNV-1a</span>
					<span>64-bit deterministic hash</span>
				</div>
			</div>
		</div>

		<!-- Main 2-Column Enterprise Layout -->
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
			
			<!-- Left 7 Cols: Quick Feature Flags Directory -->
			<div class="lg:col-span-7 bg-white rounded-xl border border-slate-200 shadow-xs flex flex-col overflow-hidden">
				<div class="p-4 border-b border-slate-100 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<i data-lucide="layers" class="w-4 h-4 text-indigo-600"></i>
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 font-mono">Production Flags Matrix</h3>
					</div>
					<button 
						@click="activeView = 'flags'" 
						class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 font-mono flex items-center gap-1 cursor-pointer"
					>
						<span>View Full Matrix</span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
					</button>
				</div>

				<div class="overflow-x-auto flex-1">
					<table class="w-full text-left text-xs">
						<thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-mono text-[10px] uppercase">
							<tr>
								<th class="py-2.5 px-4">Flag Key</th>
								<th class="py-2.5 px-3">Production Status</th>
								<th class="py-2.5 px-3">Type</th>
								<th class="py-2.5 px-4 text-right">Quick Toggle</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 font-mono">
							for i, f := range flags {
								if i < 7 {
									<tr 
										class="hover:bg-slate-50 transition-colors"
										x-data={ fmt.Sprintf("{ envs: %s, get isProd() { return (this.envs && this.envs.production && this.envs.production.enabled) || false; }, get prodPct() { return (this.envs && this.envs.production && this.envs.production.percentage !== undefined ? this.envs.production.percentage : 0); } }", f.EnvironmentsJSON()) }
									>
										<td class="py-3 px-4">
											<div class="font-bold text-slate-900">{ f.Key }</div>
											<div class="text-[11px] text-slate-500 font-sans truncate max-w-xs">{ f.Name }</div>
										</td>
										<td class="py-3 px-3">
											<span 
												class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold border"
												:class="isProd ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-red-50 text-red-700 border-red-200'"
												x-text="isProd ? (prodPct < 100 ? 'Canary ' + prodPct + '%' : 'Enabled 100%') : 'Disabled'"
											></span>
										</td>
										<td class="py-3 px-3">
											<span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[10px] uppercase font-bold border border-slate-200">
												{ f.Type }
											</span>
										</td>
										<td class="py-3 px-4 text-right">
											<button
												@click.stop={ fmt.Sprintf("const next = !isProd; if (!envs.production) envs.production = {}; envs.production.enabled = next; toggleFlagEnvStatus('%s', 'production', next);", f.Key) }
												class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
												:class="isProd ? 'bg-emerald-600' : 'bg-slate-200'"
											>
												<span 
													class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
													:class="isProd ? 'translate-x-3' : 'translate-x-0'"
												></span>
											</button>
										</td>
									</tr>
								}
							}
							if len(flags) == 0 {
								<tr>
									<td colspan="4" class="p-8 text-center text-slate-500 font-sans">
										No flags created yet.
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Right 5 Cols: Audit Log Activity Stream -->
			<div class="lg:col-span-5 bg-white rounded-xl border border-slate-200 shadow-xs flex flex-col overflow-hidden">
				<div class="p-4 border-b border-slate-100 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<i data-lucide="shield-check" class="w-4 h-4 text-purple-600"></i>
						<h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 font-mono">Recent Governance &amp; Audits</h3>
					</div>
					<button 
						@click="activeView = 'audit'" 
						class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 font-mono flex items-center gap-1 cursor-pointer"
					>
						<span>Full Log</span>
						<i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
					</button>
				</div>

				<div class="p-4 space-y-3 flex-1 overflow-y-auto max-h-[380px] font-mono text-xs">
					for i, a := range audits {
						if i < 6 {
							<div class="p-3 rounded-lg bg-slate-50 border border-slate-200 space-y-1 hover:bg-slate-100/80 transition-colors">
								<div class="flex items-center justify-between">
									<span class="font-bold text-slate-900">{ a.FlagKey }</span>
									<span class="text-[10px] text-slate-400">{ a.Timestamp.Format("15:04:05") }</span>
								</div>
								<div class="flex items-center gap-2 text-[11px] text-slate-600 font-sans">
									<span class="font-semibold text-indigo-600 font-mono">{ string(a.Action) }</span>
									<span>by</span>
									<span class="font-mono text-slate-700">{ a.Actor }</span>
								</div>
							</div>
						}
					}
					if len(audits) == 0 {
						<div class="py-10 text-center text-slate-400 font-sans">
							No recent audit events recorded.
						</div>
					}
				</div>
			</div>
		</div>

		<!-- Environments Status Strip -->
		<div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs font-mono text-xs">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<span class="font-bold text-slate-800 uppercase tracking-wider text-[11px]">Sync Channels:</span>
					<div class="flex items-center gap-2">
						<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-[11px]">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
							Development (Active)
						</span>
						<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-50 text-amber-800 border border-amber-200 font-bold text-[11px]">
							<span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
							Staging (Active)
						</span>
						<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold text-[11px]">
							<span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
							Production (Active)
						</span>
					</div>
				</div>
				<div class="text-[11px] text-slate-500 font-sans">
					Monotonic revision protocol v2.0 • In-memory ring buffer
				</div>
			</div>
		</div>
	</div>
}
