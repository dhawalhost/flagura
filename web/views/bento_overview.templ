package views

import (
	"fmt"
	"github.com/dhawalhost/flagura/pkg/domain"
	"time"
)

type envSummary struct {
	Name    string
	Enabled int
	Partial int
	Off     int
}

func isPartialRollout(cfg domain.EnvironmentConfig) bool {
	return cfg.Enabled && cfg.Strategy == domain.StrategyPercentage && cfg.Percentage < 100
}

func summarizeEnvironments(flags []domain.FeatureFlag) []envSummary {
	envs := []string{"production", "staging", "development"}
	summaries := make([]envSummary, 0, len(envs))
	for _, env := range envs {
		summary := envSummary{Name: env}
		for _, f := range flags {
			cfg := f.EnvConfig(env)
			switch {
			case !cfg.Enabled:
				summary.Off++
			case isPartialRollout(cfg):
				summary.Partial++
				summary.Enabled++
			default:
				summary.Enabled++
			}
		}
		summaries = append(summaries, summary)
	}
	return summaries
}

func changesInLastDay(audits []domain.AuditLogEntry) int {
	cutoff := time.Now().Add(-24 * time.Hour)
	count := 0
	for _, a := range audits {
		if a.Timestamp.After(cutoff) {
			count++
		}
	}
	return count
}

templ overviewMetric(label string, metric string, value int) {
	<div class="px-4 py-3">
		<div class="text-xs text-neutral-500">{ label }</div>
		<div class="mt-0.5 text-2xl font-semibold font-mono text-neutral-900" data-metric={ metric }>{ fmt.Sprintf("%d", value) }</div>
	</div>
}

templ BentoOverview(flags []domain.FeatureFlag, audits []domain.AuditLogEntry, driverName string) {
	{{ prod := summarizeEnvironments(flags)[0] }}
	<div class="space-y-4" x-show="activeView === 'overview'" x-cloak>
		<div class="panel grid grid-cols-2 lg:grid-cols-4 divide-x divide-neutral-200">
			@overviewMetric("Flags", "total", len(flags))
			@overviewMetric("On in production", "enabled", prod.Enabled)
			<div class="border-t border-neutral-200 lg:border-t-0">
				@overviewMetric("Partial rollouts", "partial", prod.Partial)
			</div>
			<div class="border-t border-neutral-200 lg:border-t-0">
				@overviewMetric("Changes, last 24h", "changes", changesInLastDay(audits))
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
			<section class="lg:col-span-8 panel flex flex-col overflow-hidden">
				<div class="px-4 py-2.5 border-b border-neutral-200 flex items-center justify-between">
					<h3 class="text-sm text-neutral-900">Production flags</h3>
					<button @click="navigateTo('flags')" class="text-xs text-accent-600 hover:underline cursor-pointer">All flags</button>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead class="border-b border-neutral-200 text-xs text-neutral-500">
							<tr>
								<th class="py-2 px-4 font-normal">Key</th>
								<th class="py-2 px-3 font-normal">State</th>
								<th class="py-2 px-3 font-normal hidden sm:table-cell">Type</th>
								<th class="py-2 px-4 font-normal text-right">Toggle</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100">
							for i, f := range flags {
								if i < 7 {
									<tr 
										class="hover:bg-neutral-50 transition-colors"
										x-data="flagRowComponent()"
										data-key={ f.Key }
										data-envs={ f.EnvironmentsJSON() }
									>
										<td class="py-2 px-4">
											<div class="font-mono text-neutral-900">{ f.Key }</div>
											<div class="text-xs text-neutral-500 truncate max-w-[9rem] sm:max-w-xs">{ f.Name }</div>
										</td>
										<td class="py-2 px-3 whitespace-nowrap">
											<span 
												class="text-xs font-medium"
												:class="isProd ? (prodPct < 100 ? 'text-warn-700' : 'text-ok-700') : 'text-neutral-500'"
												x-text="isProd ? (prodPct < 100 ? 'On, ' + prodPct + '%' : 'On') : 'Off'"
											></span>
										</td>
										<td class="py-2 px-3 hidden sm:table-cell font-mono text-xs text-neutral-500">{ f.Type }</td>
										<td class="py-2 px-4 text-right">
											<button
												@click.stop="toggleProd"
												aria-label={ "Toggle " + f.Key + " in production" }
												class="relative inline-flex h-4 w-7 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-150"
												:class="isProd ? 'bg-ok-600' : 'bg-neutral-300'"
											>
												<span 
													class="pointer-events-none inline-block h-3 w-3 transform rounded-full bg-surface transition duration-150"
													:class="isProd ? 'translate-x-3' : 'translate-x-0'"
												></span>
											</button>
										</td>
									</tr>
								}
							}
							if len(flags) == 0 {
								<tr>
									<td colspan="4" class="p-6 text-center text-neutral-500">No flags yet. Create one to get started.</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>

			<section class="lg:col-span-4 panel flex flex-col overflow-hidden">
				<div class="px-4 py-2.5 border-b border-neutral-200 flex items-center justify-between">
					<h3 class="text-sm text-neutral-900">Recent changes</h3>
					<button @click="navigateTo('audit')" class="text-xs text-accent-600 hover:underline cursor-pointer">Audit trail</button>
				</div>
				<ul class="divide-y divide-neutral-100 overflow-y-auto max-h-[380px]">
					for i, a := range audits {
						if i < 6 {
							<li class="px-4 py-2">
								<div class="flex items-center justify-between gap-2">
									<span class="font-mono text-sm text-neutral-900 truncate">{ a.FlagKey }</span>
									<span class="font-mono text-2xs text-neutral-400 shrink-0">{ a.Timestamp.Format("15:04:05") }</span>
								</div>
								<div class="text-xs text-neutral-500 truncate">
									<span class="font-mono">{ string(a.Action) }</span> by { a.Actor }
								</div>
							</li>
						}
					}
					if len(audits) == 0 {
						<li class="p-6 text-center text-neutral-500">No changes recorded yet.</li>
					}
				</ul>
			</section>
		</div>

		<section class="panel overflow-x-auto">
			<table class="w-full text-left text-sm">
				<thead class="border-b border-neutral-200 text-xs text-neutral-500">
					<tr>
						<th class="py-2 px-4 font-normal">Environment</th>
						<th class="py-2 px-3 font-normal text-right">On</th>
						<th class="py-2 px-3 font-normal text-right">Partial</th>
						<th class="py-2 px-4 font-normal text-right">Off</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-neutral-100 font-mono">
					for _, env := range summarizeEnvironments(flags) {
						<tr>
							<td class="py-2 px-4 text-neutral-900">{ env.Name }</td>
							<td class="py-2 px-3 text-right text-neutral-700">{ fmt.Sprintf("%d", env.Enabled) }</td>
							<td class="py-2 px-3 text-right text-neutral-700">{ fmt.Sprintf("%d", env.Partial) }</td>
							<td class="py-2 px-4 text-right text-neutral-700">{ fmt.Sprintf("%d", env.Off) }</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	</div>
}
