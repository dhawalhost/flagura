package views

templ LandingPage() {
	@Layout("Sub-Microsecond Feature Flags at Edge") {
		<div class="min-h-screen bg-[#FAFAFA] text-slate-900 relative selection:bg-indigo-100 selection:text-indigo-900 overflow-x-hidden font-sans" x-data="landingPageComponent()">

			<!-- Floating Pill Header -->
			<header class="fixed top-4 inset-x-0 z-50 max-w-6xl mx-auto px-4 sm:px-6">
				<div class="glass-panel px-5 py-3 flex items-center justify-between shadow-sm bg-white/90 backdrop-blur-xl border border-slate-200/90 rounded-2xl">
					<!-- Brand -->
					<a href="/" class="flex items-center gap-3 group">
						<div class="h-8 w-8 rounded-xl p-0.5 bg-gradient-to-br from-indigo-500 via-sky-500 to-emerald-500 shadow-xs group-hover:scale-105 transition-transform duration-300">
							<img src="/static/img/flagura-logo.png" alt="Flagura" class="h-full w-full rounded-[10px] object-cover" />
						</div>
						<div class="flex flex-col">
							<span class="font-display font-extrabold text-slate-900 text-base tracking-tight leading-none flex items-center gap-1.5">
								Flagura
								<span class="text-[9px] font-mono text-indigo-600 font-bold bg-indigo-50 px-1.5 py-0.5 rounded border border-indigo-200">v2.0</span>
							</span>
						</div>
					</a>

					<!-- Nav Links -->
					<nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-600">
						<a href="#section-hero" class="hover:text-slate-900 transition-colors">Switchboard</a>
						<a href="#section-bento" class="hover:text-slate-900 transition-colors">Core Wedges</a>
						<a href="#section-benchmark" class="hover:text-slate-900 transition-colors">Live Benchmark</a>
						<a href="/api/v1/flags" class="hover:text-slate-900 transition-colors">API Docs</a>
						<a href="https://github.com/dhawalhost/flagura" target="_blank" class="flex items-center gap-1 hover:text-slate-900 transition-colors">
							<i data-lucide="github" class="h-3.5 w-3.5"></i>
							<span>GitHub</span>
						</a>
					</nav>

					<!-- Action Buttons -->
					<div class="flex items-center gap-2.5 font-mono">
						<!-- Audio Synthesizer Toggle -->
						<button 
							@click="toggleAudio()" 
							class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition cursor-pointer"
							:title="audioMuted ? 'Unmute Audio UI' : 'Mute Audio UI'"
						>
							<i data-lucide="volume-2" class="h-3.5 w-3.5 text-emerald-600" x-show="!audioMuted"></i>
							<i data-lucide="volume-x" class="h-3.5 w-3.5 text-slate-400" x-show="audioMuted"></i>
						</button>

						<a 
							href="/dashboard"
							class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-all shadow-sm hover:shadow flex items-center gap-1.5 cursor-pointer hover:scale-[1.02]"
						>
							<span>Open Dashboard</span>
							<i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
						</a>
					</div>
				</div>
			</header>

			<!-- Main Content Space -->
			<main class="pt-28 pb-20 space-y-24">

				<!-- 1. HERO SECTION & HOLOGRAPHIC CONSOLE -->
				<section id="section-hero" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
					<div class="text-center max-w-4xl mx-auto space-y-6 pt-8">
						<!-- Pill Badge -->
						<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-mono font-bold shadow-xs">
							<span class="flex h-2 w-2 relative">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
							</span>
							<span>ZERO FLAG DEBT • 4-EYES GOVERNANCE • SUB-MICROSECOND EDGE</span>
						</div>

						<!-- Massive Kinetic Typography -->
						<h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.08]">
							Feature flags engineered for clean code and zero PII leakage.
						</h1>

						<p class="text-base sm:text-xl text-slate-600 font-sans max-w-2xl mx-auto leading-relaxed">
							Sub-microsecond in-process evaluations, built-in stale flag hygiene, and peer-reviewed change governance — without the per-MAU billing trap.
						</p>

						<!-- Hero Action Buttons -->
						<div class="flex flex-wrap items-center justify-center gap-4 pt-2 font-mono">
							<a 
								href="/dashboard"
								class="px-6 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm transition-all shadow-sm hover:shadow flex items-center gap-2 cursor-pointer hover:scale-[1.02]"
							>
								<span>Launch Live Console</span>
								<i data-lucide="arrow-right" class="h-4 w-4"></i>
							</a>

							<a 
								href="#section-bento"
								class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm border border-slate-200 shadow-xs flex items-center gap-2 transition cursor-pointer"
							>
								<i data-lucide="sparkles" class="h-4 w-4 text-indigo-600"></i>
								<span>Explore Core Wedges</span>
							</a>
						</div>
					</div>

					<!-- Strategic Wedge KPI Cards (4 Pillars) -->
					<div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto font-mono">
						<div class="glass-panel p-5 text-center space-y-1 bg-white border border-slate-200 shadow-xs">
							<div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Flag Hygiene</div>
							<div class="text-2xl font-extrabold text-amber-600 mt-1 font-display">0 Flag Debt</div>
							<div class="text-[10px] text-slate-400">Active stale flag detection</div>
						</div>
						<div class="glass-panel p-5 text-center space-y-1 bg-white border border-slate-200 shadow-xs">
							<div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Release Safety</div>
							<div class="text-2xl font-extrabold text-purple-600 mt-1 font-display">4-Eyes</div>
							<div class="text-[10px] text-slate-400">Peer dual reviews for prod</div>
						</div>
						<div class="glass-panel p-5 text-center space-y-1 bg-white border border-slate-200 shadow-xs">
							<div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">Customer Privacy</div>
							<div class="text-2xl font-extrabold text-sky-600 mt-1 font-display">Zero Egress</div>
							<div class="text-[10px] text-slate-400">PII never leaves your host</div>
						</div>
						<div class="glass-panel p-5 text-center space-y-1 bg-white border border-slate-200 shadow-xs">
							<div class="text-[11px] text-slate-500 uppercase tracking-wider font-semibold">In-Memory Speed</div>
							<div class="text-2xl font-extrabold text-emerald-600 mt-1 font-display">~85 ns</div>
							<div class="text-[10px] text-slate-400">0 heap allocations / op</div>
						</div>
					</div>

					<!-- Interactive Holographic Console (Switchboard & Code Preview) -->
					<div class="max-w-5xl mx-auto glass-panel p-6 sm:p-8 bg-white border border-slate-200 shadow-md space-y-6">
						<!-- Console Header Tabs -->
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
							<div class="flex items-center gap-3">
								<div class="flex items-center gap-1.5">
									<div class="w-3 h-3 rounded-full bg-red-400"></div>
									<div class="w-3 h-3 rounded-full bg-amber-400"></div>
									<div class="w-3 h-3 rounded-full bg-emerald-400"></div>
								</div>
								<span class="text-xs font-mono font-bold text-slate-900">flagura-edge-switchboard</span>
							</div>

							<!-- Mode Switcher -->
							<div class="flex items-center gap-2 font-mono text-xs">
								<button 
									@click="consoleMode = 'switchboard'"
									class="px-3 py-1.5 rounded-xl transition cursor-pointer font-bold"
									:class="consoleMode === 'switchboard' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 bg-slate-100'"
								>
									⚡ Live Switchboard
								</button>
								<button 
									@click="consoleMode = 'code'"
									class="px-3 py-1.5 rounded-xl transition cursor-pointer font-bold"
									:class="consoleMode === 'code' ? 'bg-slate-900 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900 bg-slate-100'"
								>
									💻 SDK Integration
								</button>
							</div>
						</div>

						<!-- Mode 1: Interactive Switchboard -->
						<div x-show="consoleMode === 'switchboard'" class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
							<!-- Left Control Box -->
							<div class="md:col-span-7 space-y-4 font-mono">
								<div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
									<div class="flex items-center justify-between text-xs">
										<span class="text-slate-600 font-semibold">Flag Key:</span>
										<span class="text-indigo-600 font-bold">ai-smart-search</span>
									</div>

									<div>
										<label class="text-[11px] text-slate-500 block mb-1">Target User ID (Context Hash):</label>
										<input 
											type="text" 
											x-model="testUserId" 
											@input="computeHashModulo()"
											class="w-full bg-white border border-slate-200 rounded-xl px-3.5 py-2 text-xs text-slate-900 focus:outline-none focus:border-indigo-500 font-mono shadow-2xs"
											placeholder="usr_alex_42"
										/>
									</div>

									<!-- Rollout Slider -->
									<div class="space-y-1.5 pt-2 border-t border-slate-200">
										<div class="flex items-center justify-between text-xs">
											<span class="text-slate-600">Canary Allocation:</span>
											<span class="font-bold text-indigo-700" x-text="canaryPercent + '%'"></span>
										</div>
										<input 
											type="range" 
											min="0" 
											max="100" 
											step="5" 
											x-model="canaryPercent" 
											@input="computeHashModulo()"
											class="w-full accent-indigo-600 cursor-pointer bg-slate-200"
										/>
									</div>
								</div>
							</div>

							<!-- Right Output Box -->
							<div class="md:col-span-5 p-5 rounded-2xl bg-slate-900 text-slate-100 border border-slate-800 space-y-3 font-mono">
								<div class="text-[11px] text-slate-400 uppercase tracking-wider font-semibold">Deterministic Output</div>
								
								<div class="flex items-center justify-between py-2 border-b border-slate-800">
									<span class="text-xs text-slate-400">FNV-1a Hash:</span>
									<span class="text-xs text-sky-400 font-bold" x-text="computedHashHex"></span>
								</div>

								<div class="flex items-center justify-between py-2 border-b border-slate-800">
									<span class="text-xs text-slate-400">Bucket Index:</span>
									<span class="text-xs text-indigo-400 font-bold" x-text="computedBucket + ' / 100'"></span>
								</div>

								<div class="flex items-center justify-between pt-1">
									<span class="text-xs text-slate-400">Resolved State:</span>
									<span 
										class="px-2.5 py-1 rounded-full text-xs font-bold font-mono"
										:class="isEvaluatedTrue ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' : 'bg-red-500/20 text-red-400 border border-red-500/40'"
										x-text="isEvaluatedTrue ? 'ENABLED (ON)' : 'DISABLED (OFF)'"
									></span>
								</div>

								<div class="text-[10px] text-slate-500 text-center pt-2">
									Evaluated in 84ns • 0 heap allocs
								</div>
							</div>
						</div>

						<!-- Mode 2: Multi-Language SDK Code Playground -->
						<div x-show="consoleMode === 'code'" class="space-y-4 font-mono">
							<!-- Language Tabs -->
							<div class="flex items-center gap-2 border-b border-slate-100 pb-3 text-xs overflow-x-auto">
								<button 
									@click="sdkLanguage = 'go'"
									class="px-3 py-1.5 rounded-lg transition cursor-pointer font-bold"
									:class="sdkLanguage === 'go' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'text-slate-600 hover:text-slate-900'"
								>
									Go
								</button>
								<button 
									@click="sdkLanguage = 'ts'"
									class="px-3 py-1.5 rounded-lg transition cursor-pointer font-bold"
									:class="sdkLanguage === 'ts' ? 'bg-sky-50 text-sky-700 border border-sky-200' : 'text-slate-600 hover:text-slate-900'"
								>
									TypeScript
								</button>
								<button 
									@click="sdkLanguage = 'python'"
									class="px-3 py-1.5 rounded-lg transition cursor-pointer font-bold"
									:class="sdkLanguage === 'python' ? 'bg-amber-50 text-amber-700 border border-amber-200' : 'text-slate-600 hover:text-slate-900'"
								>
									Python
								</button>
								<button 
									@click="sdkLanguage = 'rust'"
									class="px-3 py-1.5 rounded-lg transition cursor-pointer font-bold"
									:class="sdkLanguage === 'rust' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'text-slate-600 hover:text-slate-900'"
								>
									Rust
								</button>
								<button 
									@click="sdkLanguage = 'curl'"
									class="px-3 py-1.5 rounded-lg transition cursor-pointer font-bold"
									:class="sdkLanguage === 'curl' ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'text-slate-600 hover:text-slate-900'"
								>
									cURL
								</button>
							</div>

							<!-- Code Block -->
							<div class="p-5 rounded-2xl bg-slate-900 text-slate-100 border border-slate-800 text-xs overflow-x-auto leading-relaxed font-mono">
								<template x-if="sdkLanguage === 'go'">
									<pre class="text-emerald-400"><code>{ `package main

import (
    "context"
    "fmt"
    flagura "github.com/dhawalhost/flagura/sdks/go"
)

func main() {
    // In-memory local evaluation (~85ns latency)
    client := flagura.NewClient("https://api.flagura.dev", "flg_live_secret",
        flagura.WithLocalEvaluation(true),
    )
    defer client.Close()

    res, _ := client.Evaluate(context.Background(), "ai-smart-search", flagura.Context{
        UserID: "usr_alex_42",
        Email:  "alex@company.com",
    })

    fmt.Printf("Enabled: %v | Latency: %v ns\n", res.Enabled, res.EvaluationLatencyNs)
}` }</code></pre>
								</template>

								<template x-if="sdkLanguage === 'ts'">
									<pre class="text-sky-300"><code>{ `import { FlaguraClient } from '@flagura/sdk';

// Instant local in-memory evaluation over persistent SSE stream
const client = new FlaguraClient({
  endpoint: 'https://api.flagura.dev',
  apiKey: 'flg_live_secret'
});

const { enabled, variant } = await client.evaluate('ai-smart-search', {
  user_id: 'usr_alex_42',
  email: 'alex@company.com',
});

console.log({ enabled, variant });` }</code></pre>
								</template>

								<template x-if="sdkLanguage === 'python'">
									<pre class="text-amber-300"><code>{ `from flagura import FlaguraClient, EvaluationContext

# Fast local in-process evaluation with zero remote HTTP calls
client = FlaguraClient("https://api.flagura.dev", api_key="flg_live_secret")

res = client.evaluate("ai-smart-search", EvaluationContext(
    user_id="usr_alex_42", 
    email="alex@company.com"
))

print(res.enabled, res.variant)` }</code></pre>
								</template>

								<template x-if="sdkLanguage === 'rust'">
									<pre class="text-rose-300"><code>{ `use flagura::{FlaguraClient, EvaluationContext};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = FlaguraClient::new("https://api.flagura.dev")
        .with_api_key("flg_live_secret");
        
    let ctx = EvaluationContext::new("usr_alex_42").with_email("alex@company.com");

    if client.is_enabled("ai-smart-search", &ctx).await {
        println!("✨ AI Smart Search is active!");
    }
    Ok(())
}` }</code></pre>
								</template>

								<template x-if="sdkLanguage === 'curl'">
									<pre class="text-purple-300"><code>{ `curl -X POST https://api.flagura.dev/api/v1/evaluate \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer flg_live_secret" \
  -d '{"flags":["ai-smart-search"],"context":{"user_id":"usr_alex_42","email":"alex@company.com"}}'` }</code></pre>
								</template>
							</div>
						</div>
					</div>
				</section>

				<!-- 2. ASYMMETRICAL BENTO FEATURE SHOWCASE -->
				<section id="section-bento" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
					<div class="text-center max-w-3xl mx-auto space-y-4">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-mono font-bold">
							<i data-lucide="layers" class="h-3.5 w-3.5"></i>
							<span>CORE PRODUCT WEDGES &amp; ADVANTAGES</span>
						</div>
						<h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight font-display">
							Built for clean codebases and operational peace of mind.
						</h2>
						<p class="text-slate-600 text-sm sm:text-base font-sans leading-relaxed">
							Why engineering organizations choose Flagura over legacy SaaS and complex multi-container stacks.
						</p>
					</div>

					<!-- Asymmetric 6-Tile Bento Grid -->
					<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
						
						<!-- TILE 1: Zero Flag Debt & Active Hygiene (8 cols) -->
						<div class="lg:col-span-8 glass-panel p-7 sm:p-8 space-y-6 flex flex-col justify-between bg-white border border-slate-200 shadow-xs">
							<div class="space-y-4">
								<div class="flex items-center justify-between border-b border-slate-100 pb-4">
									<div class="flex items-center gap-3">
										<div class="h-10 w-10 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600 border border-amber-200">
											<i data-lucide="sparkles" class="h-5 w-5"></i>
										</div>
										<div>
											<h3 class="text-lg font-bold text-slate-900 font-display">Zero Flag Debt &amp; Dead Flag Graveyard Cleanup</h3>
											<p class="text-xs text-slate-500 font-mono">Automated detection of 100% rolled-out flags</p>
										</div>
									</div>
									<span class="px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-mono font-bold">
										Active Code Hygiene
									</span>
								</div>

								<p class="text-slate-600 text-xs sm:text-sm leading-relaxed font-sans">
									The silent killer of feature flagging is <strong>code rot</strong>: dead flags lingering in codebases for years because nobody knows if deleting them is safe. Flagura continuously audits flags, detects features at 100% rollout, tracks longevity, and guides teams to clean up dead code.
								</p>
							</div>

							<!-- Flag Hygiene Interactive Mock Strip -->
							<div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2.5 font-mono text-xs">
								<div class="flex items-center justify-between">
									<div class="flex items-center gap-2">
										<span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
										<span class="font-bold text-slate-900">ai-smart-search</span>
										<span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-bold">STALE (100% launched)</span>
									</div>
									<span class="text-slate-500 text-[11px]">Active for 48 days</span>
								</div>
								<div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-200/60">
									<span class="text-slate-600 font-sans">Action: Rollout is 100% complete across all environments.</span>
									<span class="text-amber-700 font-bold">Safe to Deprecate</span>
								</div>
							</div>
						</div>

						<!-- TILE 2: 4-Eyes Dual Review Governance (4 cols) -->
						<div class="lg:col-span-4 glass-panel p-7 sm:p-8 space-y-5 flex flex-col justify-between bg-white border border-slate-200 shadow-xs">
							<div class="space-y-3">
								<div class="flex items-center gap-3 border-b border-slate-100 pb-3">
									<div class="h-9 w-9 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 border border-purple-200">
										<i data-lucide="shield-check" class="h-4.5 w-4.5"></i>
									</div>
									<div>
										<h3 class="text-base font-bold text-slate-900 font-display">4-Eyes Governance</h3>
										<p class="text-[11px] text-slate-500 font-mono">PR-Style Release Approvals</p>
									</div>
								</div>

								<p class="text-xs text-slate-600 font-sans leading-relaxed">
									Require senior peer review and two-person sign-off before dangerous flags or kill switches can be toggled in production environments.
								</p>
							</div>

							<div class="p-3.5 rounded-xl bg-purple-50/50 border border-purple-200 text-xs font-mono space-y-1.5">
								<div class="flex items-center justify-between">
									<span class="text-purple-800 font-bold">CR #108 Approval</span>
									<span class="text-[10px] bg-purple-100 text-purple-800 px-1.5 py-0.5 rounded font-bold">PENDING REVIEW</span>
								</div>
								<div class="text-[11px] text-slate-600 font-sans">Dual sign-off enforced • SOC2 Type II audit ready</div>
							</div>
						</div>

						<!-- TILE 3: Zero Customer PII Leakage (4 cols) -->
						<div class="lg:col-span-4 glass-panel p-6 sm:p-7 space-y-4 bg-white border border-slate-200 shadow-xs">
							<div class="flex items-center gap-3 border-b border-slate-100 pb-3">
								<div class="h-9 w-9 rounded-xl bg-sky-50 flex items-center justify-center text-sky-600 border border-sky-200">
									<i data-lucide="lock" class="h-4.5 w-4.5"></i>
								</div>
								<div>
									<h3 class="text-base font-bold text-slate-900 font-display">Zero PII Leakage</h3>
									<p class="text-[11px] text-slate-500 font-mono">Air-Gapped &amp; HIPAA Ready</p>
								</div>
							</div>
							<p class="text-xs text-slate-600 font-sans leading-relaxed">
								Flagura sends compiled targeting schemas to your application. Customer emails, IP addresses, and user IDs never leave host process memory, satisfying strict GDPR, HIPAA, and BaFin data residency rules.
							</p>
							<div class="p-3 rounded-xl bg-sky-50/50 border border-sky-200 text-xs font-mono space-y-1">
								<div class="text-[10px] text-sky-700 uppercase font-semibold">Data Sovereignty:</div>
								<div class="text-sky-800 font-bold">Zero User Context Egress</div>
							</div>
						</div>

						<!-- TILE 4: Sub-Microsecond In-Memory Engine (4 cols) -->
						<div class="lg:col-span-4 glass-panel p-6 sm:p-7 space-y-4 bg-white border border-slate-200 shadow-xs">
							<div class="flex items-center gap-3 border-b border-slate-100 pb-3">
								<div class="h-9 w-9 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 border border-emerald-200">
									<i data-lucide="zap" class="h-4.5 w-4.5"></i>
								</div>
								<div>
									<h3 class="text-base font-bold text-slate-900 font-display">~85ns Local Engine</h3>
									<p class="text-[11px] text-slate-500 font-mono">Zero Network Roundtrips</p>
								</div>
							</div>
							<p class="text-xs text-slate-600 font-sans leading-relaxed">
								Evaluated in CPU L1/L2 cache with 64-bit FNV-1a deterministic sticky hashing. 0 heap allocations, 0 blocking HTTP calls, and zero single points of network failure on critical user paths.
							</p>
							<div class="p-3 rounded-xl bg-emerald-50/50 border border-emerald-200 text-xs font-mono space-y-1">
								<div class="text-[10px] text-emerald-800 uppercase font-semibold">Evaluation Speed:</div>
								<div class="text-emerald-800 font-bold">85ns P99 • 11.7M ops/sec</div>
							</div>
						</div>

						<!-- TILE 5: Automated Circuit Breakers & Tripwires (4 cols) -->
						<div class="lg:col-span-4 glass-panel p-6 sm:p-7 space-y-4 bg-white border border-slate-200 shadow-xs">
							<div class="flex items-center gap-3 border-b border-slate-100 pb-3">
								<div class="h-9 w-9 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600 border border-rose-200">
									<i data-lucide="flame" class="h-4.5 w-4.5"></i>
								</div>
								<div>
									<h3 class="text-base font-bold text-slate-900 font-display">Auto-Tripwire Breaker</h3>
									<p class="text-[11px] text-slate-500 font-mono">P99 Error Budget Protection</p>
								</div>
							</div>
							<p class="text-xs text-slate-600 font-sans leading-relaxed">
								Integrated health monitoring triggers automatic canary rollback within milliseconds if downstream HTTP error rates or crash exceptions spike during a release.
							</p>
							<div class="p-3 rounded-xl bg-rose-50/50 border border-rose-200 text-xs font-mono space-y-1">
								<div class="text-[10px] text-rose-700 uppercase font-semibold">Circuit Threshold:</div>
								<div class="text-rose-700 font-bold">&gt; 1.5% Error Rate = Auto Rollback</div>
							</div>
						</div>

						<!-- TILE 6: Single Binary & No MAU Extortion (12 cols) -->
						<div class="lg:col-span-12 glass-panel p-7 sm:p-8 bg-slate-900 text-slate-100 border border-slate-800 rounded-3xl space-y-4 shadow-md font-mono">
							<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
								<div class="space-y-1">
									<div class="flex items-center gap-2">
										<span class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
											<i data-lucide="server" class="h-4 w-4"></i>
										</span>
										<h3 class="text-base font-bold text-white font-display">Predictable Infrastructure • No MAU Billing Penalties</h3>
									</div>
									<p class="text-xs text-slate-400 font-sans">
										Never get punished for user growth. Evaluate 10,000 requests or 10 billion requests at flat, predictable cost.
									</p>
								</div>
								<div class="flex items-center gap-2">
									<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40">
										Single 15MB Binary
									</span>
									<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-400 border border-indigo-500/40">
										Boots in 10ms
									</span>
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1 text-xs">
								<div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 space-y-1">
									<div class="text-[10px] uppercase text-slate-400 font-semibold">Zero Container Soup</div>
									<div class="text-slate-200 font-sans text-[11px]">No Redis, Node, or Celery microservice clusters required. Just one binary.</div>
								</div>
								<div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 space-y-1">
									<div class="text-[10px] uppercase text-slate-400 font-semibold">Self-Hosted Freedom</div>
									<div class="text-slate-200 font-sans text-[11px]">Embedded SQLite for single-node or PostgreSQL for distributed HA clusters.</div>
								</div>
								<div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 space-y-1">
									<div class="text-[10px] uppercase text-slate-400 font-semibold">OpenFeature Native</div>
									<div class="text-slate-200 font-sans text-[11px]">100% CNCF standard compliant across Go, TypeScript, Python, and Rust.</div>
								</div>
							</div>
						</div>

					</div>
				</section>

				<!-- 3. ARCHITECTURAL DATA BUS & STREAM PIPELINE -->
				<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
					<div class="text-center space-y-3">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-mono font-bold">
							<i data-lucide="git-branch" class="h-3.5 w-3.5"></i>
							<span>REAL-TIME DATA PROPAGATION</span>
						</div>
						<h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 font-display">
							How updates travel to every edge node.
						</h2>
					</div>

					<div class="glass-panel p-6 sm:p-8 bg-white border border-slate-200 shadow-xs space-y-6">
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
							<!-- Step 1 -->
							<div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
								<div class="flex items-center justify-between text-xs">
									<span class="text-slate-900 font-bold">1. Control Plane &amp; Store</span>
									<span class="text-indigo-600 font-bold">SQLite / PostgreSQL</span>
								</div>
								<p class="text-xs text-slate-600 font-sans leading-relaxed">
									Flags and rollout strategies are persisted in Embedded SQLite or PostgreSQL and signed cryptographically.
								</p>
							</div>

							<!-- Step 2 -->
							<div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
								<div class="flex items-center justify-between text-xs">
									<span class="text-slate-900 font-bold">2. Monotonic SSE Stream</span>
									<span class="text-emerald-700 font-bold animate-pulse">&lt; 5ms</span>
								</div>
								<p class="text-xs text-slate-600 font-sans leading-relaxed">
									Changes are published across persistent Server-Sent Events (SSE) connections with auto-reconnect backoff.
								</p>
							</div>

							<!-- Step 3 -->
							<div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
								<div class="flex items-center justify-between text-xs">
									<span class="text-slate-900 font-bold">3. Edge SDK Local Memory</span>
									<span class="text-sky-600 font-bold">~85ns</span>
								</div>
								<p class="text-xs text-slate-600 font-sans leading-relaxed">
									Local SDK memory caches update atomically with RWMutex zero-allocation fast paths.
								</p>
							</div>
						</div>
					</div>
				</section>

				<!-- 4. IN-BROWSER BENCHMARK SIMULATOR -->
				<section id="section-benchmark" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
					<div class="glass-panel p-6 sm:p-10 bg-white border border-slate-200 shadow-md space-y-8 rounded-3xl">
						<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-6">
							<div class="space-y-1">
								<div class="flex items-center gap-2">
									<div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 border border-indigo-200 flex items-center justify-center">
										<i data-lucide="zap" class="h-4 w-4"></i>
									</div>
									<h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 font-display">
										In-Browser Real-Time Benchmark Runner
									</h2>
								</div>
								<p class="text-xs text-slate-500 font-sans">
									Execute 100,000 deterministic flag evaluations directly in your browser JavaScript runtime.
								</p>
							</div>

							<button 
								@click="runBrowserBenchmark()"
								:disabled="benchRunning || isRunningBenchmark"
								class="px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-700 disabled:opacity-60 text-white font-bold text-xs font-mono transition-all shadow-sm hover:shadow flex items-center gap-2 cursor-pointer hover:scale-[1.02] shrink-0"
							>
								<i data-lucide="play" class="h-4 w-4 fill-white text-white" x-show="!benchRunning && !isRunningBenchmark"></i>
								<i data-lucide="loader-2" class="h-4 w-4 animate-spin text-white" x-show="benchRunning || isRunningBenchmark"></i>
								<span x-text="(benchRunning || isRunningBenchmark) ? 'Benchmarking...' : 'Run 100k Benchmark'">Run 100k Benchmark</span>
							</button>
						</div>

						<!-- Benchmark Telemetry Board -->
						<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-center">
							<div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 shadow-2xs">
								<div class="text-[11px] text-slate-500 uppercase font-semibold">Evaluations Run</div>
								<div class="text-2xl font-extrabold text-slate-900" x-text="benchCount ? benchCount.toLocaleString() : '100,000'">100,000</div>
							</div>
							<div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 shadow-2xs">
								<div class="text-[11px] text-slate-500 uppercase font-semibold">Total Duration</div>
								<div class="text-2xl font-extrabold text-indigo-600" x-text="benchDurationMs ? (benchDurationMs + ' ms') : 'Measuring...'">-- ms</div>
							</div>
							<div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-1.5 shadow-2xs">
								<div class="text-[11px] text-slate-500 uppercase font-semibold">Throughput Rate</div>
								<div class="text-2xl font-extrabold text-emerald-600" x-text="benchOpsPerSec || 'Calculating...'">-- ops/sec</div>
							</div>
						</div>
					</div>
				</section>

				<!-- 5. CLI INSTALL TERMINAL BANNER -->
				<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="glass-panel p-6 sm:p-8 bg-slate-900 text-slate-100 border border-slate-800 rounded-3xl space-y-4 shadow-md font-mono">
						<div class="flex items-center justify-between">
							<span class="text-xs text-slate-400 font-bold uppercase tracking-wider">Quick Install CLI</span>
							<span class="text-[11px] text-slate-400">macOS • Linux • Windows</span>
						</div>

						<div class="p-4 rounded-2xl bg-black/50 border border-white/10 flex items-center justify-between gap-4">
							<code class="text-xs text-emerald-400 truncate select-all">
								curl -sSL https://flagura.dev/install.sh | bash
							</code>
							<button 
								@click="navigator.clipboard.writeText('curl -sSL https://flagura.dev/install.sh | bash'); showToast('Copied install command!');"
								class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition shrink-0 cursor-pointer"
							>
								Copy
							</button>
						</div>
					</div>
				</section>

			</main>

			<!-- Clean Light Footer -->
			<footer class="border-t border-slate-200 bg-white py-12 px-4 sm:px-6 lg:px-8">
				<div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 font-mono text-xs text-slate-500">
					<div class="flex items-center gap-3">
						<img src="/static/img/flagura-logo.png" alt="Flagura" class="h-6 w-6 rounded-lg object-cover" />
						<span class="font-display font-extrabold text-slate-900 text-sm">Flagura</span>
						<span>•</span>
						<span>OpenFeature Native Engine</span>
					</div>

					<div class="flex items-center gap-6">
						<a href="/dashboard" class="hover:text-slate-900 transition">Console</a>
						<a href="https://github.com/dhawalhost/flagura" target="_blank" class="hover:text-slate-900 transition">GitHub</a>
						<a href="/api/v1/flags" class="hover:text-slate-900 transition">API</a>
					</div>
				</div>
			</footer>

		</div>
	}
}
