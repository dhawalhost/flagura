package views

templ landingFeature(title string, body string, specimen string) {
	<li class="grid grid-cols-1 md:grid-cols-12 gap-x-6 gap-y-2 py-6 border-t border-neutral-200">
		<h3 class="md:col-span-5 text-xl text-neutral-900">{ title }</h3>
		<div class="md:col-span-7">
			<p class="text-base text-neutral-600 max-w-xl">{ body }</p>
			<p class="mt-2 font-mono text-xs text-accent-700 break-words">{ specimen }</p>
		</div>
	</li>
}

templ landingBench(label string, value string) {
	<div class="flex justify-between gap-4 py-2 border-t border-neutral-200 text-sm">
		<dt class="text-neutral-600">{ label }</dt>
		<dd class="font-mono text-neutral-900">{ value }</dd>
	</div>
}

templ LandingPage() {
	@Layout("Self-hosted feature flags") {
		<div class="min-h-screen bg-canvas text-neutral-900 overflow-x-hidden" x-data="landingPageComponent()">
			<section id="section-hero" class="on-ink fold-bottom">
				<div class="max-w-[1320px] mx-auto px-4 sm:px-8 pb-24">
					<header class="flex items-center justify-between gap-4 py-5">
						<a href="/" class="flex items-center gap-2" aria-label="Flagura home">
							@LogoMark("h-7 w-7")
							@LogoWordmark("h-[22px] translate-y-[3px]")
						</a>
						<nav class="hidden md:flex items-center gap-6 text-sm text-neutral-600">
							<a href="#section-bento" class="hover:text-neutral-900 transition-colors">Features</a>
							<a href="#section-sdk" class="hover:text-neutral-900 transition-colors">SDKs</a>
							<a href="#section-benchmark" class="hover:text-neutral-900 transition-colors">Performance</a>
							<a href="https://github.com/dhawalhost/flagura/blob/main/docs/product/sdks-and-api.md" target="_blank" rel="noopener" class="hover:text-neutral-900 transition-colors">Docs</a>
							<a href="https://github.com/dhawalhost/flagura" target="_blank" rel="noopener" class="hover:text-neutral-900 transition-colors">GitHub</a>
						</nav>
						<div class="flex items-center gap-2">
							<button type="button" @click="toggleTheme()" class="btn !p-1.5" aria-label="Switch colour theme" title="Switch colour theme">
								<span x-show="isDark"><i data-lucide="sun" class="w-3.5 h-3.5"></i></span>
								<span x-show="!isDark"><i data-lucide="moon" class="w-3.5 h-3.5"></i></span>
							</button>
							<a href="/dashboard" class="btn btn-primary">Open console</a>
						</div>
					</header>

					<div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-6 pt-12 sm:pt-20 lg:items-end">
						<h1 class="display lg:col-span-8">Decide who gets it.</h1>
						<div class="lg:col-span-4 lg:pb-3">
							<p class="text-lg text-neutral-700">Flagura is feature flags you host yourself. Roll out by percentage or rule, and turn anything off in one click. SDKs evaluate in memory, so user data stays in your process.</p>
							<div class="mt-5 flex flex-wrap gap-2">
								<a href="/dashboard" class="btn btn-primary !px-4 !py-2">Open console</a>
								<a href="#section-install" class="btn !px-4 !py-2">Install</a>
							</div>
						</div>
					</div>

					<div class="mt-12 sm:mt-16" x-data="rolloutField()">
						<canvas x-ref="field" class="block w-full" role="img" aria-label="A field of users, lit when the flag is on for them"></canvas>
						<div class="mt-6 grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-5 md:items-end">
							<div class="md:col-span-6">
								<div class="flex justify-between text-sm">
									<label for="rollout-range" class="text-neutral-600">Rollout of <span class="font-mono text-neutral-900">new-checkout</span></label>
									<span class="font-mono text-neutral-900" x-text="killed ? 'killed' : rollout + '%'"></span>
								</div>
								<input id="rollout-range" type="range" min="0" max="100" x-model="rollout" @input="onDrag()" class="w-full cursor-pointer mt-1"/>
							</div>
							<div class="md:col-span-4">
								<label for="rollout-user" class="field-label">Your user ID</label>
								<div class="flex items-center gap-3">
									<input id="rollout-user" type="text" x-model="userId" @input="onUser()" class="field font-mono" spellcheck="false"/>
									<span class="font-mono text-sm whitespace-nowrap" :class="userOn ? 'text-accent-700' : 'text-neutral-500'" x-text="userOn ? 'on' : 'off'"></span>
								</div>
							</div>
							<div class="md:col-span-2">
								<button type="button" role="switch" :aria-checked="killed ? 'true' : 'false'" @click="toggleKill()" class="btn w-full" :class="killed ? 'text-danger-700' : ''" x-text="killed ? 'Restore' : 'Kill switch'"></button>
							</div>
						</div>
						<p class="mt-4 text-sm text-neutral-500">Each leaf is one user, hashed the way Flagura hashes them. Drag up and the lit leaves stay lit. Your ID lands in <span class="font-mono" x-text="'bucket ' + userBucket"></span>.</p>
					</div>
				</div>
			</section>

			<main>
				<section id="section-bento" class="max-w-[1320px] mx-auto px-4 sm:px-8 pt-20 pb-16">
					<h2 class="section-title max-w-3xl">Built for the day a release goes wrong.</h2>
					<ol class="mt-10 border-b border-neutral-200">
						@landingFeature("Rollouts and rules", "Set a percentage or target by email, country, plan or any attribute you pass, per environment. Hashing is sticky, so nobody flips between versions.", "plan in [pro, enterprise] and country = DE, then 25%")
						@landingFeature("A kill switch that reaches everyone", "Changes go to connected SDKs over a server-sent event stream. A webhook from your APM can also roll a canary back to 0% for you.", "canary_rollback: new-checkout to 0%")
						@landingFeature("Two people for production", "Protect an environment and changes wait for a second person to review them, like a pull request for your flags.", "ramp new-checkout to 100%: awaiting review")
						@landingFeature("An audit trail you can check", "Each entry is hashed with the one before it. One API call verifies the whole chain, and you can export it as CSV or JSON.", "GET /api/v1/audit/verify")
						@landingFeature("Cleanup for finished flags", "Flagura finds flags stuck at 100% and flags nobody turned back on, then tells you which ones to take out of your code.", "checkout-v2: 100% in production, ready for cleanup")
					</ol>
				</section>

				<section id="section-sdk" class="max-w-[1320px] mx-auto px-4 sm:px-8 py-16 grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-8">
					<div class="lg:col-span-5">
						<h2 class="section-title">Evaluated where your code runs.</h2>
						<ol class="mt-8 space-y-5">
							<li><div class="font-mono text-xs text-neutral-400">store</div><p class="text-base text-neutral-700">Flags live in SQLite or PostgreSQL, on your infrastructure</p></li>
							<li><div class="font-mono text-xs text-neutral-400">stream</div><p class="text-base text-neutral-700">A change is pushed to every connected SDK over SSE, with backoff when a connection drops</p></li>
							<li><div class="font-mono text-xs text-neutral-400">memory</div><p class="text-base text-neutral-700">Your service holds the rules and evaluates locally. Emails and IDs never need to leave it.</p></li>
						</ol>
					</div>
					<div class="lg:col-span-7 min-w-0">
						<div class="flex items-center justify-between gap-3 mb-2">
							<div class="seg">
							<button type="button" @click="sdkLanguage = 'go'" :class="sdkLanguage === 'go' ? 'seg-on' : ''">Go</button>
							<button type="button" @click="sdkLanguage = 'ts'" :class="sdkLanguage === 'ts' ? 'seg-on' : ''">TypeScript</button>
							<button type="button" @click="sdkLanguage = 'python'" :class="sdkLanguage === 'python' ? 'seg-on' : ''">Python</button>
							<button type="button" @click="sdkLanguage = 'rust'" :class="sdkLanguage === 'rust' ? 'seg-on' : ''">Rust</button>
							<button type="button" @click="sdkLanguage = 'curl'" :class="sdkLanguage === 'curl' ? 'seg-on' : ''">cURL</button>
							</div>
							<button type="button" @click="copySnippet()" class="btn shrink-0" x-text="codeCopied ? 'Copied' : 'Copy'"></button>
						</div>
						<div class="panel code-scope bg-neutral-900 p-4 text-xs leading-relaxed font-mono overflow-x-auto">
							<template x-if="sdkLanguage === 'go'">
								<pre class="text-neutral-200"><code>{ `package main

import (
    "context"
    "fmt"
    flagura "github.com/dhawalhost/flagura/sdks/go"
)

func main() {
    // In-memory local evaluation
    client := flagura.NewClient("https://api.flagura.dev", "flg_live_secret",
        flagura.WithLocalEvaluation(true),
    )
    defer client.Close()

    res, _ := client.Evaluate(context.Background(), "ai-smart-search", flagura.Context{
        UserID: "usr_alex_42",
        Email:  "alex@company.com",
    })

    fmt.Printf("Enabled: %v | Latency: %v ns\n", res.Enabled, res.EvaluationLatencyNs)
}` }</code></pre>
							</template>
							<template x-if="sdkLanguage === 'ts'">
								<pre class="text-neutral-200"><code>{ `import { FlaguraClient } from '@flagura/sdk';

// Instant local in-memory evaluation over persistent SSE stream
const client = new FlaguraClient({
  endpoint: 'https://api.flagura.dev',
  apiKey: 'flg_live_secret'
});

const { enabled, variant } = await client.evaluate('ai-smart-search', {
  user_id: 'usr_alex_42',
  email: 'alex@company.com',
});

// Evaluated result: { enabled, variant }` }</code></pre>
							</template>
							<template x-if="sdkLanguage === 'python'">
								<pre class="text-neutral-200"><code>{ `from flagura import FlaguraClient, EvaluationContext

# Fast local in-process evaluation with zero remote HTTP calls
client = FlaguraClient("https://api.flagura.dev", api_key="flg_live_secret")

res = client.evaluate("ai-smart-search", EvaluationContext(
    user_id="usr_alex_42", 
    email="alex@company.com"
))

print(res.enabled, res.variant)` }</code></pre>
							</template>
							<template x-if="sdkLanguage === 'rust'">
								<pre class="text-neutral-200"><code>{ `use flagura::{FlaguraClient, EvaluationContext};

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = FlaguraClient::new("https://api.flagura.dev")
        .with_api_key("flg_live_secret");
        
    let ctx = EvaluationContext::new("usr_alex_42").with_email("alex@company.com");

    if client.is_enabled("ai-smart-search", &ctx).await {
        println!("Smart search is active");
    }
    Ok(())
}` }</code></pre>
							</template>
							<template x-if="sdkLanguage === 'curl'">
								<pre class="text-neutral-200"><code>{ `curl -X POST https://api.flagura.dev/api/v1/evaluate \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer flg_live_secret" \
  -d '{"flags":["ai-smart-search"],"context":{"user_id":"usr_alex_42","email":"alex@company.com"}}'` }</code></pre>
							</template>
						</div>
					</div>
				</section>

				<section id="section-benchmark" class="max-w-[1320px] mx-auto px-4 sm:px-8 py-16 grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-8">
					<div class="lg:col-span-5">
						<h2 class="section-title">Measured, with the method shown.</h2>
						<p class="mt-4 text-base text-neutral-600 max-w-md">Numbers from the benchmarks in the repository. Your hardware will differ, so run them yourself.</p>
						<p class="mt-3 font-mono text-xs text-neutral-500 break-words">go test ./pkg/engine -run xxx -bench . -benchmem</p>
					</div>
					<div class="lg:col-span-7">
						<dl class="border-b border-neutral-200">
							@landingBench("Evaluation from memory store", "137 ns")
							@landingBench("Percentage rollout", "144 ns")
							@landingBench("Targeting rule match", "102 ns")
							@landingBench("Regex rule", "226 ns")
						</dl>
						<p class="mt-2 text-xs text-neutral-500">Per operation on Apple silicon, 200,000 iterations</p>
						<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
							<p class="text-sm text-neutral-600"><span class="font-mono text-neutral-900" x-text="benchOpsPerSec || 'Not run yet'"></span> FNV-1a rounds in this browser tab.</p>
							<button type="button" @click="runBrowserBenchmark()" :disabled="benchRunning || isRunningBenchmark" class="btn" x-text="(benchRunning || isRunningBenchmark) ? 'Running' : 'Run again'"></button>
						</div>
					</div>
				</section>
			</main>

			<section id="section-install" class="on-ink fold-top mt-8" x-data="installCliComponent()">
				<div class="max-w-[1320px] mx-auto px-4 sm:px-8 pt-28 pb-16">
					<h2 class="display !text-[clamp(44px,7vw,104px)] max-w-4xl">Run it on your own servers.</h2>
					<p class="mt-6 text-lg text-neutral-700 max-w-2xl">MIT licensed. One Go binary, with SQLite built in or PostgreSQL for more nodes. OpenFeature providers for Go, TypeScript, Python and Rust.</p>
					<div class="mt-8 max-w-3xl">
						<div class="seg">
							<button type="button" @click="setTab('curl')" :class="installTab === 'curl' ? 'seg-on' : ''">curl</button>
							<button type="button" @click="setTab('go')" :class="installTab === 'go' ? 'seg-on' : ''">go install</button>
							<button type="button" @click="setTab('docker')" :class="installTab === 'docker' ? 'seg-on' : ''">docker</button>
						</div>
						<div class="panel mt-2 p-3 flex items-center justify-between gap-3">
							<template x-if="installTab === 'curl'"><code class="text-sm font-mono text-neutral-900 truncate select-all">curl -sSL https://flagura.dev/install.sh | bash</code></template>
							<template x-if="installTab === 'go'"><code class="text-sm font-mono text-neutral-900 truncate select-all">go install github.com/dhawalhost/flagura/cmd/cli@latest</code></template>
							<template x-if="installTab === 'docker'"><code class="text-sm font-mono text-neutral-900 truncate select-all">docker run --rm -it ghcr.io/dhawalhost/flagura:latest flagura --help</code></template>
							<button type="button" @click="copyCommand" class="btn shrink-0">Copy</button>
						</div>
					</div>
					<footer class="mt-20 pt-5 border-t border-neutral-200 flex flex-wrap items-center justify-between gap-4 text-sm text-neutral-600">
						<div class="flex items-center gap-2">
							@LogoMark("h-6 w-6")
							@LogoWordmark("h-[19px] translate-y-[3px]")
						</div>
						<div class="flex items-center gap-5">
							<a href="/dashboard" class="hover:text-neutral-900 transition-colors">Console</a>
							<a href="https://github.com/dhawalhost/flagura/blob/main/docs/product/sdks-and-api.md" target="_blank" rel="noopener" class="hover:text-neutral-900 transition-colors">Docs</a>
							<a href="https://github.com/dhawalhost/flagura" target="_blank" rel="noopener" class="hover:text-neutral-900 transition-colors">GitHub</a>
						</div>
					</footer>
				</div>
			</section>
		</div>
	}
}
