package views

templ LandingPage() {
	@Layout("Sub-Microsecond Feature Flags at Edge") {
		<div 
			class="min-h-screen text-[#0F172A] font-sans antialiased relative overflow-x-hidden"
			x-data="landingPageComponent()"
		>
			<!-- Single Unified Sleek Navigation Bar -->
			<header class="fixed top-0 inset-x-0 z-50 bg-white/85 backdrop-blur-xl border-b border-slate-200/70 shadow-xs">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
					<!-- Brand -->
					<div class="flex items-center gap-4">
						<a href="/" class="flex items-center gap-2.5 group">
							<img src="/static/img/flagura-logo.png" alt="Flagura" class="h-9 w-9 rounded-xl shadow-md group-hover:scale-105 transition-transform" />
							<span class="text-lg font-extrabold tracking-tight text-slate-900 font-display">Flagura</span>
						</a>
					</div>

					<!-- Chapter Links -->
					<nav class="hidden md:flex items-center gap-1 text-xs font-semibold text-slate-600">
						<template x-for="(chap, idx) in chapters.slice(0, 5)" :key="chap.id">
							<button
								@click="scrollToChapter(chap.id, idx)"
								class="px-3 py-1.5 rounded-lg transition-all cursor-pointer"
								:class="activeChapterIndex === idx ? 'bg-blue-50 text-blue-700 font-bold' : 'hover:text-slate-900 hover:bg-slate-100/70'"
								x-text="chap.title"
							></button>
						</template>
					</nav>

					<!-- Action Controls -->
					<div class="flex items-center gap-3">
						<button
							@click="toggleSound()"
							class="p-2 rounded-xl border border-slate-200 bg-white/80 hover:bg-white text-slate-600 hover:text-slate-900 transition-all cursor-pointer shadow-2xs"
							:title="soundOn ? 'Mute Interaction Audio' : 'Unmute Interaction Audio'"
						>
							<i data-lucide="volume-2" class="h-4 w-4 text-blue-600" x-show="soundOn"></i>
							<i data-lucide="volume-x" class="h-4 w-4 text-slate-400" x-show="!soundOn"></i>
						</button>

						<a
							href="/auth"
							class="hidden sm:inline-flex px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-all"
						>
							Sign In
						</a>

						<a
							href="/dashboard"
							class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition-all shadow-md shadow-blue-600/25 flex items-center gap-1.5 cursor-pointer"
						>
							<span>Open Dashboard</span>
							<i data-lucide="arrow-right" class="h-3.5 w-3.5"></i>
						</a>
					</div>
				</div>
			</header>

			<!-- Fixed Right Rail Chapter Navigation -->
			<aside class="fixed right-6 top-1/2 -translate-y-1/2 z-40 hidden xl:flex flex-col items-end gap-3">
				<template x-for="(chap, idx) in chapters" :key="chap.id">
					<button
						@click="scrollToChapter(chap.id, idx)"
						class="group flex items-center gap-2.5 text-right cursor-pointer py-1"
					>
						<span
							class="text-xs font-medium transition-all duration-200"
							:class="activeChapterIndex === idx ? 'opacity-100 font-bold text-white px-2.5 py-0.5 rounded-md bg-blue-600 shadow-sm' : 'opacity-0 group-hover:opacity-100 text-slate-700 bg-white/90 px-2 py-0.5 rounded backdrop-blur-md border border-slate-200 shadow-2xs'"
							x-text="chap.label"
						></span>
						<div
							class="h-2 rounded-full transition-all duration-200"
							:class="activeChapterIndex === idx ? 'w-6 bg-blue-600 shadow-sm shadow-blue-500/40' : 'w-2 bg-slate-300 group-hover:bg-slate-500'"
						></div>
					</button>
				</template>
			</aside>

			<!-- MAIN STORYTELLING CONTENT -->
			<main class="relative z-10 space-y-28 pt-28 pb-20">

				<!-- CHAPTER 1: HERO SECTION -->
				<section
					id="chapter-hero"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8"
				>
					<div class="space-y-10">
						<!-- Hero Title Block -->
						<div class="text-center max-w-3xl mx-auto space-y-5">
							<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50/90 border border-blue-200/80 text-blue-700 text-xs font-semibold shadow-2xs">
								<i data-lucide="sliders" class="h-3.5 w-3.5 text-blue-600"></i>
								<span>Feature Flags & Progressive Releases</span>
							</div>

							<h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight font-display">
								Launch features safely. <br/>
								<span class="text-blue-600">Control releases in real time.</span>
							</h1>

							<p class="text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-2xl mx-auto">
								Manage feature rollouts with deterministic percentage bucketing, targeting rules, and master kill-switches—powered by local in-memory evaluation.
							</p>

							<div class="flex flex-wrap items-center justify-center gap-3 pt-2">
								<a
									href="/dashboard"
									class="px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-all shadow-lg shadow-blue-600/25 flex items-center gap-2 cursor-pointer"
								>
									<span>Launch Developer Console</span>
									<i data-lucide="arrow-right" class="h-4 w-4"></i>
								</a>
								<button
									@click="scrollToChapter('chapter-canary-highway', 3)"
									class="px-5 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold text-sm transition-all shadow-xs cursor-pointer"
								>
									Explore How It Works
								</button>
							</div>
						</div>

						<!-- Interactive Feature Switchboard Card -->
						<div class="glass-dashboard p-6 sm:p-8 max-w-4xl mx-auto w-full space-y-6">
							<!-- Header Bar -->
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200/80">
								<div class="flex items-center gap-2.5">
									<span class="h-2.5 w-2.5 rounded-full bg-blue-600 animate-pulse"></span>
									<span class="text-xs font-bold text-slate-900 uppercase tracking-wider font-mono">
										Interactive Feature Switchboard
									</span>
								</div>
								<div class="flex items-center gap-2 text-xs">
									<span class="text-slate-500 font-medium">Target Flag:</span>
									<span class="px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 font-bold">
										ai-smart-search
									</span>
								</div>
							</div>

							<!-- Interactive Controls & Output Grid -->
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
								<!-- Left: Inputs & Slider -->
								<div class="space-y-5">
									<div>
										<div class="flex items-center justify-between text-xs mb-1.5">
											<span class="font-semibold text-slate-700">Test User Identity:</span>
											<span class="text-blue-700 font-bold bg-blue-50 px-2 py-0.5 rounded border border-blue-200 font-mono" x-text="'Bucket #' + heroBucket + '%'"></span>
										</div>
										<div class="flex gap-2">
											<input
												type="text"
												x-model="heroUserId"
												@input="updateHeroBucket()"
												placeholder="e.g. sarah@example.com"
												class="input-clean flex-1 font-mono text-xs"
											/>
											<button
												type="button"
												@click="randomizeUser()"
												class="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 border border-slate-200 text-xs font-semibold text-slate-700 cursor-pointer flex items-center gap-1.5 transition-all"
											>
												<i data-lucide="refresh-cw" class="h-3.5 w-3.5"></i>
												<span>Randomize</span>
											</button>
										</div>
									</div>

									<div>
										<div class="flex items-center justify-between text-xs mb-1.5">
											<span class="font-semibold text-slate-700">Rollout Percentage:</span>
											<span class="font-bold text-blue-700 text-sm bg-blue-50 px-2.5 py-0.5 rounded border border-blue-200 font-mono" x-text="heroRolloutPct + '% of traffic'"></span>
										</div>
										<input
											type="range"
											min="0"
											max="100"
											x-model="heroRolloutPct"
											@input="updateHeroBucket()"
											class="w-full accent-blue-600 cursor-pointer"
										/>
										<div class="flex justify-between text-[11px] text-slate-400 mt-1 font-mono">
											<span>0% (Internal)</span>
											<span>50% (Half)</span>
											<span>100% (All Users)</span>
										</div>
									</div>
								</div>

								<!-- Right: Resolution Card -->
								<div>
									<div
										class="rounded-2xl border p-5 transition-all space-y-4"
										:class="isHeroActive ? 'border-emerald-300 bg-emerald-50/90 shadow-sm' : 'border-slate-200 bg-slate-50/90'"
									>
										<div class="flex items-center justify-between text-xs">
											<span class="font-bold text-slate-500 uppercase tracking-wider text-[10px] font-mono">
												Computed Evaluation
											</span>
											<span class="text-[11px] font-bold text-emerald-800 bg-emerald-100/80 border border-emerald-200 px-2 py-0.5 rounded font-mono">
												Latency: &lt; 0.08ms
											</span>
										</div>

										<div class="flex items-center gap-4">
											<div
												class="h-12 w-12 rounded-xl flex items-center justify-center font-bold text-base font-mono transition-all shrink-0"
												:class="isHeroActive ? 'bg-emerald-600 text-white shadow-md shadow-emerald-600/30' : 'bg-slate-200 text-slate-600'"
												x-text="isHeroActive ? 'ON' : 'OFF'"
											></div>
											<div>
												<div class="font-bold text-sm text-slate-900" x-text="isHeroActive ? 'Feature Enabled (Treatment Group)' : 'Feature Disabled (Control Group)'"></div>
												<p class="text-xs text-slate-600 mt-0.5 leading-relaxed" x-text="isHeroActive ? 'User bucket #' + heroBucket + '% is within the ' + heroRolloutPct + '% rollout window.' : 'User bucket #' + heroBucket + '% exceeds the current ' + heroRolloutPct + '% threshold.'"></p>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- MARQUEE FEATURES STRIP -->
				<div class="w-full overflow-hidden py-3.5 border-y border-slate-200/80 bg-white/70 backdrop-blur-md">
					<div class="flex whitespace-nowrap animate-marquee text-sm font-semibold text-slate-700">
						<span class="mx-6 text-slate-900 flex items-center gap-2"><i data-lucide="check-circle-2" class="h-4 w-4 text-blue-600"></i> Deterministic Percentage Rollouts</span>
						<span class="mx-6 text-slate-300">•</span>
						<span class="mx-6 text-slate-900 flex items-center gap-2"><i data-lucide="check-circle-2" class="h-4 w-4 text-blue-600"></i> Attribute Targeting Rules</span>
						<span class="mx-6 text-slate-300">•</span>
						<span class="mx-6 text-slate-900 flex items-center gap-2"><i data-lucide="check-circle-2" class="h-4 w-4 text-blue-600"></i> Master Kill-Switch Protection</span>
						<span class="mx-6 text-slate-300">•</span>
						<span class="mx-6 text-slate-900 flex items-center gap-2"><i data-lucide="check-circle-2" class="h-4 w-4 text-blue-600"></i> Multi-Environment Support</span>
						<span class="mx-6 text-slate-300">•</span>
						<span class="mx-6 text-slate-900 flex items-center gap-2"><i data-lucide="check-circle-2" class="h-4 w-4 text-blue-600"></i> Immutable Audit Logging</span>
						<span class="mx-6 text-slate-300">•</span>
					</div>
				</div>

				<!-- CHAPTER 2: ARCHITECTURE (In-Memory vs Remote Evaluation) -->
				<section
					id="chapter-network-tax"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-8">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full border border-blue-200 inline-block font-mono">
								02 // Evaluation Architecture
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								In-Memory Evaluation vs. Remote Network Calls
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								How in-process evaluation avoids adding network latency to critical application paths.
							</p>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch max-w-5xl mx-auto">
							<!-- Remote Evaluation Card -->
							<div class="glass-dashboard p-6 space-y-4 border-slate-200">
								<div class="flex items-center justify-between pb-3 border-b border-slate-200">
									<div class="flex items-center gap-2">
										<i data-lucide="server" class="h-4 w-4 text-slate-600"></i>
										<span class="font-bold text-sm text-slate-900">Remote HTTP Evaluation</span>
									</div>
									<span class="px-2.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-700 text-xs font-semibold font-mono">
										Network Dependent
									</span>
								</div>

								<div class="space-y-2.5 text-xs text-slate-600">
									<div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
										<span>1. Application sends HTTP request to external service</span>
										<span class="text-slate-500 font-mono">Network hop</span>
									</div>
									<div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
										<span>2. Remote server executes rule matching logic</span>
										<span class="text-slate-500 font-mono">Server compute</span>
									</div>
									<div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
										<span>3. Response payload returned over the internet</span>
										<span class="text-slate-500 font-mono">Payload return</span>
									</div>
								</div>

								<div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 text-xs flex items-center gap-2.5">
									<i data-lucide="info" class="h-4 w-4 text-slate-500 shrink-0"></i>
									<span><strong>Trade-off:</strong> External network latency is added to every evaluated request.</span>
								</div>
							</div>

							<!-- Flagura In-Memory Engine -->
							<div class="glass-dashboard p-6 space-y-4 border-blue-200">
								<div class="flex items-center justify-between pb-3 border-b border-blue-100">
									<div class="flex items-center gap-2">
										<i data-lucide="zap" class="h-4 w-4 text-blue-600"></i>
										<span class="font-bold text-sm text-slate-900">Local In-Memory Evaluation</span>
									</div>
									<span class="px-2.5 py-0.5 rounded bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold font-mono">
										In-Process
									</span>
								</div>

								<div class="space-y-2.5 text-xs text-slate-600">
									<div class="p-3 rounded-xl bg-blue-50/50 border border-blue-100 flex items-center justify-between">
										<div class="flex items-center gap-2">
											<i data-lucide="check-circle-2" class="h-3.5 w-3.5 text-blue-600"></i>
											<span>1. Flag configurations cached locally in application memory</span>
										</div>
										<span class="text-blue-700 font-mono font-semibold">Local RAM</span>
									</div>
									<div class="p-3 rounded-xl bg-blue-50/50 border border-blue-100 flex items-center justify-between">
										<div class="flex items-center gap-2">
											<i data-lucide="check-circle-2" class="h-3.5 w-3.5 text-blue-600"></i>
											<span>2. Deterministic FNV-1a hash and rule evaluation in-process</span>
										</div>
										<span class="text-blue-700 font-mono font-semibold">Sub-millisecond</span>
									</div>
									<div class="p-3 rounded-xl bg-blue-50/50 border border-blue-100 flex items-center justify-between">
										<div class="flex items-center gap-2">
											<i data-lucide="check-circle-2" class="h-3.5 w-3.5 text-blue-600"></i>
											<span>3. Immediate boolean/variant decision returned</span>
										</div>
										<span class="text-blue-700 font-mono font-semibold">Zero I/O</span>
									</div>
								</div>

								<div class="p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-900 text-xs flex items-center gap-2.5">
									<i data-lucide="shield-check" class="h-4 w-4 text-blue-600 shrink-0"></i>
									<span><strong>Advantage:</strong> No network dependency on the request critical path.</span>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- CHAPTER 3: DETERMINISTIC AUDIENCES -->
				<section
					id="chapter-hashing-engine"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-8">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full border border-blue-200 inline-block font-mono">
								03 // Audience Consistency
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								Deterministic Sticky Bucketing for Every User.
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								Users never jump between variants. A user assigned to bucket #42% remains in bucket #42% across all visits, sessions, and platforms.
							</p>
						</div>

						<div class="glass-dashboard p-6 sm:p-8 space-y-6 max-w-4xl mx-auto w-full">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200/80">
								<div>
									<div class="text-xs font-bold text-slate-900">FNV-1a 64-Bit Hash Simulation</div>
									<div class="text-xs text-slate-500">Evaluating character sequence deterministic distribution</div>
								</div>
								<div class="text-xs text-blue-700 bg-blue-50 px-3 py-1 rounded-lg border border-blue-200 font-bold font-mono">
									100% Deterministic
								</div>
							</div>

							<!-- Hash Steps Sequence -->
							<div class="grid grid-cols-4 sm:grid-cols-8 gap-2 font-mono">
								<template x-for="(char, idx) in hashChars" :key="idx">
									<div
										class="p-2.5 rounded-xl border text-center transition-all duration-200"
										:class="idx === hashStep ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-slate-50 text-slate-700 border-slate-200'"
									>
										<div class="text-xs font-bold" x-text="'\'' + char + '\''"></div>
										<div class="text-[9px] opacity-70 mt-0.5" x-text="'#' + (idx + 1)"></div>
									</div>
								</template>
							</div>

							<div class="p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
								<div>
									<span class="text-slate-500">Identity: </span>
									<strong class="text-slate-900" x-text="heroUserId"></strong>
								</div>
								<div class="flex items-center gap-2">
									<span class="text-slate-500">Resolved Cohort:</span>
									<span class="px-3 py-1 rounded-lg bg-blue-600 text-white font-bold" x-text="'Group #' + heroBucket + '%'"></span>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- CHAPTER 4: CANARY HIGHWAY ROLLOUT STAGES -->
				<section
					id="chapter-canary-highway"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-8">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full border border-blue-200 inline-block font-mono">
								04 // Canary Releases
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								Control Blast Radius with Gradual Rollouts.
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								Safely advance from internal staff verification to canary cohorts, 50/50 A/B testing, and full global release.
							</p>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-6xl mx-auto w-full">
							<!-- Stage 1 -->
							<div class="glass-dashboard p-5 space-y-3">
								<div class="flex items-center justify-between pb-2 border-b border-slate-200/80">
									<span class="text-xs font-bold text-slate-900 font-mono">STAGE 1: TEAM</span>
									<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold border border-slate-200 font-mono">0% Public</span>
								</div>
								<div class="space-y-1.5 text-xs text-slate-600">
									<div class="font-bold text-slate-900 flex items-center gap-1.5">
										<i data-lucide="shield-check" class="h-3.5 w-3.5 text-blue-600"></i>
										<span>Staff Whitelist</span>
									</div>
									<p>Internal developers and QA verify live in production.</p>
								</div>
							</div>

							<!-- Stage 2 -->
							<div class="glass-dashboard p-5 space-y-3 border-amber-200">
								<div class="flex items-center justify-between pb-2 border-b border-amber-100">
									<span class="text-xs font-bold text-slate-900 font-mono">STAGE 2: CANARY</span>
									<span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 text-[10px] font-bold border border-amber-200 font-mono">10% Traffic</span>
								</div>
								<div class="space-y-1.5 text-xs text-slate-600">
									<div class="font-bold text-slate-900 flex items-center gap-1.5">
										<i data-lucide="activity" class="h-3.5 w-3.5 text-amber-600"></i>
										<span>Early Beta Slice</span>
									</div>
									<p>Monitor telemetry, error rates, and server memory.</p>
								</div>
							</div>

							<!-- Stage 3 -->
							<div class="glass-dashboard p-5 space-y-3 border-blue-200">
								<div class="flex items-center justify-between pb-2 border-b border-blue-100">
									<span class="text-xs font-bold text-slate-900 font-mono">STAGE 3: 50/50</span>
									<span class="px-2 py-0.5 rounded bg-blue-50 text-blue-800 text-[10px] font-bold border border-blue-200 font-mono">50% Split</span>
								</div>
								<div class="space-y-1.5 text-xs text-slate-600">
									<div class="font-bold text-slate-900 flex items-center gap-1.5">
										<i data-lucide="globe-2" class="h-3.5 w-3.5 text-blue-600"></i>
										<span>A/B Experiment</span>
									</div>
									<p>Compare conversion metrics and engagement delta.</p>
								</div>
							</div>

							<!-- Stage 4 -->
							<div class="glass-dashboard p-5 space-y-3 border-emerald-200">
								<div class="flex items-center justify-between pb-2 border-b border-emerald-100">
									<span class="text-xs font-bold text-slate-900 font-mono">STAGE 4: GLOBAL</span>
									<span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-[10px] font-bold border border-emerald-200 font-mono">100% General</span>
								</div>
								<div class="space-y-1.5 text-xs text-slate-600">
									<div class="font-bold text-slate-900 flex items-center gap-1.5">
										<i data-lucide="check-circle-2" class="h-3.5 w-3.5 text-emerald-600"></i>
										<span>Worldwide Release</span>
									</div>
									<p>Active across all edge nodes with zero downtime.</p>
								</div>
							</div>
						</div>
					</div>
				</section>

				<!-- CHAPTER 5: EMERGENCY CIRCUIT BREAKER -->
				<section
					id="chapter-kill-switch"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-8">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-rose-600 uppercase tracking-wider bg-rose-50 px-3 py-1 rounded-full border border-rose-200 inline-block font-mono">
								05 // Instant Rollback
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								Emergency Kill Switch Circuit Breaker.
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								Discovered a breaking defect? Trigger the master kill-switch to immediately fall back to the safe control state across all edge nodes in milliseconds.
							</p>
						</div>

						<div class="glass-dashboard p-6 sm:p-8 space-y-5 max-w-4xl mx-auto w-full border-rose-200">
							<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200/80">
								<div class="flex items-center gap-3">
									<div
										class="h-10 w-10 rounded-xl flex items-center justify-center transition-colors shadow-2xs"
										:class="killSwitchOn ? 'bg-rose-600 text-white' : 'bg-emerald-600 text-white'"
									>
										<i data-lucide="flame" class="h-5 w-5"></i>
									</div>
									<div>
										<div class="text-sm font-bold text-slate-900">Kill-Switch Circuit Breaker Simulation</div>
										<div class="text-xs text-slate-500">Test instant edge emergency disengagement</div>
									</div>
								</div>

								<div class="flex items-center gap-2">
									<span class="text-xs text-slate-500">Circuit State:</span>
									<span
										class="px-2.5 py-1 rounded-lg font-bold text-xs border font-mono"
										:class="killSwitchOn ? 'bg-rose-50 text-rose-700 border-rose-200 animate-pulse' : 'bg-emerald-50 text-emerald-700 border-emerald-200'"
										x-text="killSwitchOn ? 'CIRCUIT TRIPPED (DISABLED)' : 'NORMAL OPERATION (ACTIVE)'"
									></span>
								</div>
							</div>

							<div
								class="p-4 rounded-xl border flex flex-col sm:flex-row items-center justify-between gap-4 transition-all"
								:class="killSwitchOn ? 'bg-rose-50 border-rose-200 text-rose-900' : 'bg-slate-50 border-slate-200 text-slate-700'"
							>
								<div class="flex items-center gap-3 text-xs">
									<i data-lucide="alert-triangle" class="h-4 w-4 shrink-0" :class="killSwitchOn ? 'text-rose-600' : 'text-slate-400'"></i>
									<span x-text="killSwitchOn ? 'Emergency override active: 100% of user traffic is safely routed to the stable control version.' : 'All services operational. Canary traffic is routing normally.'"></span>
								</div>

								<button
									type="button"
									@click="toggleKillSwitch()"
									class="px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer shrink-0 shadow-xs"
									:class="killSwitchOn ? 'bg-emerald-600 hover:bg-emerald-700 text-white' : 'bg-rose-600 hover:bg-rose-700 text-white'"
									x-text="killSwitchOn ? 'Restore Feature' : 'Trigger Emergency Kill'"
								></button>
							</div>
						</div>
					</div>
				</section>

				<!-- CHAPTER 6: POLYGLOT SDK QUICKSTART -->
				<section
					id="chapter-sdk-morph"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-8">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full border border-blue-200 inline-block font-mono">
								06 // Developer Integration
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								Single-Line Integration in Any Stack.
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								Drop native in-memory evaluation clients into Go, React, Node.js, Python, or edge worker environments.
							</p>
						</div>

						<div class="glass-dashboard p-0 overflow-hidden max-w-4xl mx-auto w-full shadow-lg">
							<!-- Terminal Top Bar -->
							<div class="bg-slate-100 border-b border-slate-200 px-4 py-3 flex items-center justify-between">
								<div class="flex items-center gap-2">
									<div class="h-3 w-3 rounded-full bg-rose-400"></div>
									<div class="h-3 w-3 rounded-full bg-amber-400"></div>
									<div class="h-3 w-3 rounded-full bg-emerald-400"></div>
									<span class="text-xs font-medium text-slate-500 ml-2 font-mono">quickstart-example</span>
								</div>

								<div class="flex items-center gap-1.5 text-xs">
									<button
										@click="sdkLang = 'react'"
										class="px-2.5 py-1 rounded-lg transition-all cursor-pointer font-bold uppercase text-[11px]"
										:class="sdkLang === 'react' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-200'"
									>
										React
									</button>
									<button
										@click="sdkLang = 'node'"
										class="px-2.5 py-1 rounded-lg transition-all cursor-pointer font-bold uppercase text-[11px]"
										:class="sdkLang === 'node' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-200'"
									>
										Node
									</button>
									<button
										@click="sdkLang = 'go'"
										class="px-2.5 py-1 rounded-lg transition-all cursor-pointer font-bold uppercase text-[11px]"
										:class="sdkLang === 'go' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-200'"
									>
										Go
									</button>
									<button
										@click="sdkLang = 'rust'"
										class="px-2.5 py-1 rounded-lg transition-all cursor-pointer font-bold uppercase text-[11px]"
										:class="sdkLang === 'rust' ? 'bg-blue-600 text-white' : 'text-slate-600 hover:bg-slate-200'"
									>
										Rust
									</button>

									<button
										@click="copyCode()"
										class="p-1.5 rounded-lg bg-white border border-slate-200 text-slate-700 ml-2 cursor-pointer hover:bg-slate-50 transition-all shadow-2xs"
										title="Copy Code"
									>
										<i data-lucide="check" class="h-3.5 w-3.5 text-emerald-600" x-show="copiedCode"></i>
										<i data-lucide="copy" class="h-3.5 w-3.5" x-show="!copiedCode"></i>
									</button>
								</div>
							</div>

							<!-- Code Body -->
							<div class="p-6 bg-slate-900 text-slate-100 font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed">
								<pre class="text-slate-200" x-text="getSdkSnippet()"></pre>
							</div>
						</div>
					</div>
				</section>

				<!-- CHAPTER 7: BENCHMARK MATRIX & CALL TO ACTION -->
				<section
					id="chapter-benchmarks"
					class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12"
				>
					<div class="space-y-10">
						<div class="text-center space-y-3 max-w-2xl mx-auto">
							<div class="text-xs font-bold text-blue-700 uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full border border-blue-200 inline-block font-mono">
								07 // Architecture & Reliability
							</div>
							<h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
								Engineered for Massive Scale and Reliability.
							</h2>
							<p class="text-sm sm:text-base text-slate-600">
								Compare architectural capabilities between Flagura and traditional feature management stacks.
							</p>
						</div>

						<!-- Table -->
						<div class="glass-dashboard p-6 max-w-4xl mx-auto w-full">
							<div class="overflow-x-auto">
								<table class="w-full text-left text-xs">
									<thead>
										<tr class="border-b border-slate-200 text-slate-500 font-bold uppercase font-mono text-[10px]">
											<th class="pb-3 px-3">Evaluation Method</th>
											<th class="pb-3 px-3">Resolution Path</th>
											<th class="pb-3 px-3">Network I/O</th>
											<th class="pb-3 px-3">Offline Resilient</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-slate-100 font-mono">
										<tr class="bg-blue-50/70 font-semibold text-slate-900">
											<td class="py-3 px-3 flex items-center gap-2 text-blue-700">
												<i data-lucide="zap" class="h-4 w-4"></i>
												<span>Local In-Memory (Flagura)</span>
											</td>
											<td class="py-3 px-3 text-slate-800">In-Process Memory</td>
											<td class="py-3 px-3 text-emerald-700 font-bold">None</td>
											<td class="py-3 px-3 text-emerald-700 font-bold">Yes</td>
										</tr>
										<tr class="text-slate-600">
											<td class="py-3 px-3 font-medium text-slate-800">Remote API Evaluation</td>
											<td class="py-3 px-3">HTTP Roundtrip</td>
											<td class="py-3 px-3 text-slate-600">1 Request per Eval</td>
											<td class="py-3 px-3 text-rose-600">No</td>
										</tr>
										<tr class="text-slate-600">
											<td class="py-3 px-3 font-medium text-slate-800">Direct Database Queries</td>
											<td class="py-3 px-3">Database Connection</td>
											<td class="py-3 px-3 text-slate-600">1 Query per Eval</td>
											<td class="py-3 px-3 text-rose-600">No</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>

						<!-- CTA Banner -->
						<div class="glass-dashboard p-8 sm:p-12 text-center space-y-6 max-w-4xl mx-auto w-full border-blue-200">
							<div class="space-y-3">
								<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold border border-blue-200">
									<i data-lucide="sparkles" class="h-3.5 w-3.5"></i>
									<span>READY TO SHIP SAFELY?</span>
								</div>
								<h3 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
									Start Managing Your Features Today
								</h3>
								<p class="text-sm sm:text-base text-slate-600 max-w-lg mx-auto leading-relaxed">
									Create your first feature flag in 30 seconds. Roll out safely, experiment with confidence, and protect your uptime.
								</p>
							</div>

							<div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
								<a
									href="/dashboard"
									class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-all shadow-md shadow-blue-600/30 flex items-center justify-center gap-2 cursor-pointer"
								>
									<span>Launch Developer Console</span>
									<i data-lucide="arrow-right" class="h-4 w-4"></i>
								</a>
								<a
									href="/auth"
									class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-bold text-sm transition-all shadow-2xs cursor-pointer"
								>
									Create Free Account
								</a>
							</div>
						</div>
					</div>
				</section>

				<!-- FOOTER -->
				<footer class="border-t border-slate-200/80 bg-white/75 backdrop-blur-md py-6 px-4 sm:px-6 lg:px-8 text-xs text-slate-500">
					<div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
						<div class="flex items-center gap-2 font-bold text-slate-800">
							<img src="/static/img/flagura-logo.png" alt="Flagura" class="h-4 w-4 rounded" />
							<span>Flagura — Feature Flags & Releases</span>
						</div>
						<div class="flex items-center gap-4 text-slate-500 font-medium">
							<span>&copy; Flagura. Open-source feature release management.</span>
						</div>
					</div>
				</footer>
			</main>
		</div>

		<script>
			document.addEventListener('alpine:init', () => {
				Alpine.data('landingPageComponent', () => ({
					activeChapterIndex: 0,
					heroUserId: 'sarah@example.com',
					heroRolloutPct: 50,
					heroBucket: 87,
					isHeroActive: false,
					killSwitchOn: false,
					sdkLang: 'react',
					copiedCode: false,
					hashStep: 4,
					hashChars: ['s', 'a', 'r', 'a', 'h', '@', 'e', 'x'],
					chapters: [
						{ id: 'chapter-hero', label: '01 // OVERVIEW', title: 'Overview' },
						{ id: 'chapter-network-tax', label: '02 // SPEED', title: 'Speed' },
						{ id: 'chapter-hashing-engine', label: '03 // AUDIENCES', title: 'Audiences' },
						{ id: 'chapter-canary-highway', label: '04 // SAFE LAUNCHES', title: 'Launches' },
						{ id: 'chapter-kill-switch', label: '05 // EMERGENCY SWITCH', title: 'Kill Switch' },
						{ id: 'chapter-sdk-morph', label: '06 // SIMPLE CODE', title: 'SDKs' },
						{ id: 'chapter-benchmarks', label: '07 // RELIABILITY', title: 'Reliability' }
					],
					init() {
						this.updateHeroBucket();
						window.addEventListener('scroll', () => {
							const scrollPos = window.scrollY + 250;
							this.chapters.forEach((chap, idx) => {
								const el = document.getElementById(chap.id);
								if (el) {
									const top = el.offsetTop;
									const height = el.offsetHeight;
									if (scrollPos >= top && scrollPos < top + height) {
										this.activeChapterIndex = idx;
									}
								}
							});
						});
						this.$nextTick(() => {
							if (window.lucide) window.lucide.createIcons();
						});
					},
					scrollToChapter(id, idx) {
						this.activeChapterIndex = idx;
						const el = document.getElementById(id);
						if (el) {
							window.synth.playClick(520);
							el.scrollIntoView({ behavior: 'smooth' });
						}
					},
					updateHeroBucket() {
						const rawUser = this.heroUserId || 'guest';
						const b = getStickyBucketJs(rawUser, 'ai-smart-search');
						this.heroBucket = Math.round(b.bucket);
						this.isHeroActive = this.heroBucket <= this.heroRolloutPct;
						const clean = rawUser.replace(/[^a-zA-Z0-9@.]/g, '');
						this.hashChars = (clean + '________').slice(0, 8).split('');
						this.$nextTick(() => {
							if (window.lucide) window.lucide.createIcons();
						});
					},
					randomizeUser() {
						window.synth.playClick(680);
						const users = ['customer_alex_44', 'emma@company.com', 'david_pro_user', 'sarah_shopper_99', 'mike_enterprise'];
						this.heroUserId = users[Math.floor(Math.random() * users.length)];
						this.updateHeroBucket();
					},
					toggleKillSwitch() {
						this.killSwitchOn = !this.killSwitchOn;
						window.synth.playSwitch(!this.killSwitchOn);
						this.$nextTick(() => {
							if (window.lucide) window.lucide.createIcons();
						});
					},
					getSdkSnippet() {
						if (this.sdkLang === 'react') {
							return `// 1. React / Next.js Component Hook\nimport { useFeatureFlag } from '@flagura/react';\n\nexport function SearchComponent() {\n  const { isEnabled } = useFeatureFlag('ai-smart-search', {\n    userId: user.id,\n    tier: user.tier,\n  });\n\n  return isEnabled ? <SmartAISearch /> : <LegacySearch />;\n}`;
						} else if (this.sdkLang === 'node') {
							return `// 2. Node.js Express Middleware\nimport { FlaguraClient } from '@flagura/node';\n\nconst client = new FlaguraClient({ endpoint: '${window.location.origin}' });\n\napp.get('/api/search', async (req, res) => {\n  const enabled = await client.evaluate('ai-smart-search', { userId: req.user.id });\n  return res.json({ useAISearch: enabled });\n});`;
						} else if (this.sdkLang === 'go') {
							return `// 3. High-Performance Go Microservice\npackage main\n\nimport "flagura/pkg/client"\n\nfunc HandleSearch(w http.ResponseWriter, r *http.Request) {\n    c := client.New("${window.location.origin}")\n    res, _ := c.Evaluate(r.Context(), "ai-smart-search", client.Context{ UserID: "usr_123" })\n    if res.Enabled {\n        ServeSmartAISearch(w, r)\n    }\n}`;
						}
						return `// 4. Rust / Edge Worker Engine\nuse flagura_engine::{Engine, Context};\n\nlet engine = Engine::load("./flags.json")?;\nif engine.is_enabled("ai-smart-search", &Context::new("usr_123")) {\n    serve_ai_search();\n}`;
					},
					copyCode() {
						window.synth.playClick(720);
						navigator.clipboard.writeText(this.getSdkSnippet());
						this.copiedCode = true;
						setTimeout(() => this.copiedCode = false, 2000);
					}
				}));
			});
		</script>
	}
}
