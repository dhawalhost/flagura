package views

templ SDKModal() {
	<div class="space-y-8" x-show="activeView === 'sdk'" x-cloak x-data="sdkViewComponent()" x-init="fetchAPIKeys()">
		<!-- Top Header Card -->
		<div class="glass-panel p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-200 shadow-xs">
			<div class="flex items-center gap-3.5">
				<button
					@click="activeView = 'overview'"
					class="p-2 text-slate-500 hover:text-slate-900 transition-colors rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 shadow-2xs flex items-center gap-1.5 text-xs font-semibold cursor-pointer font-mono"
					title="Return to overview"
				>
					<i data-lucide="arrow-left" class="h-4 w-4"></i>
					<span class="hidden sm:inline">Back</span>
				</button>
				<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-600 shadow-2xs">
					<i data-lucide="code-2" class="h-5 w-5"></i>
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h2 class="text-base font-bold text-slate-900 font-display">SDK Integration &amp; API Key Studio</h2>
						<span class="rounded-md bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-[10px] font-mono text-indigo-700 font-bold uppercase">
							Sub-Microsecond
						</span>
					</div>
					<p class="text-xs text-slate-500 mt-0.5 font-sans">
						Generate programmatic service account API keys and integrate non-blocking evaluation clients into your services.
					</p>
				</div>
			</div>

			<div class="flex items-center gap-2 self-end sm:self-auto font-mono">
				<button
					x-show="sdkTab !== 'apikeys'"
					@click="copySnippet()"
					class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-all shadow-sm hover:shadow flex items-center gap-2 cursor-pointer hover:scale-[1.02]"
				>
					<i data-lucide="copy" class="h-3.5 w-3.5 text-white"></i>
					<span x-text="copied ? 'Copied to Clipboard!' : 'Copy Code Snippet'"></span>
				</button>
				<button
					x-show="sdkTab === 'apikeys'"
					@click="showKeyModal = true"
					class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-all shadow-sm hover:shadow flex items-center gap-2 cursor-pointer hover:scale-[1.02]"
				>
					<i data-lucide="key" class="h-3.5 w-3.5 text-white"></i>
					<span>Generate New API Key</span>
				</button>
			</div>
		</div>

		<!-- Main SDK Tabs & Container -->
		<div class="glass-panel p-6 sm:p-8 space-y-6 bg-white border border-slate-200 shadow-xs">
			<!-- Language & API Key Tabs -->
			<div class="flex items-center gap-2 border-b border-slate-100 pb-4 overflow-x-auto font-mono">
				<button 
					@click="sdkTab = 'apikeys'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer flex items-center gap-1.5"
					:class="sdkTab === 'apikeys' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					<i data-lucide="key" class="h-3.5 w-3.5"></i>
					<span>API Keys</span>
					<span class="text-[10px] px-1.5 py-0.2 rounded-full font-mono" :class="sdkTab === 'apikeys' ? 'bg-indigo-800 text-white' : 'bg-slate-200 text-slate-700'" x-text="apiKeys.length"></span>
				</button>
				<button 
					@click="sdkTab = 'go'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'go' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Go SDK
				</button>
				<button 
					@click="sdkTab = 'ts'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'ts' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					TypeScript / Node
				</button>
				<button 
					@click="sdkTab = 'python'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'python' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Python 3
				</button>
				<button 
					@click="sdkTab = 'rust'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'rust' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Rust SDK
				</button>
				<button 
					@click="sdkTab = 'openfeature'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer flex items-center gap-1.5"
					:class="sdkTab === 'openfeature' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					<span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
					<span>OpenFeature (CNCF)</span>
				</button>
				<button 
					@click="sdkTab = 'cli'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'cli' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Developer CLI
				</button>
				<button 
					@click="sdkTab = 'curl'"
					class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'curl' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Raw cURL
				</button>
			</div>

			<!-- TAB 1: API Keys Management Table -->
			<div x-show="sdkTab === 'apikeys'" class="space-y-6">
				<!-- Newly Generated Key Alert Dialog -->
				<div x-show="newlyCreatedKey" class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-3 font-mono">
					<div class="flex items-start justify-between gap-3">
						<div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
							<i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
							<span>API Key Generated Successfully</span>
						</div>
						<button @click="newlyCreatedKey = null" class="text-slate-400 hover:text-slate-700 cursor-pointer">
							<i data-lucide="x" class="w-4 h-4"></i>
						</button>
					</div>
					<p class="text-xs text-slate-600 font-sans">
						Please copy your secret key now. <strong>For your security, it will never be displayed again.</strong>
					</p>
					<div class="flex items-center gap-2">
						<input 
							type="text" 
							readonly 
							:value="newlyCreatedKey ? newlyCreatedKey.key : ''" 
							class="flex-1 bg-white border border-slate-200 rounded-xl px-3 py-2 text-xs font-mono font-bold text-emerald-800 select-all shadow-2xs"
						/>
						<button 
							@click="copyKeyToken()" 
							class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shrink-0 shadow-sm"
						>
							<i data-lucide="copy" class="w-3.5 h-3.5 text-white"></i>
							<span x-text="keyCopied ? 'Copied!' : 'Copy Secret Key'"></span>
						</button>
					</div>
				</div>

				<!-- Active API Keys Table -->
				<div class="overflow-x-auto rounded-2xl border border-slate-200">
					<table class="w-full text-left text-xs">
						<thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase font-mono text-[10px]">
							<tr>
								<th class="py-3 px-4">Name / Purpose</th>
								<th class="py-3 px-4">Key Prefix</th>
								<th class="py-3 px-4">Environment</th>
								<th class="py-3 px-4">Role</th>
								<th class="py-3 px-4">Created By</th>
								<th class="py-3 px-4">Created</th>
								<th class="py-3 px-4 text-right">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 font-mono">
							<template x-for="k in apiKeys" :key="k.id">
								<tr class="hover:bg-slate-50 transition-colors">
									<td class="py-3 px-4 font-bold text-slate-900 font-sans" x-text="k.name"></td>
									<td class="py-3 px-4 text-indigo-600 font-bold" x-text="k.key_prefix"></td>
									<td class="py-3 px-4">
										<span 
											class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase border"
											:class="{
												'bg-emerald-50 text-emerald-700 border-emerald-200': (k.environment || 'production') === 'production',
												'bg-amber-50 text-amber-700 border-amber-200': k.environment === 'staging',
												'bg-sky-50 text-sky-700 border-sky-200': k.environment === 'development',
												'bg-purple-50 text-purple-700 border-purple-200': k.environment === 'all' || k.environment === '*'
											}"
											x-text="k.environment || 'production'"
										></span>
									</td>
									<td class="py-3 px-4">
										<span 
											class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase"
											:class="k.role === 'admin' ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'bg-sky-50 text-sky-700 border border-sky-200'"
											x-text="k.role"
										></span>
									</td>
									<td class="py-3 px-4 text-slate-500" x-text="k.created_by"></td>
									<td class="py-3 px-4 text-slate-400 text-[11px]" x-text="new Date(k.created_at).toLocaleDateString()"></td>
									<td class="py-3 px-4 text-right">
										<button 
											@click="revokeAPIKey(k.id)"
											class="px-2.5 py-1 rounded-lg text-red-600 hover:bg-red-50 border border-red-200 text-[11px] font-semibold transition cursor-pointer"
										>
											Revoke
										</button>
									</td>
								</tr>
							</template>
							<tr x-show="apiKeys.length === 0">
								<td colspan="7" class="py-8 text-center text-slate-500 font-sans">
									<div class="flex flex-col items-center gap-2">
										<i data-lucide="key" class="w-6 h-6 text-slate-400"></i>
										<span>No active API keys found. Generate a key to authenticate your SDKs and workers.</span>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!-- TAB 2: Code Snippets Display -->
			<div x-show="sdkTab !== 'apikeys'" class="space-y-4">
				<!-- OpenFeature Language Switcher & Badge -->
				<div x-show="sdkTab === 'openfeature'" class="p-4 rounded-2xl bg-indigo-50 border border-indigo-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-mono">
					<div class="flex items-center gap-2 text-xs text-indigo-950 font-bold">
						<i data-lucide="shield-check" class="w-4 h-4 text-indigo-600"></i>
						<span>CNCF OpenFeature Standard — Zero Vendor Lock-In</span>
					</div>
					<div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-indigo-200 text-xs">
						<button
							@click="openfeatureLang = 'go'"
							class="px-3 py-1 rounded-lg font-bold transition cursor-pointer"
							:class="openfeatureLang === 'go' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
						>
							Go
						</button>
						<button
							@click="openfeatureLang = 'ts'"
							class="px-3 py-1 rounded-lg font-bold transition cursor-pointer"
							:class="openfeatureLang === 'ts' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
						>
							TypeScript
						</button>
						<button
							@click="openfeatureLang = 'python'"
							class="px-3 py-1 rounded-lg font-bold transition cursor-pointer"
							:class="openfeatureLang === 'python' ? 'bg-indigo-600 text-white shadow-2xs' : 'text-slate-600 hover:text-slate-900'"
						>
							Python
						</button>
					</div>
				</div>

				<div class="relative">
					<pre class="bg-slate-900 p-6 rounded-2xl text-xs font-mono text-emerald-400 overflow-x-auto border border-slate-800 leading-relaxed shadow-sm" x-text="getSdkSnippet()"></pre>
				</div>
			</div>
		</div>

		<!-- Generate Key Modal Dialog -->
		<div 
			x-show="showKeyModal" 
			class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-md"
			x-cloak
		>
			<div 
				@click.outside="showKeyModal = false"
				class="bg-white rounded-3xl p-6 max-w-md w-full shadow-2xl border border-slate-200 space-y-5"
			>
				<div class="flex items-center justify-between border-b border-slate-100 pb-3">
					<div class="flex items-center gap-2 text-slate-900 font-bold text-sm font-display">
						<i data-lucide="key" class="w-4 h-4 text-indigo-600"></i>
						<span>Create Service API Key</span>
					</div>
					<button @click="showKeyModal = false" class="text-slate-400 hover:text-slate-700 cursor-pointer">
						<i data-lucide="x" class="w-4 h-4"></i>
					</button>
				</div>

				<div class="space-y-4 font-mono">
					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1">Key Name / Description</label>
						<input 
							type="text" 
							x-model="keyForm.name" 
							placeholder="e.g. Production Go Worker SDK" 
							class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:border-indigo-500 transition-colors shadow-2xs"
						/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1">Environment Scope</label>
						<select 
							x-model="keyForm.environment" 
							class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:border-indigo-500 transition-colors shadow-2xs"
						>
							<option value="production">Production (Default)</option>
							<option value="staging">Staging</option>
							<option value="development">Development</option>
							<option value="all" x-show="currentUser && currentUser.role === 'admin'">All Environments (Cross-Environment Admin)</option>
						</select>
						<p class="text-[11px] text-slate-500 mt-1 font-sans">Requests with this key will be restricted exclusively to this environment.</p>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1">Assigned Role</label>
						<select 
							x-model="keyForm.role" 
							class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:border-indigo-500 transition-colors shadow-2xs"
						>
							<option value="developer">Developer (Evaluations &amp; Read access)</option>
							<option value="admin">Administrator (Mutations &amp; Management)</option>
						</select>
					</div>
				</div>

				<div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 font-mono">
					<button 
						@click="showKeyModal = false" 
						class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
					>
						Cancel
					</button>
					<button 
						@click="generateKey()" 
						class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-sm hover:scale-[1.02]"
					>
						<span>Generate Token</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}
