package views

templ SDKModal() {
	<div class="space-y-8" x-show="activeView === 'sdk'" x-cloak x-data="sdkViewComponent()" x-init="fetchAPIKeys()">
		<!-- Top Header Card -->
		<div class="console-card p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
			<div class="flex items-center gap-3.5">
				<button
					@click="activeView = 'overview'"
					class="p-2 text-slate-600 hover:text-slate-900 transition-colors rounded-xl hover:bg-slate-100 border border-slate-200 shadow-2xs flex items-center gap-1.5 text-xs font-semibold cursor-pointer"
					title="Return to overview"
				>
					<i data-lucide="arrow-left" class="h-4 w-4"></i>
					<span class="hidden sm:inline">Back</span>
				</button>
				<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 border border-blue-200 text-blue-600">
					<i data-lucide="code-2" class="h-5 w-5"></i>
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h2 class="text-lg font-bold text-slate-900 font-display">SDK Integration & API Key Manager</h2>
						<span class="rounded-md bg-blue-50 border border-blue-200 px-2.5 py-0.5 text-[10px] font-mono text-blue-700 font-bold uppercase">
							Sub-Microsecond
						</span>
					</div>
					<p class="text-xs text-slate-600 mt-1">
						Generate programmatic service account API keys and integrate non-blocking evaluation clients into your services.
					</p>
				</div>
			</div>

			<div class="flex items-center gap-2 self-end sm:self-auto">
				<button
					x-show="sdkTab !== 'apikeys'"
					@click="copySnippet()"
					class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs transition-all shadow-sm flex items-center gap-2 cursor-pointer"
				>
					<i data-lucide="copy" class="h-3.5 w-3.5"></i>
					<span x-text="copied ? 'Copied to Clipboard!' : 'Copy Code Snippet'"></span>
				</button>
				<button
					x-show="sdkTab === 'apikeys'"
					@click="showKeyModal = true"
					class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition-all shadow-sm flex items-center gap-2 cursor-pointer"
				>
					<i data-lucide="key" class="h-3.5 w-3.5"></i>
					<span>Generate New API Key</span>
				</button>
			</div>
		</div>

		<!-- Main SDK Tabs & Container -->
		<div class="console-card p-6 sm:p-8 space-y-6">
			<!-- Language & API Key Tabs -->
			<div class="flex items-center gap-2 border-b border-slate-100 pb-4 overflow-x-auto">
				<button 
					@click="sdkTab = 'apikeys'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer flex items-center gap-1.5"
					:class="sdkTab === 'apikeys' ? 'bg-blue-600 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					<i data-lucide="key" class="h-3.5 w-3.5"></i>
					<span>API Keys</span>
					<span class="text-[10px] px-1.5 py-0.2 rounded-full font-mono font-normal" :class="sdkTab === 'apikeys' ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-700'" x-text="apiKeys.length"></span>
				</button>
				<button 
					@click="sdkTab = 'go'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'go' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Go SDK
				</button>
				<button 
					@click="sdkTab = 'ts'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'ts' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					TypeScript / Node
				</button>
				<button 
					@click="sdkTab = 'python'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'python' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Python 3
				</button>
				<button 
					@click="sdkTab = 'rust'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'rust' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Rust SDK
				</button>
				<button 
					@click="sdkTab = 'cli'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'cli' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Developer CLI
				</button>
				<button 
					@click="sdkTab = 'curl'"
					class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition shadow-2xs cursor-pointer"
					:class="sdkTab === 'curl' ? 'bg-slate-900 text-white shadow-xs' : 'bg-slate-50 text-slate-600 hover:text-slate-900 border border-slate-200'"
				>
					Raw cURL
				</button>
			</div>

			<!-- TAB 1: API Keys Management Table -->
			<div x-show="sdkTab === 'apikeys'" class="space-y-6">
				<!-- Newly Generated Key Alert Dialog -->
				<div x-show="newlyCreatedKey" class="p-5 rounded-2xl bg-emerald-50 border border-emerald-300 space-y-3">
					<div class="flex items-start justify-between gap-3">
						<div class="flex items-center gap-2 text-emerald-900 font-bold text-sm">
							<i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
							<span>API Key Generated Successfully</span>
						</div>
						<button @click="newlyCreatedKey = null" class="text-slate-400 hover:text-slate-600 cursor-pointer">
							<i data-lucide="x" class="w-4 h-4"></i>
						</button>
					</div>
					<p class="text-xs text-emerald-800">
						Please copy your secret key now. <strong>For your security, it will never be displayed again.</strong>
					</p>
					<div class="flex items-center gap-2">
						<input 
							type="text" 
							readonly 
							:value="newlyCreatedKey ? newlyCreatedKey.key : ''" 
							class="flex-1 bg-white border border-emerald-300 rounded-xl px-3 py-2 text-xs font-mono font-bold text-slate-900 select-all"
						/>
						<button 
							@click="copyKeyToken()" 
							class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shrink-0 shadow-xs"
						>
							<i data-lucide="copy" class="w-3.5 h-3.5"></i>
							<span x-text="keyCopied ? 'Copied!' : 'Copy Secret Key'"></span>
						</button>
					</div>
				</div>

				<!-- Active API Keys Table -->
				<div class="overflow-x-auto rounded-xl border border-slate-200">
					<table class="w-full text-left text-xs">
						<thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase font-mono text-[10px]">
							<tr>
								<th class="py-3 px-4">Name / Purpose</th>
								<th class="py-3 px-4">Key Prefix</th>
								<th class="py-3 px-4">Role</th>
								<th class="py-3 px-4">Created By</th>
								<th class="py-3 px-4">Created</th>
								<th class="py-3 px-4 text-right">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 font-mono">
							<template x-for="k in apiKeys" :key="k.id">
								<tr class="hover:bg-slate-50/60 transition-colors">
									<td class="py-3 px-4 font-bold text-slate-900 font-sans" x-text="k.name"></td>
									<td class="py-3 px-4 text-slate-600 font-mono" x-text="k.key_prefix"></td>
									<td class="py-3 px-4">
										<span 
											class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase"
											:class="k.role === 'admin' ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'bg-blue-50 text-blue-700 border border-blue-200'"
											x-text="k.role"
										></span>
									</td>
									<td class="py-3 px-4 text-slate-600" x-text="k.created_by"></td>
									<td class="py-3 px-4 text-slate-500 text-[11px]" x-text="new Date(k.created_at).toLocaleDateString()"></td>
									<td class="py-3 px-4 text-right">
										<button 
											@click="revokeAPIKey(k.id)"
											class="px-2.5 py-1 rounded-lg text-rose-600 hover:bg-rose-50 border border-rose-200 text-[11px] font-semibold transition cursor-pointer"
										>
											Revoke
										</button>
									</td>
								</tr>
							</template>
							<tr x-show="apiKeys.length === 0">
								<td colspan="6" class="py-8 text-center text-slate-500 font-sans">
									<div class="flex flex-col items-center gap-2">
										<i data-lucide="key" class="w-6 h-6 text-slate-400"></i>
										<span>No active API keys found. Generate a key to authenticate your SDKs and workers.</span>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>

			<!-- TAB 2: Code Snippets Display -->
			<div x-show="sdkTab !== 'apikeys'" class="relative">
				<pre class="bg-slate-900 p-6 rounded-2xl text-xs font-mono text-slate-100 overflow-x-auto border border-slate-800 leading-relaxed shadow-xl" x-text="getSdkSnippet()"></pre>
			</div>
		</div>

		<!-- Generate Key Modal Dialog -->
		<div 
			x-show="showKeyModal" 
			class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs"
			x-cloak
		>
			<div 
				@click.outside="showKeyModal = false"
				class="bg-white rounded-2xl p-6 max-w-md w-full shadow-2xl border border-slate-200 space-y-5"
			>
				<div class="flex items-center justify-between border-b border-slate-100 pb-3">
					<div class="flex items-center gap-2 text-slate-900 font-bold text-sm">
						<i data-lucide="key" class="w-4 h-4 text-blue-600"></i>
						<span>Create Service API Key</span>
					</div>
					<button @click="showKeyModal = false" class="text-slate-400 hover:text-slate-600 cursor-pointer">
						<i data-lucide="x" class="w-4 h-4"></i>
					</button>
				</div>

				<div class="space-y-4">
					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1">Key Name / Description</label>
						<input 
							type="text" 
							x-model="keyForm.name" 
							placeholder="e.g. Production Go Worker SDK" 
							class="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500"
						/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-slate-700 mb-1">Assigned Role</label>
						<select 
							x-model="keyForm.role" 
							class="w-full px-3 py-2 text-xs border border-slate-200 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-blue-500 bg-white"
						>
							<option value="developer">Developer (Evaluations & Read access)</option>
							<option value="admin">Administrator (Mutations & Management)</option>
						</select>
					</div>
				</div>

				<div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
					<button 
						@click="showKeyModal = false" 
						class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
					>
						Cancel
					</button>
					<button 
						@click="generateKey()" 
						class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-xs"
					>
						<span>Generate Token</span>
					</button>
				</div>
			</div>
		</div>
	</div>
}
