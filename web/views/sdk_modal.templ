package views

templ SDKModal() {
	<div class="space-y-5" x-show="activeView === 'sdk'" x-cloak x-data="sdkViewComponent()">
		<!-- Top Header Card -->
		<div class="page-head flex flex-col sm:flex-row sm:items-center justify-between gap-3">
			<p class="text-sm text-neutral-500">Connect your services to Flagura</p>

			<div class="flex items-center gap-2 self-end sm:self-auto">
				<button
					@click="copySnippet()"
					class="btn btn-primary"
				>
					<i data-lucide="copy" class="h-3.5 w-3.5 text-surface"></i>
					<span x-text="copied ? 'Copied' : 'Copy Code Snippet'"></span>
				</button>
			</div>
		</div>

		<p class="text-sm text-neutral-600">You'll need an API key. <button type="button" @click="createKey()" class="text-accent-600 hover:underline cursor-pointer">Create one</button> or <button type="button" @click="navigateTo('apikeys')" class="text-accent-600 hover:underline cursor-pointer">manage existing keys</button>.</p>

		<!-- Main SDK Tabs & Container -->
		<div class="panel p-4 space-y-6">
			<!-- Language Tabs -->
			<div class="seg">
				<button 
					@click="sdkTab = 'go'" :class="sdkTab === 'go' ? 'seg-on' : ''">
					Go SDK
				</button>
				<button 
					@click="sdkTab = 'ts'" :class="sdkTab === 'ts' ? 'seg-on' : ''">
					TypeScript / Node
				</button>
				<button 
					@click="sdkTab = 'python'" :class="sdkTab === 'python' ? 'seg-on' : ''">
					Python 3
				</button>
				<button 
					@click="sdkTab = 'rust'" :class="sdkTab === 'rust' ? 'seg-on' : ''">
					Rust SDK
				</button>
				<button 
					@click="sdkTab = 'openfeature'" :class="sdkTab === 'openfeature' ? 'seg-on' : ''">
					<span class="inline-block w-2 h-2 rounded-full bg-ok-400"></span>
					<span>OpenFeature (CNCF)</span>
				</button>
				<button 
					@click="sdkTab = 'cli'" :class="sdkTab === 'cli' ? 'seg-on' : ''">
					Developer CLI
				</button>
				<button 
					@click="sdkTab = 'curl'" :class="sdkTab === 'curl' ? 'seg-on' : ''">
					Raw cURL
				</button>
			</div>

<!-- TAB 2: Code Snippets Display -->
			<div class="space-y-4">
				<!-- OpenFeature Language Switcher & Badge -->
				<div x-show="sdkTab === 'openfeature'" class="p-4 rounded-md bg-accent-50 border border-accent-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
					<div class="flex items-center gap-2 text-xs text-accent-950 font-medium">
						<i data-lucide="shield-check" class="w-4 h-4 text-accent-600"></i>
						<span>CNCF OpenFeature Standard — Zero Vendor Lock-In</span>
					</div>
					<div class="seg">
						<button
							@click="openfeatureLang = 'go'" :class="openfeatureLang === 'go' ? 'seg-on' : ''">
							Go
						</button>
						<button
							@click="openfeatureLang = 'ts'" :class="openfeatureLang === 'ts' ? 'seg-on' : ''">
							TypeScript
						</button>
						<button
							@click="openfeatureLang = 'python'" :class="openfeatureLang === 'python' ? 'seg-on' : ''">
							Python
						</button>
					</div>
				</div>

				<div class="relative">
					<pre class="bg-neutral-900 p-4 rounded-md text-xs font-mono text-ok-400 overflow-x-auto border border-neutral-800 leading-relaxed code-scope" x-text="getSdkSnippet()"></pre>
				</div>
			</div>
		</div>
	</div>
}
